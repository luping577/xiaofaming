// ============ Timer ============
function startTimer(){
  let lastSecond=Math.ceil(state.timer);
  state.timerInterval=setInterval(()=>{
    if(state.paused||state._levelTransitioning)return;
    state.timer-=0.1;updateTimer();
    const elapsed=state.maxTimer-state.timer;
    const cfg=modeConfigs[state.mode];

    // Classic: level-based progression
    if(state.mode==='classic'){
      // Update difficulty per level
      const lvlIdx=state._currentLevel-1;
      if(lvlIdx<cfg.levelSpeeds.length){
        state.difficulty=1+lvlIdx*0.4;
        const baseInt=cfg.levelSpeeds[lvlIdx];
        const newInt=Math.round(baseInt/50)*50;
        if(state._currentSpawnInterval!==newInt){
          clearInterval(state.spawnInterval);
          state._currentSpawnInterval=newInt;
          state.spawnInterval=setInterval(spawnMole,state._currentSpawnInterval);
        }
      }

      if(state.timer<=0){
        state.timer=0;updateTimer();
        const target=cfg.levelTargets[lvlIdx]||0;
        if(state.score>=target){
          // Level cleared!
          state._levelCleared=true;
          if(state._currentLevel>=cfg.stages){
            // All levels completed
            state._levelTransitioning=true;
            clearInterval(state.spawnInterval);
            state.activeMoles.forEach(m=>{clearTimeout(m.timeout);if(m.element)m.element.remove()});state.activeMoles=[];
            showAnnounce('🏆 全部关卡通过!');
            audio.bonus();spawnParticles(4,'#FFD700',20);
            setTimeout(()=>endGame(),2000);
          }else{
            // Transition to next level
            state._levelTransitioning=true;
            clearInterval(state.spawnInterval);
            state.activeMoles.forEach(m=>{clearTimeout(m.timeout);if(m.element)m.element.remove()});state.activeMoles=[];
            showAnnounce(`🎉 关卡 ${state._currentLevel} 通过!`);
            audio.bonus();
            setTimeout(()=>{
              state._currentLevel++;state._levelTransitioning=false;
              state.timer=15;state.maxTimer=15;state._currentSpawnInterval=1200;
              updateStage();updateTimer();
              showAnnounce(`📶 进入关卡 ${state._currentLevel}/${cfg.stages}! 目标: ${cfg.levelTargets[state._currentLevel-1]}分`);
              state.spawnInterval=setInterval(spawnMole,state._currentSpawnInterval);
              setTimeout(spawnMole,200);setTimeout(spawnMole,500);
            },1800);
          }
        }else{
          // Level failed
          state._levelTransitioning=true;
          clearInterval(state.spawnInterval);
          state.activeMoles.forEach(m=>{clearTimeout(m.timeout);if(m.element)m.element.remove()});state.activeMoles=[];
          showAnnounce(`💔 关卡 ${state._currentLevel} 失败! 目标 ${target}分`);
          audio.gameOver();
          setTimeout(()=>endGame(),1500);
        }
      }
      return;
    }

    // Classic: stage progression (non-level mode - kept for other modes)
    if(cfg.stages>0&&state.mode!=='classic'){
      const newStage=Math.min(cfg.stages,1+Math.floor(elapsed/cfg.stageInterval));
      if(newStage!==state.stage){state.stage=newStage;updateStage();showAnnounce(`📶 进入阶段 ${state.stage}!`)}
      if(cfg.bonusRound&&Math.floor(elapsed)>0&&Math.floor(elapsed)%20===0&&Math.floor(elapsed)!==(state._lastBonus||-1)){state._lastBonus=Math.floor(elapsed);triggerBonusRound()}
    }

    // Survival: wave progression
    if(state.mode==='survival'){
      const newWave=1+Math.floor(elapsed/15);
      if(newWave!==state.wave){state.wave=newWave;updateWave();showAnnounce(`🌊 第 ${state.wave} 波!`);audio.wave()}
    }

    // Endless: speed ramp
    if(state.mode==='endless'){
      const newWave=1+Math.floor(elapsed/10);
      if(newWave!==state.wave){state.wave=newWave;updateWave();showAnnounce(`♾️ 第 ${state.wave} 波!`);audio.wave()}
      state.difficulty=1+elapsed*0.05;
    }

    // Difficulty
    if(!cfg.speedRamp&&state.mode!=='classic')state.difficulty=1+Math.floor(elapsed/10)*0.3;
    const baseInt=cfg.baseInterval||1200;
    const newInt=Math.max(350,baseInt-state.difficulty*100);
    if(state._currentSpawnInterval!==Math.round(newInt/50)*50){
      clearInterval(state.spawnInterval);
      state._currentSpawnInterval=Math.round(newInt/50)*50;
      state.spawnInterval=setInterval(spawnMole,state._currentSpawnInterval);
    }

    if(state.timer<=0){state.timer=0;updateTimer();endGame()}
  },100);
}

