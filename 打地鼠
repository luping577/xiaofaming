  let dc=null;
  if(state.mode==='classic'){
    dc=difficultyConfigs[state.classicDifficulty];
    cfg={...cfg,timer:dc.levelTime,lives:dc.lives,itemDropRate:dc.itemDropRate,stages:dc.levelCount,levelTargets:dc.targets,levelSpeeds:dc.speeds};
  }
  state.running=true;state.paused=false;state.score=0;state.timer=cfg.timer;state.maxTimer=cfg.timer;
  state.lives=cfg.lives;state.combo=0;state.maxCombo=0;state.totalHits=0;state.totalMiss=0;state.totalStars=0;
  state.activeMoles=[];state.items={rainbow:0,time:0,freeze:0,magnet:0,shield:0};
  state.activeEffects={rainbow:0,freeze:0,shield:false};state.difficulty=1;
  state._missStreak=0;state._lastBossSpawn=-999;state._currentSpawnInterval=cfg.baseInterval||1200;
  state.blindOpened=false;state.stage=1;state.wave=1;state._bonusActive=false;state._lastBonus=-1;
  state._currentLevel=1;state._levelTransitioning=false;state._levelCleared=false;

  // Event theme
  if(state.mode==='event'){
    const themes=['halloween','christmas','spring'];
    state._eventTheme=themes[Math.floor(Math.random()*themes.length)];
    const names={halloween:'🎃 万圣节',christmas:'🎄 圣诞节',spring:'🧧 春节'};
    setTimeout(()=>showAnnounce(names[state._eventTheme]),500);
  }

  // Apply theme
  const theme=themeConfigs[state.theme];
  gameContainer.style.background=theme.bg;
  $$('.hole-bg').forEach(bg=>{bg.style.background=`radial-gradient(ellipse at center,${theme.holeBg} 0%,${theme.holeBg}dd 60%,${theme.holeBg}99 100%)`;bg.style.boxShadow='inset 0 4px 8px rgba(0,0,0,0.15)'});

  // Mode-specific UI
  const isVs=state.mode==='vs';
  holesGrid.style.display=isVs?'none':'grid';
  vsContainer.style.display=isVs?'flex':'none';
  vsContainer.classList.toggle('active',isVs);
  collectHud.style.display=state.mode==='collect'?'block':'none';
  stageBox.style.display=cfg.showStage?'flex':'none';
  waveBox.style.display=cfg.showWave?'flex':'none';
  livesBox.style.display=cfg.showLives||(state.mode==='classic'&&dc&&dc.lives<999)?'flex':'none';
  timerBox.style.display=state.mode==='collect'||state.mode==='endless'||state.mode==='vs'?'none':'flex';
  itemsBar.style.display=isVs?'none':'flex';

  updateScore();updateTimer();updateLives();updateStage();updateWave();updateItemsBar();updateCollectHUD();
  activeItemEl.classList.remove('show');comboDisplay.classList.remove('active');pauseOverlay.classList.add('hidden');gameContainer.style.filter='';
  $$('.mole,.hit-effect,.particle').forEach(el=>el.remove());

  if(isVs){
    startVsMode();
  }else{
    state.spawnInterval=setInterval(spawnMole,state._currentSpawnInterval);
    startTimer();
    setTimeout(spawnMole,300);setTimeout(spawnMole,600);setTimeout(spawnMole,900);
  }
}

