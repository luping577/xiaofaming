// ============ Build Holes ============
function buildHoles(){
  holesGrid.innerHTML='';
  for(let i=0;i<9;i++){
    const h=document.createElement('div');h.className='hole';h.dataset.index=i;
    h.innerHTML=`<div class="hole-bg"></div><div style="position:absolute;top:2px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.5);color:white;font-size:9px;font-weight:700;padding:1px 5px;border-radius:3px;z-index:10;pointer-events:none;font-family:monospace;opacity:0.5">${i+1}</div>`;
    h.addEventListener('pointerdown',e=>onHoleClick(i,e));
    holesGrid.appendChild(h);
  }
}

function buildVsHoles(containerId,playerIdx){
  const c=$(containerId);c.innerHTML='';
  const keys=playerIdx===0?['Q','W','A','S','Z','X']:['U','I','J','K','N','M'];
  const numKeys=playerIdx===0?['1','2','3','4','5','6']:null;
  for(let i=0;i<6;i++){
    const h=document.createElement('div');h.className='vs-hole';h.dataset.index=i;h.dataset.player=playerIdx;
    const hint=numKeys?`${numKeys[i]}/${keys[i]}`:keys[i];
    h.innerHTML=`<div class="hole-bg"></div><div class="key-hint">${hint}</div>`;
    h.addEventListener('pointerdown',e=>onVsHoleClick(playerIdx,i,e));
    c.appendChild(h);
  }
  // Add keyboard legend
  const legend=document.createElement('div');
  legend.className='vs-keys-legend';
  const legendKeys=numKeys?numKeys.map((n,i)=>`${n}/${keys[i]}`):keys;
  legend.innerHTML=legendKeys.map(k=>`<span>${k}</span>`).join(' ');
  legend.style.cssText='display:flex;gap:4px;margin-top:4px;flex-wrap:wrap;justify-content:center;font-size:10px;color:#999;';
  c.parentElement.appendChild(legend);
}

// ============ Create Mole ============
function createMoleElement(type){
  const cfg=moleTypes[type];const el=document.createElement('div');el.className=`mole ${cfg.cls}`;
  let inner='<div class="mole-body"><div class="mole-face"><div class="eye left"></div><div class="eye right"></div><div class="nose"></div><div class="mouth"></div><div class="blush left"></div><div class="blush right"></div></div></div>';
  if(type==='golden')inner+='<div class="crown">👑</div>';
  if(type==='bomb')inner+='<div class="fuse"></div>';
  if(type==='rabbit'){inner+='<div class="ears"><div class="ear left"></div><div class="ear right"></div></div>';inner+='<div class="carrot">🥕</div>'}
  if(type==='boss'){inner+='<div class="big-crown">👑</div>';inner+='<div class="boss-hp"><div class="boss-hp-bar" style="width:100%"></div></div>'}
  el.innerHTML=inner;return el;
}

// ============ Spawn Mole ============
function spawnMole(){
  if(!state.running||state.paused||state._bonusActive)return;
  const cfg=modeConfigs[state.mode];
  const elapsed=state.maxTimer-state.timer;

  // Boss spawn check
  let type;
  if(cfg.bossInterval>0&&elapsed>0&&Math.floor(elapsed)%cfg.bossInterval===0&&Math.floor(elapsed)>(state._lastBossSpawn||-cfg.bossInterval)){
    if(!state.activeMoles.some(m=>m.type==='boss')){
      type='boss';state._lastBossSpawn=Math.floor(elapsed);
      audio.play(400,'triangle',0.12,0.08);
      setTimeout(()=>audio.play(600,'triangle',0.12,0.12),100);
    }
  }
  if(!type){
    // Build available types
    let available=[];
    if(state.mode==='event'){
      const et=state._eventTheme;
      const eventMap={halloween:'pumpkin',christmas:'santa',spring:'redpack'};
      const eventType=eventMap[et]||'pumpkin';
      available=[{type:'normal',weight:50},{type:'golden',weight:8},{type:'rabbit',weight:12},{type:'bomb',weight:8},{type:eventType,weight:22}];
    }else if(state.mode==='classic'){
      // Use difficulty-based mole weights for classic mode
      const dc=difficultyConfigs[state.classicDifficulty];
      const mw=dc.moleWeights;
      const baseTypes=Object.entries(moleTypes).filter(([k])=>k!=='boss'&&k!=='pumpkin'&&k!=='santa'&&k!=='redpack');
      available=[];
      for(const [k] of baseTypes){
        if(mw[k]!==undefined&&mw[k]>0)available.push({type:k,weight:mw[k]});
      }
      if(mw.boss>0)available.push({type:'boss',weight:mw.boss});
    }else{
      available=Object.entries(moleTypes).filter(([k])=>k!=='boss'&&k!=='pumpkin'&&k!=='santa'&&k!=='redpack').map(([k,v])=>({type:k,weight:v.weight}));
    }
    const totalW=available.reduce((s,a)=>s+a.weight,0);
    let rand=Math.random()*totalW;
    for(const a of available){rand-=a.weight;if(rand<=0){type=a.type;break}}
    if(!type)type='normal';
  }

  const occupied=new Set(state.activeMoles.map(m=>m.holeIndex));
  const avail=Array.from({length:9},(_,i)=>i).filter(i=>!occupied.has(i));
  if(avail.length===0)return;
  const holeIndex=avail[Math.floor(Math.random()*avail.length)];
  const hole=$$('.hole')[holeIndex];
  const mcfg=moleTypes[type];

  const moleEl=createMoleElement(type);
  moleEl.addEventListener('pointerdown',e=>{e.stopPropagation();onMoleClick(holeIndex,type,moleEl)});
  hole.appendChild(moleEl);
  requestAnimationFrame(()=>moleEl.classList.add('show'));

  const dur=mcfg.duration[0]+Math.random()*(mcfg.duration[1]-mcfg.duration[0]);
  const sm=state.activeEffects.freeze?0.5:1;
  const actualDur=dur*sm/Math.min(state.difficulty*0.8,1.5);
  const moleData={type,holeIndex,element:moleEl,timeout:null};
  state.activeMoles.push(moleData);
  moleData.timeout=setTimeout(()=>hideMole(moleData,false),Math.max(actualDur,500));
}

function hideMole(moleData,wasHit){
  const idx=state.activeMoles.indexOf(moleData);if(idx===-1)return;
  state.activeMoles.splice(idx,1);clearTimeout(moleData.timeout);
  if(moleData.element&&moleData.element.parentNode){
    if(!wasHit){moleData.element.classList.remove('show');setTimeout(()=>moleData.element.remove(),200)}
    else moleData.element.remove();
  }
  if(state.mode==='survival'&&!wasHit&&moleData.type!=='rabbit'&&moleData.type!=='bomb'){
    state._missStreak=(state._missStreak||0)+1;
    if(state._missStreak>=3){state._missStreak=0;state.lives--;updateLives();showHitEffect(moleData.holeIndex,'💔','#FF6B6B');if(state.lives<=0)endGame()}
  }else if(state.mode==='classic'&&state.classicDifficulty==='hell'&&!wasHit&&moleData.type!=='rabbit'&&moleData.type!=='bomb'){
    state._missStreak=(state._missStreak||0)+1;
    if(state._missStreak>=3){state._missStreak=0;state.lives--;updateLives();showHitEffect(moleData.holeIndex,'💔','#FF6B6B');if(state.lives<=0)endGame()}
  }else if(wasHit)state._missStreak=0;
  if(state.mode==='endless'&&!wasHit&&moleData.type!=='rabbit'&&moleData.type!=='bomb'){
    state.lives--;updateLives();showHitEffect(moleData.holeIndex,'💔','#FF6B6B');
    if(state.lives<=0)endGame();
  }
}

// ============ Bonus Round (Classic) ============
function triggerBonusRound(){
  if(state._bonusActive||!state.running||state.paused)return;
  state._bonusActive=true;
  showAnnounce('🌟 全洞齐冒! 🌟');
  audio.bonus();
  $$('.hole').forEach(h=>h.classList.add('bonus'));

  // Spawn moles in all holes
  const existing=state.activeMoles.map(m=>m.holeIndex);
  const toSpawn=Array.from({length:9},(_,i)=>i).filter(i=>!existing.includes(i));
  toSpawn.forEach(i=>{
    const types=['normal','normal','normal','golden','normal','normal'];
    const type=types[Math.floor(Math.random()*types.length)];
    const mcfg=moleTypes[type];const hole=$$('.hole')[i];
    const moleEl=createMoleElement(type);
    moleEl.addEventListener('pointerdown',e=>{e.stopPropagation();onMoleClick(i,type,moleEl)});
    hole.appendChild(moleEl);requestAnimationFrame(()=>moleEl.classList.add('show'));
    const moleData={type,holeIndex:i,element:moleEl,timeout:null};
    state.activeMoles.push(moleData);
  });

  setTimeout(()=>{
    state._bonusActive=false;
    $$('.hole').forEach(h=>h.classList.remove('bonus'));
  },3000);
}

// ============ Hole Click ============
function onHoleClick(index,e){
  if(!state.running||state.paused)return;
  if(state.activeMoles.find(m=>m.holeIndex===index))return;
  showHitEffect(index,'💨','#CCC');audio.play(150,'sine',0.04,0.04);
}

// ============ Mole Click ============
function onMoleClick(holeIndex,type,moleEl){
  if(!state.running||state.paused)return;
  if(moleEl.classList.contains('hit'))return;
  const cfg=moleTypes[type];

  // Shield
  if(type==='rabbit'&&state.activeEffects.shield){state.activeEffects.shield=false;activeItemEl.classList.remove('show');showHitEffect(holeIndex,'🛡️','#B5EAD7');hideMole(state.activeMoles.find(m=>m.holeIndex===holeIndex&&m.type===type),true);return}

  // Bomb
  if(type==='bomb'){
    const timePenalty=state.mode==='classic'?difficultyConfigs[state.classicDifficulty].bombTimePenalty:5;
    state.timer=Math.max(0,state.timer-timePenalty);updateTimer();showHitEffect(holeIndex,`💥-${timePenalty}s`,'#FF6B6B');
    audio.bomb();shakeScreen();moleEl.classList.add('hit');
    hideMole(state.activeMoles.find(m=>m.holeIndex===holeIndex&&m.type===type),true);spawnParticles(holeIndex,'#FF4444',10);return;
  }

  // Boss
  if(type==='boss'){
    const md=state.activeMoles.find(m=>m.holeIndex===holeIndex&&m.type==='boss');if(!md)return;
    md.bossHP=(md.bossHP||cfg.bossHP)-1;
    const hpBar=moleEl.querySelector('.boss-hp-bar');if(hpBar)hpBar.style.width=`${(md.bossHP/cfg.bossHP)*100}%`;
    if(md.bossHP>0){audio.bossHit();showHitEffect(holeIndex,`👊x${md.bossHP}`,'#FF6B6B');moleEl.style.animation='none';moleEl.offsetHeight;moleEl.style.animation='';return}
    audio.bossDefeat();state.score+=cfg.points;state.combo++;state.totalHits++;
    showHitEffect(holeIndex,`+${cfg.points}`,'#FFD700');spawnParticles(holeIndex,'#FFD700',18);
    if(state.mode==='survival'&&state.lives<3){state.lives++;updateLives();showHitEffect(holeIndex,'💖+1','#FF6B6B')}
  }else{
    // Normal hit
    let points=cfg.points;
    // Classic mode: use difficulty-based rabbit penalty
    if(state.mode==='classic'&&type==='rabbit')points=difficultyConfigs[state.classicDifficulty].rabbitPenalty;
    if(state.mode==='classic'&&type==='bomb')points=difficultyConfigs[state.classicDifficulty].bombPenalty;
    if(state.activeEffects.rainbow)points*=2;
    if(state.mode==='timeattack'&&state.combo>=5)points=Math.floor(points*(1+(state.combo-4)*0.5));
    state.score=Math.max(0,state.score+points);state.combo++;state.totalHits++;
    const sf=cfg.sound==='golden'?'golden':cfg.sound==='rabbit'?'rabbit':'pop';
    if(sf==='pop'){audio.pop();if(state.combo>=3)audio.combo(Math.min(state.combo,10))}else audio[sf]();
    const color=points>=0?(type==='golden'?'#FFD700':'#FFB5C2'):'#FF6B6B';
    showHitEffect(holeIndex,`${points>=0?'+':''}${points}`,color);spawnParticles(holeIndex,color,points>=0?7:3);

    // Collect mode: drop stars
    if(state.mode==='collect'&&type!=='rabbit'){
      state.totalStars++;updateCollectHUD();
      audio.collect();
      if(state.totalStars>=30){showAnnounce('🎉 收集完成!');setTimeout(()=>endGame(),1500)}
    }
  }

  if(state.combo>=3){comboDisplay.textContent=`🔥 ${state.combo}连击!`;comboDisplay.classList.add('active');clearTimeout(state._comboTimeout);state._comboTimeout=setTimeout(()=>comboDisplay.classList.remove('active'),1500)}
  state.maxCombo=Math.max(state.maxCombo,state.combo);updateScore();
  if(!state._bonusActive&&Math.random()<modeConfigs[state.mode].itemDropRate&&type!=='rabbit'&&type!=='bomb')dropItem(holeIndex);
  moleEl.classList.add('hit');hideMole(state.activeMoles.find(m=>m.holeIndex===holeIndex&&(m.type===type)),true);
}

