function spawnVsMole(playerIdx){
  if(!state.vs.running||state.paused)return;
  const activeMoles=state.vs.activeMoles[playerIdx];
  const types=['normal','normal','normal','golden','normal','rabbit'];
  const type=types[Math.floor(Math.random()*types.length)];
  const occupied=new Set(activeMoles.map(m=>m.holeIndex));
  const avail=Array.from({length:6},(_,i)=>i).filter(i=>!occupied.has(i));
  if(avail.length===0)return;
  const holeIndex=avail[Math.floor(Math.random()*avail.length)];
  const container=playerIdx===0?$('#vs-holes1'):$('#vs-holes2');
  const hole=container.querySelectorAll('.vs-hole')[holeIndex];
  const mcfg=moleTypes[type];
  const moleEl=createMoleElement(type);
  moleEl.addEventListener('pointerdown',e=>{e.stopPropagation();onVsMoleClick(playerIdx,holeIndex,type,moleEl)});
  hole.appendChild(moleEl);requestAnimationFrame(()=>moleEl.classList.add('show'));
  const dur=mcfg.duration[0]+Math.random()*(mcfg.duration[1]-mcfg.duration[0]);
  const moleData={type,holeIndex,element:moleEl,timeout:null};
  activeMoles.push(moleData);
  moleData.timeout=setTimeout(()=>{
    const idx=activeMoles.indexOf(moleData);if(idx!==-1){activeMoles.splice(idx,1);clearTimeout(moleData.timeout);if(moleData.element&&moleData.element.parentNode){moleData.element.classList.remove('show');setTimeout(()=>moleData.element.remove(),200)}}
  },Math.max(dur,600));
}

function onVsHoleClick(playerIdx,index,e){
