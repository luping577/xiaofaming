}

function onVsMoleClick(playerIdx,holeIndex,type,moleEl){
  if(!state.vs.running||state.paused)return;
  if(moleEl.classList.contains('hit'))return;
  const cfg=moleTypes[type];
  const points=type==='rabbit'?-15:cfg.points;
  state.vs.scores[playerIdx]=Math.max(0,state.vs.scores[playerIdx]+points);
  $(`#vs-score${playerIdx+1}`).textContent=state.vs.scores[playerIdx];
  audio.vsScore();
  const activeMoles=state.vs.activeMoles[playerIdx];
  const md=activeMoles.find(m=>m.holeIndex===holeIndex);
  if(md){activeMoles.splice(activeMoles.indexOf(md),1);clearTimeout(md.timeout)}
  moleEl.classList.add('hit');setTimeout(()=>moleEl.remove(),300);
  if(state.vs.scores[playerIdx]>=100){endVsGame(playerIdx);return}
}

function useVsItem(playerIdx,itemType){
  if(!state.vs.running||state.paused)return;
  const target=playerIdx===0?1:0;
  if(itemType==='bubble'){
    // Block holes for opponent
    const container=target===0?$('#vs-holes1'):$('#vs-holes2');
    const holes=container.querySelectorAll('.vs-hole');
    const blocked=Math.floor(Math.random()*6);
    for(let i=0;i<2;i++){const h=holes[(blocked+i)%6];h.style.opacity='0.3';h.style.pointerEvents='none';setTimeout(()=>{h.style.opacity='1';h.style.pointerEvents='auto'},3000)}
    showAnnounce('🫧 对手被泡泡遮住了!');
  }else if(itemType==='honey'){
    // Slow opponent
    clearInterval(state.vs.spawnIntervals[target]);
    state.vs.spawnIntervals[target]=setInterval(()=>spawnVsMole(target),2000);
    setTimeout(()=>{clearInterval(state.vs.spawnIntervals[target]);if(state.vs.running)state.vs.spawnIntervals[target]=setInterval(()=>spawnVsMole(target),1200)},3000);
