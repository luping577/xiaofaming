// ============ Audio Engine ============
class AudioEngine{
  constructor(){this.ctx=null;this.enabled=true}
  init(){if(this.ctx)return;try{this.ctx=new(window.AudioContext||window.webkitAudioContext)()}catch(e){this.enabled=false}}
  play(freq,type,dur,vol=0.12,glide=0){
    if(!this.enabled||!this.ctx)return;const t=this.ctx.currentTime;
    const o=this.ctx.createOscillator(),g=this.ctx.createGain();
    o.type=type;o.frequency.setValueAtTime(freq,t);
    if(glide)o.frequency.linearRampToValueAtTime(freq+glide,t+dur);
    g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+dur);
    o.connect(g);g.connect(this.ctx.destination);o.start(t);o.stop(t+dur);
  }
  pop(){this.play(500,'sine',0.1,0.12,-200)}
  combo(n){this.play(400+n*80,'sine',0.1,0.1,200)}
  golden(){this.play(800,'triangle',0.12,0.1);this.play(1200,'triangle',0.08,0.08)}
  rabbit(){this.play(200,'sine',0.25,0.07,-50)}
  bomb(){this.play(80,'sawtooth',0.18,0.07)}
  bossHit(){this.play(300,'square',0.08,0.05);this.play(600,'square',0.06,0.05)}
  bossDefeat(){this.play(600,'triangle',0.12,0.08);setTimeout(()=>this.play(800,'triangle',0.12,0.08),80);setTimeout(()=>this.play(1000,'triangle',0.15,0.12),160)}
  item(){this.play(1000,'sine',0.12,0.08);this.play(1400,'sine',0.08,0.06)}
  gameOver(){this.play(300,'triangle',0.18,0.12);setTimeout(()=>this.play(200,'triangle',0.18,0.18),150)}
  bonus(){this.play(600,'triangle',0.1,0.06);setTimeout(()=>this.play(800,'triangle',0.1,0.06),80);setTimeout(()=>this.play(1000,'triangle',0.12,0.08),160)}
  collect(){this.play(700,'sine',0.1,0.08);this.play(900,'sine',0.06,0.06)}
  wave(){this.play(400,'triangle',0.15,0.12);setTimeout(()=>this.play(500,'triangle',0.15,0.15),120)}
  vsScore(){this.play(600,'triangle',0.12,0.1);this.play(1000,'triangle',0.08,0.08)}
}
const audio=new AudioEngine();

