// ============ Keyboard Controls ============
document.addEventListener('keydown',e=>{
  // Global pause
  if(e.key==='p'||e.key==='P'){togglePause();return}
  if(e.key===' '&&state.running){e.preventDefault();return}

  // VS Mode keyboard controls
  if(state.vs.running&&!state.paused){
    const key=e.key.toUpperCase();
    // Player 1 holes: 1-6 (number keys, priority over QWASZX)
    const numKey=parseInt(e.key);
    if(numKey>=1&&numKey<=6){
      e.preventDefault();
      const idx=numKey-1;
      const mole=state.vs.activeMoles[0].find(m=>m.holeIndex===idx);
      if(mole&&mole.element&&mole.element.classList.contains('show')){
        onVsMoleClick(0,idx,mole.type,mole.element);
      }else{
        onVsHoleClick(0,idx);
      }
      const hole=$('#vs-holes1').querySelectorAll('.vs-hole')[idx];
      if(hole){hole.classList.add('pressed');setTimeout(()=>hole.classList.remove('pressed'),150)}
      return;
    }
    // Player 1 holes: Q,W,A,S,Z,X (alternative)
    const p1Keys=['Q','W','A','S','Z','X'];
    const p1Idx=p1Keys.indexOf(key);
    if(p1Idx!==-1){
      e.preventDefault();
      const mole=state.vs.activeMoles[0].find(m=>m.holeIndex===p1Idx);
      if(mole&&mole.element&&mole.element.classList.contains('show')){
        onVsMoleClick(0,p1Idx,mole.type,mole.element);
      }else{
        onVsHoleClick(0,p1Idx);
      }
      const hole=$('#vs-holes1').querySelectorAll('.vs-hole')[p1Idx];
      if(hole){hole.classList.add('pressed');setTimeout(()=>hole.classList.remove('pressed'),150)}
      return;
    }
    // Player 2 holes: U,I,J,K,N,M
    const p2Keys=['U','I','J','K','N','M'];
    const p2Idx=p2Keys.indexOf(key);
    if(p2Idx!==-1){
      e.preventDefault();
      const mole=state.vs.activeMoles[1].find(m=>m.holeIndex===p2Idx);
      if(mole&&mole.element&&mole.element.classList.contains('show')){
        onVsMoleClick(1,p2Idx,mole.type,mole.element);
      }else{
        onVsHoleClick(1,p2Idx);
      }
      const hole=$('#vs-holes2').querySelectorAll('.vs-hole')[p2Idx];
      if(hole){hole.classList.add('pressed');setTimeout(()=>hole.classList.remove('pressed'),150)}
      return;
    }
    // Player 2 interference items: 7,8,9
    if(key==='7'||key==='8'||key==='9'){
      const items=['bubble','honey','swap'];
      const idx=parseInt(key)-7;
      const el=$('#vs-interference2').querySelectorAll('.vs-item')[idx];
      if(el&&!el.classList.contains('used')){el.classList.add('used');useVsItem(1,items[idx])}
      return;
    }
  }

  // Normal mode: number keys 1-9 for holes
  if(state.running&&!state.paused&&state.mode!=='vs'){
    const num=parseInt(e.key);
    if(num>=1&&num<=9){
      e.preventDefault();
      const idx=num-1;
      const mole=state.activeMoles.find(m=>m.holeIndex===idx);
      if(mole&&mole.element&&mole.element.classList.contains('show')){
        onMoleClick(idx,mole.type,mole.element);
      }else{
        onHoleClick(idx);
      }
    }
  }
});

// ============ Init ============
buildHoles();updateItemsBar();
</script>
</body>
</html>
