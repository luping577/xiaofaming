<body>
    <div class="game-wrapper">
        <div class="game-container" id="gameContainer">
            <canvas id="gameCanvas" tabindex="0"></canvas>

            <!-- 游戏中 HUD 按钮：暂停 + 退出（仅在 PLAYING/PAUSED 时可见） -->
            <div class="hud-buttons" id="hudButtons" style="display:none;">
                <button class="hud-btn" id="btnPause" title="暂停 (P)">❚❚</button>
                <button class="hud-btn" id="btnQuit" title="返回主菜单">✕</button>
            </div>

            <!-- 暂停弹层 -->
            <div class="modal-overlay" id="pauseModal">
                <div class="modal-panel">
                    <h3>游戏暂停</h3>
                    <p>调整策略，随时可以继续战斗。</p>
                    <div class="modal-actions">
                        <button class="modal-btn primary" id="pauseResume" data-action="resume">继续游戏</button>
                        <button class="modal-btn" id="pauseRestart" data-action="restart">重新开始</button>
                        <button class="modal-btn danger" id="pauseExit" data-action="menu">返回主菜单</button>
                    </div>
                </div>
            </div>

            <!-- 退出确认弹层 -->
            <div class="modal-overlay" id="quitModal">
                <div class="modal-panel">
                    <h3>返回主菜单</h3>
                    <p>当前进度将丢失，确定要退出战斗吗？</p>
                    <div class="modal-actions">
                        <button class="modal-btn" id="quitCancel" data-action="cancel">取消</button>
                        <button class="modal-btn danger" id="quitConfirm" data-action="confirm-quit">确定退出</button>
                    </div>
                </div>
            </div>

            <!-- 移动端控制：左下摇杆 + 右下开火/技能 -->
            <div class="touch-controls" id="touchControls" style="display:none;">
                <div class="joystick-area" id="joystickArea">
                    <div class="joystick-base" id="joystickBase"></div>
                    <div class="joystick-knob" id="joystickKnob"></div>
                </div>
                <div class="action-area">
                    <button class="skill-btn" id="btnSkill" title="大招/全屏炸弹 (B)">💥</button>
                    <button class="fire-btn" id="btnFire" title="开火">FIRE</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ==================== 高DPI与响应式画布 ====================
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const container = document.getElementById('gameContainer');
        const W = 600;  // 逻辑宽度
        const H = 800;  // 逻辑高度

        function resizeCanvas() {
            const rect = container.getBoundingClientRect();
            const dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            // 逻辑坐标系保持600x800，通过缩放适应
            const scaleX = rect.width / W;
            const scaleY = rect.height / H;
            const scale = Math.min(scaleX, scaleY);
            const offsetX = (rect.width - W * scale) / 2;
            const offsetY = (rect.height - H * scale) / 2;
            ctx.setTransform(dpr * scale, 0, 0, dpr * scale, dpr * offsetX, dpr * offsetY);
        }

        window.addEventListener('resize', resizeCanvas);
        window.addEventListener('load', resizeCanvas);
        // 初始调用
        resizeCanvas();

        // ==================== 背景图片加载 ====================
        const bgImage = new Image();
        let bgImageLoaded = false;
        let bgImageAlpha = 0;
        bgImage.onload = () => { bgImageLoaded = true; };
        bgImage.onerror = () => { bgImageLoaded = false; };
        bgImage.src = 'bg.jpg';

        // ==================== 敌机Sprite加载与背景去除 ====================
        const enemySprites = {};
        const enemySpriteFiles = {
            small: 'enemy_small.jpg',
            suicide: 'enemy_medium.jpg',
            heavy: 'enemy_heavy.jpg',
            elite: 'enemy_elite.jpg'
        };
        const enemySpriteNames = {
            small: '普通小怪',
            suicide: '高速突袭机',
            heavy: '中型装甲机',
            elite: 'Boss护卫机'
        };
        function processSpriteImage(img) {
            const c = document.createElement('canvas');
            c.width = img.width; c.height = img.height;
            const cx = c.getContext('2d');
            cx.drawImage(img, 0, 0);
            try {
                const data = cx.getImageData(0, 0, c.width, c.height);
                const d = data.data;
                for (let i = 0; i < d.length; i += 4) {
                    const r = d[i], g = d[i+1], b = d[i+2];
                    const max = Math.max(r,g,b), min = Math.min(r,g,b);
                    const saturation = max - min;
                    const brightness = (r + g + b) / 3;
                    const isNearWhite = brightness > 230 && saturation < 25;
                    const isNearGray = brightness > 225 && saturation < 15;
                    if (isNearWhite || isNearGray) {
                        d[i+3] = 0;
                    } else if (brightness > 210 && saturation < 30) {
                        const t = (brightness - 210) / 30;
                        d[i+3] = Math.round(255 * (1 - t));
                    }
                }
                cx.putImageData(data, 0, 0);
            } catch(e) { /* cross-origin or other error */ }
            return c;
        }
        function loadEnemySprites() {
            for (const [key, file] of Object.entries(enemySpriteFiles)) {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = () => {
                    enemySprites[key] = processSpriteImage(img);
                };
                img.onerror = () => {
                    enemySprites[key] = null;
                };
                img.src = file;
            }
        }
        loadEnemySprites();

        // 导出透明PNG精灵图
        function exportEnemySprites() {
            const loaded = Object.entries(enemySprites).filter(([k,v])=>v);
            if (loaded.length === 0) {
                alert('图片尚未加载完成，请稍候再试。');
                return;
            }
            let idx = 0;
            function downloadNext() {
                if (idx >= loaded.length) {
                    alert('✅ 精灵图导出完成！\n\n已导出 ' + loaded.length + ' 张透明背景PNG文件。');
                    return;
                }
                const [key, canvas] = loaded[idx];
                const link = document.createElement('a');
                link.download = 'enemy_' + key + '.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
                idx++;
                setTimeout(downloadNext, 150);
            }
            downloadNext();
        }

        // 绘制cover模式背景图片（填满600x800不留空白）
        function drawBgImage(targetW, targetH) {
            if (!bgImageLoaded || !bgImage.complete) return;
            // 渐显加载
            if (bgImageAlpha < 1) bgImageAlpha += 0.02;
            // cover模式计算：等比缩放裁剪不留空白
            const imgRatio = bgImage.width / bgImage.height;
            const targetRatio = targetW / targetH;
            let drawW, drawH, offsetX, offsetY;
            if (imgRatio > targetRatio) {
                drawH = targetH;
                drawW = targetH * imgRatio;
                offsetX = (targetW - drawW) / 2;
                offsetY = 0;
            } else {
                drawW = targetW;
                drawH = targetW / imgRatio;
                offsetX = 0;
                offsetY = (targetH - drawH) / 2;
            }
            ctx.save();
            ctx.globalAlpha = bgImageAlpha;
            ctx.fillStyle = '#000008';
            ctx.fillRect(0, 0, targetW, targetH);
            ctx.drawImage(bgImage, offsetX, offsetY, drawW, drawH);
            ctx.restore();
            // 覆盖右下角水印区域
            const wmW = 140, wmH = 60;
            const wmX = targetW - wmW, wmY = targetH - wmH;
            const wmGrad = ctx.createRadialGradient(wmX + wmW/2, wmY + wmH/2, 5, wmX + wmW/2, wmY + wmH/2, wmW*0.7);
            wmGrad.addColorStop(0, 'rgba(2,6,20,0.97)');
            wmGrad.addColorStop(0.6, 'rgba(2,6,20,0.95)');
            wmGrad.addColorStop(1, 'rgba(2,6,20,0)');
            ctx.save();
            ctx.fillStyle = wmGrad;
            ctx.fillRect(wmX - 20, wmY - 10, wmW + 40, wmH + 30);
            ctx.restore();
        }

