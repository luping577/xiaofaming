            ctx.fillStyle = bodyGrad;
            ctx.beginPath();
            ctx.moveTo(-2, -h/2);
            ctx.lineTo(10, -h/2+18); ctx.lineTo(16, -8); ctx.lineTo(18, h/4);
            ctx.quadraticCurveTo(10, h/2-4, 0, h/2-2);
            ctx.quadraticCurveTo(-10, h/2-4, -18, h/4);
            ctx.lineTo(-16, -8); ctx.lineTo(-10, -h/2+18); ctx.closePath(); ctx.fill();

            // 伤痕/破损细节
            ctx.strokeStyle = 'rgba(120,40,20,0.8)';
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(-8,-12); ctx.lineTo(2,-4); ctx.moveTo(6,6); ctx.lineTo(14,14); ctx.moveTo(-4,14); ctx.lineTo(-12,22); ctx.stroke();
            // 装甲拼接缝
            ctx.strokeStyle = 'rgba(20,25,32,0.9)';
            ctx.lineWidth = 1.2;
            ctx.beginPath(); ctx.moveTo(-16,-8); ctx.lineTo(16,-8); ctx.moveTo(-14,10); ctx.lineTo(14,10); ctx.stroke();
            // 铆钉（装甲板）
            ctx.fillStyle = '#111316';
            const rivs=[[-14,-14],[-14,-2],[-14,14],[-14,26],[-8,-18],[-8,0],[-8,18],
                        [14,-14],[14,-2],[14,14],[14,26],[8,-18],[8,0],[8,18],
                        [-2,-24],[-2,-6],[-2,14],[-2,26]];
            for (const [rx,ry] of rivs) { ctx.beginPath(); ctx.arc(rx,ry,1.4,0,Math.PI*2); ctx.fill(); }

            // 机头红色激光发射器
            ctx.fillStyle = '#1a1d22';
            ctx.fillRect(-10, -h/2-4, 6, 10); ctx.fillRect(4, -h/2-4, 6, 10);
            const fireG = ctx.createRadialGradient(0, -h/2-6, 0.5, 0, -h/2-6, 7);
            fireG.addColorStop(0, '#ffffff'); fireG.addColorStop(0.35,'#ff3311'); fireG.addColorStop(1,'rgba(255,0,0,0)');
            ctx.fillStyle = fireG; ctx.beginPath(); ctx.arc(0, -h/2-6, 5+Math.sin(game.frameCount*0.9)*1.4, 0, Math.PI*2); ctx.fill();

            // 驾驶舱
            const cg = ctx.createRadialGradient(0,-16,1, 0,-16,12);
