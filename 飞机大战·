            ctx.quadraticCurveTo(10,h/2-4,0,h/2-2); ctx.quadraticCurveTo(-10,h/2-4,-18,h/4);
            ctx.lineTo(-16,-8); ctx.lineTo(-10,-h/2+18); ctx.closePath(); ctx.stroke();

