        }

        // ====== 机型4：极速风暴 TEMPEST ======
        // 参考图4：纯蓝色流线机身，双圆形涡轮电浆引擎（机翼下方），蓝色电浆尾焰极长
        function drawShipTempest(cfg) {
            const w = 44, h = 52;
            const ef = cfg.engineFlame;
            // 双引擎长电浆尾焰
            for (const sx of [-13, 13]) {
                const fH = 16 + Math.sin(game.frameCount*0.6)*5;
                const fg = ctx.createLinearGradient(sx, h/2-6, sx, h/2+fH+18);
                fg.addColorStop(0, ef.c1); fg.addColorStop(0.4, ef.c2); fg.addColorStop(1, ef.c3);
                ctx.fillStyle = fg;
                ctx.beginPath();
                ctx.moveTo(sx-6, h/2-4);
                ctx.quadraticCurveTo(sx, h/2+fH+20, sx+6, h/2-4);
                ctx.closePath(); ctx.fill();
            }

            ctx.save(); ctx.shadowBlur = 26; ctx.shadowColor = cfg.shadowColor;
            // 流线主翼
            const wingGrad = ctx.createLinearGradient(-w/2,0,w/2,0);
            wingGrad.addColorStop(0,'#082a6a'); wingGrad.addColorStop(0.25,'#1068c0'); wingGrad.addColorStop(0.5,'#1a88dd'); wingGrad.addColorStop(0.75,'#1068c0'); wingGrad.addColorStop(1,'#082a6a');
            ctx.fillStyle = wingGrad;
            ctx.beginPath();
            ctx.moveTo(-w/2, 2); ctx.quadraticCurveTo(-8,-h/3-4,-5,-h/4);
            ctx.lineTo(-5, h/5); ctx.quadraticCurveTo(-14,h/2-8,-w/2+4,6); ctx.closePath(); ctx.fill();
            ctx.beginPath();
            ctx.moveTo(w/2, 2); ctx.quadraticCurveTo(8,-h/3-4,5,-h/4);
            ctx.lineTo(5, h/5); ctx.quadraticCurveTo(14,h/2-8,w/2-4,6); ctx.closePath(); ctx.fill();

            // 机身流线体
            const bodyGrad = ctx.createLinearGradient(0,-h/2,0,h/2);
            bodyGrad.addColorStop(0,'#4fc4ff'); bodyGrad.addColorStop(0.2,'#2290dd'); bodyGrad.addColorStop(0.5,'#125090'); bodyGrad.addColorStop(0.8,'#0a3468'); bodyGrad.addColorStop(1,'#061833');
            ctx.fillStyle = bodyGrad;
            ctx.beginPath();
            ctx.moveTo(0,-h/2);
            ctx.quadraticCurveTo(9,-h/2+14, 11, -4);
            ctx.lineTo(13, h/3);
            ctx.quadraticCurveTo(6, h/2-4, 0, h/2-4);
            ctx.quadraticCurveTo(-6, h/2-4, -13, h/3);
            ctx.lineTo(-11, -4);
            ctx.quadraticCurveTo(-9,-h/2+14, 0,-h/2);
            ctx.closePath(); ctx.fill();

            // 机身流线装饰线
            ctx.strokeStyle = 'rgba(0,240,255,0.55)'; ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(0,-h/2+8); ctx.lineTo(-2,2); ctx.lineTo(0,h/2-8);
            ctx.moveTo(0,-h/2+8); ctx.lineTo(2,2); ctx.lineTo(0,h/2-8);
            ctx.stroke();
            // 机翼装饰
            ctx.beginPath();
            ctx.moveTo(-w/2+4,2); ctx.quadraticCurveTo(-14,14,-6,h/3);
            ctx.moveTo(w/2-4,2); ctx.quadraticCurveTo(14,14,6,h/3);
            ctx.stroke();

            // 双圆形涡轮电浆引擎
            for (const sx of [-13, 13]) {
                const eg = ctx.createRadialGradient(sx, h/2-12, 1, sx, h/2-12, 10);
                eg.addColorStop(0,'#ffffff'); eg.addColorStop(0.3,'#aaf6ff'); eg.addColorStop(0.55,'#00ccff'); eg.addColorStop(0.8,'#0060aa'); eg.addColorStop(1,'#031836');
                ctx.fillStyle = eg;
                ctx.beginPath(); ctx.ellipse(sx, h/2-12, 8.5, 10, 0, 0, Math.PI*2); ctx.fill();
                // 引擎涡轮叶片
                ctx.strokeStyle = 'rgba(160,240,255,0.9)'; ctx.lineWidth = 0.8;
                ctx.save(); ctx.translate(sx, h/2-12); ctx.rotate(game.frameCount*0.25);
                for (let k=0;k<6;k++) {
                    ctx.rotate(Math.PI/3);
                    ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(7,1.5); ctx.stroke();
                }
                ctx.restore();
                // 引擎边框
                ctx.strokeStyle = '#00ffff'; ctx.lineWidth=1.3; ctx.shadowBlur=14; ctx.shadowColor='#00ffff';
                ctx.beginPath(); ctx.ellipse(sx, h/2-12, 8.5, 10, 0, 0, Math.PI*2); ctx.stroke();
                ctx.shadowBlur = 26; ctx.shadowColor = cfg.shadowColor;
            }

            // 驾驶舱
            const cg = ctx.createRadialGradient(0,-12,1, 0,-12,11);
            cg.addColorStop(0,'#bff6ff'); cg.addColorStop(0.35,'#2080b8'); cg.addColorStop(1,'#041228');
            ctx.fillStyle = cg;
            ctx.beginPath(); ctx.ellipse(0,-11, 6.5, 13, 0, 0, Math.PI*2); ctx.fill();
            ctx.strokeStyle = 'rgba(0,240,255,0.9)'; ctx.lineWidth=1.2;
            ctx.shadowBlur=10; ctx.shadowColor='#00ffff'; ctx.stroke();
            ctx.shadowBlur = 26; ctx.shadowColor = cfg.shadowColor;

            // 机身霓虹轮廓
            ctx.strokeStyle = 'rgba(0,220,255,0.7)'; ctx.lineWidth=1.4;
            ctx.beginPath();
            ctx.moveTo(0,-h/2); ctx.quadraticCurveTo(9,-h/2+14,11,-4); ctx.lineTo(13,h/3);
            ctx.quadraticCurveTo(6,h/2-4,0,h/2-4); ctx.quadraticCurveTo(-6,h/2-4,-13,h/3);
            ctx.lineTo(-11,-4); ctx.quadraticCurveTo(-9,-h/2+14,0,-h/2);
            ctx.closePath(); ctx.stroke();

            ctx.restore();
        }

        function drawPlayerBullets() {
            for (const b of playerBullets) {
                for (let i=0; i<b.trail.length; i++) {
                    const t=b.trail[i]; const alpha=(i/b.trail.length)*0.5;
                    ctx.beginPath(); ctx.arc(t.x,t.y,b.width*(0.4+(i/b.trail.length)*0.6),0,Math.PI*2);
                    ctx.fillStyle=`rgba(0,255,255,${alpha})`; ctx.fill();
                }
                ctx.save(); ctx.shadowBlur=12; ctx.shadowColor=b.color;
                const grad=ctx.createLinearGradient(b.x,b.y-8,b.x,b.y+8);
                grad.addColorStop(0,'#ffffff'); grad.addColorStop(0.3,b.color); grad.addColorStop(1,'rgba(0,100,200,0.3)');
                ctx.fillStyle=grad; ctx.beginPath(); ctx.ellipse(b.x,b.y,b.width,b.height,0,0,Math.PI*2); ctx.fill(); ctx.restore();
            }
        }

        function drawEnemies() {
            for (const e of enemies) {
                if (e.type===EnemyType.STEALTH && !e.visible) continue; // 隐形不绘制
                ctx.save(); ctx.translate(e.x,e.y);
                if (e.maxHp>1 && e.type!==EnemyType.BOSS) {
                    const bw=e.width+10, bh=4, by=-e.height/2-10;
                    ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.fillRect(-bw/2,by,bw,bh);
                    ctx.fillStyle=e.hp/e.maxHp>0.5?'#33ff33':e.hp/e.maxHp>0.25?'#ffaa00':'#ff3333';
                    ctx.fillRect(-bw/2,by,bw*(e.hp/e.maxHp),bh);
                }
                const spriteKey = {[EnemyType.SMALL]:'small', [EnemyType.SUICIDE]:'suicide', [EnemyType.HEAVY]:'heavy', [EnemyType.ELITE]:'elite'}[e.type];
                const sprite = spriteKey ? enemySprites[spriteKey] : null;
                if (sprite) {
                    const s = Math.max(e.width, e.height) * 1.4;
                    ctx.save();
                    ctx.shadowBlur = 18;
                    ctx.shadowColor = e.color;
                    ctx.drawImage(sprite, -s/2, -s/2, s, s);
                    ctx.restore();
                } else {
                    ctx.shadowBlur=15; ctx.shadowColor=e.color;
                    if (e.type===EnemyType.SMALL) {
                        const g=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); g.addColorStop(0,'#ff6655'); g.addColorStop(0.5,'#cc3322'); g.addColorStop(1,'#661100');
                        ctx.fillStyle=g; ctx.beginPath(); ctx.moveTo(0,e.height/2); ctx.lineTo(-e.width/2,-e.height/2); ctx.lineTo(e.width/2,-e.height/2); ctx.closePath(); ctx.fill(); ctx.strokeStyle='#ff5533'; ctx.lineWidth=1.2; ctx.stroke();
                    } else if (e.type===EnemyType.SUICIDE) {
                        const g=ctx.createRadialGradient(0,0,2,0,0,e.width/2); g.addColorStop(0,'#ffaa00'); g.addColorStop(1,'#ff3300'); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(0,0,e.width/2,0,Math.PI*2); ctx.fill();
                    } else if (e.type===EnemyType.HEAVY) {
                        const g=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); g.addColorStop(0,'#5599ff'); g.addColorStop(0.5,'#2244cc'); g.addColorStop(1,'#001166');
                        ctx.fillStyle=g; ctx.beginPath(); ctx.moveTo(0,e.height/2); ctx.lineTo(-e.width/2,0); ctx.lineTo(-e.width/3,-e.height/2); ctx.lineTo(e.width/3,-e.height/2); ctx.lineTo(e.width/2,0); ctx.closePath(); ctx.fill(); ctx.strokeStyle='#4488ff'; ctx.lineWidth=1.8; ctx.stroke();
                    } else if (e.type===EnemyType.ELITE) {
                        const g=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); g.addColorStop(0,'#ffdd44'); g.addColorStop(0.4,'#ff9900'); g.addColorStop(0.7,'#cc5500'); g.addColorStop(1,'#552200');
                        ctx.fillStyle=g; ctx.beginPath(); ctx.moveTo(0,-e.height/2); ctx.lineTo(e.width/2,0); ctx.lineTo(e.width/4,e.height/2); ctx.lineTo(-e.width/4,e.height/2); ctx.lineTo(-e.width/2,0); ctx.closePath(); ctx.fill(); ctx.strokeStyle='#ffcc00'; ctx.lineWidth=2; ctx.stroke();
                    } else if (e.type===EnemyType.MEDIUM) {
                        const g=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); g.addColorStop(0,'#dd66ff'); g.addColorStop(0.5,'#9922cc'); g.addColorStop(1,'#440066');
                        ctx.fillStyle=g; ctx.beginPath(); for(let i=0;i<6;i++){const a=(i/6)*Math.PI*2-Math.PI/6; const r=e.width/2; const vx=Math.cos(a)*r, vy=Math.sin(a)*r; if(i===0)ctx.moveTo(vx,vy); else ctx.lineTo(vx,vy);} ctx.closePath(); ctx.fill(); ctx.strokeStyle='#cc44ff'; ctx.lineWidth=1.5; ctx.stroke();
                    } else if (e.type===EnemyType.BOSS) {
                        const bw=e.width+40, bh=8, by=-e.height/2-20;
                        ctx.shadowBlur=0; ctx.fillStyle='rgba(0,0,0,0.8)'; ctx.fillRect(-bw/2,by,bw,bh);
                        const ratio=e.hp/e.maxHp; const bg=ctx.createLinearGradient(-bw/2,0,bw/2,0); bg.addColorStop(0,'#ff2200'); bg.addColorStop(0.5,'#ff6600'); bg.addColorStop(1,'#ff2200');
                        ctx.fillStyle=bg; ctx.fillRect(-bw/2+1,by+1,(bw-2)*ratio,bh-2); ctx.strokeStyle='#ff4400'; ctx.lineWidth=1.5; ctx.shadowBlur=15; ctx.shadowColor='#ff2200'; ctx.strokeRect(-bw/2,by,bw,bh);
                        ctx.shadowBlur=25; ctx.shadowColor='#ff2200'; const gg=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); gg.addColorStop(0,'#ff4422'); gg.addColorStop(0.3,'#cc2200'); gg.addColorStop(0.6,'#881100'); gg.addColorStop(1,'#330000');
                        ctx.fillStyle=gg; ctx.beginPath(); ctx.moveTo(0,-e.height/2); ctx.lineTo(e.width/2,-e.height/4); ctx.lineTo(e.width/2-10,0); ctx.lineTo(e.width/2,e.height/4); ctx.lineTo(e.width/4,e.height/2); ctx.lineTo(-e.width/4,e.height/2); ctx.lineTo(-e.width/2,e.height/4); ctx.lineTo(-e.width/2+10,0); ctx.lineTo(-e.width/2,-e.height/4); ctx.closePath(); ctx.fill(); ctx.strokeStyle='#ff3300'; ctx.lineWidth=2.5; ctx.stroke();
                    } else if (e.type===EnemyType.STEALTH) {
                        ctx.globalAlpha=0.6; const g=ctx.createRadialGradient(0,0,2,0,0,e.width/2); g.addColorStop(0,'#cccccc'); g.addColorStop(1,'#666666'); ctx.fillStyle=g; ctx.beginPath(); ctx.arc(0,0,e.width/2,0,Math.PI*2); ctx.fill(); ctx.globalAlpha=1;
                    } else if (e.type===EnemyType.SHIELDED) {
                        ctx.strokeStyle='#00ff88'; ctx.lineWidth=3; ctx.shadowBlur=10; ctx.shadowColor='#00ff88'; ctx.beginPath(); ctx.arc(0,0,e.width/2+5,0,Math.PI*2); ctx.stroke();
                        const g=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); g.addColorStop(0,'#00aa88'); g.addColorStop(1,'#004433'); ctx.fillStyle=g; ctx.beginPath(); ctx.rect(-e.width/2,-e.height/2,e.width,e.height); ctx.fill();
                    } else if (e.type===EnemyType.CARRIER) {
                        const g=ctx.createLinearGradient(0,-e.height/2,0,e.height/2); g.addColorStop(0,'#ff44aa'); g.addColorStop(1,'#660044'); ctx.fillStyle=g; ctx.beginPath(); ctx.rect(-e.width/2,-e.height/2,e.width,e.height); ctx.fill();
                    }
                }
                ctx.restore();
            }
        }

        function drawEnemyBullets() {
            for (const b of enemyBullets) {
                for (let i=0; i<b.trail.length; i++) {
                    const t=b.trail[i]; const alpha=(i/b.trail.length)*0.4;
                    ctx.beginPath(); ctx.arc(t.x,t.y,b.radius*0.6,0,Math.PI*2); ctx.fillStyle=`rgba(255,80,80,${alpha})`; ctx.fill();
                }
                ctx.save(); ctx.shadowBlur=12; ctx.shadowColor='#ff4444';
                const g=ctx.createRadialGradient(b.x,b.y,1,b.x,b.y,b.radius); g.addColorStop(0,'#fff'); g.addColorStop(0.4,'#ff6666'); g.addColorStop(1,'rgba(200,0,0,0.5)');
                ctx.fillStyle=g; ctx.beginPath(); ctx.arc(b.x,b.y,b.radius,0,Math.PI*2); ctx.fill(); ctx.restore();
            }
        }

        function drawPowerups() {
            for (const p of powerups) {
                const pulse=Math.sin(p.pulseOffset)*2; const size=p.size+pulse;
                ctx.save(); ctx.translate(p.x,p.y); ctx.shadowBlur=20; ctx.shadowColor=p.color;
                const bg=ctx.createRadialGradient(0,0,5,0,0,size); bg.addColorStop(0,'rgba(255,255,255,0.3)'); bg.addColorStop(0.5,p.color+'55'); bg.addColorStop(1,p.color+'22');
                ctx.fillStyle=bg; ctx.beginPath(); ctx.arc(0,0,size,0,Math.PI*2); ctx.fill();
                ctx.strokeStyle=p.color; ctx.lineWidth=2; ctx.stroke();
                ctx.shadowBlur=8; ctx.fillStyle='#fff'; ctx.font='bold 14px Orbitron, Courier New, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(p.letter,0,1);
                ctx.restore();
            }
        }

        function drawDrones() {
            if (!player || !player.droneActive) return;
            for (const d of drones) {
                ctx.save(); ctx.translate(d.x,d.y); ctx.shadowBlur=15; ctx.shadowColor='#cc66ff';
                const g=ctx.createLinearGradient(0,-12,0,12); g.addColorStop(0,'#dd88ff'); g.addColorStop(0.5,'#8844cc'); g.addColorStop(1,'#330055');
                ctx.fillStyle=g; ctx.beginPath(); ctx.moveTo(0,-12); ctx.lineTo(10,8); ctx.lineTo(0,4); ctx.lineTo(-10,8); ctx.closePath(); ctx.fill(); ctx.strokeStyle='#cc66ff'; ctx.lineWidth=1.2; ctx.stroke(); ctx.restore();
            }
        }

        function drawParticles() {
            for (const p of particles) {
                ctx.save(); ctx.globalAlpha=Math.max(0,p.life); ctx.shadowBlur=8; ctx.shadowColor=p.color;
                ctx.fillStyle=p.color; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius,0,Math.PI*2); ctx.fill(); ctx.restore();
            }
            ctx.globalAlpha=1;
        }

        function drawHUD() {
            const hudH=50;
            ctx.fillStyle='rgba(0,10,30,0.75)'; ctx.fillRect(0,0,W,hudH);
            ctx.shadowBlur=10; ctx.shadowColor='#00ccff'; ctx.strokeStyle='rgba(0,200,255,0.6)'; ctx.lineWidth=1.5;
            ctx.beginPath(); ctx.moveTo(0,hudH); ctx.lineTo(W,hudH); ctx.stroke(); ctx.shadowBlur=0;
            ctx.fillStyle='#fff'; ctx.font='bold 18px Orbitron, Courier New, monospace'; ctx.textAlign='left'; ctx.textBaseline='middle';
            ctx.fillText(`分数: ${game.score}`,15,hudH/2);
            let hearts=''; for(let i=0;i<game.maxLives;i++) hearts+=i<player.lives?'♥':'♡';
            ctx.fillStyle='#ff6666'; ctx.font='16px Orbitron, Courier New, monospace'; ctx.fillText(hearts,200,hudH/2);
            if (game.mode===GameMode.TIMED) { ctx.fillStyle='#ffcc00'; ctx.font='bold 16px Orbitron, Courier New, monospace'; ctx.textAlign='right'; ctx.fillText(`时间: ${Math.ceil(game.timeRemaining)}s`,W-15,hudH/2); }
            else { ctx.fillStyle='#00ccff'; ctx.font='bold 16px Orbitron, Courier New, monospace'; ctx.textAlign='right'; ctx.fillText(`第 ${game.wave} 波`,W-15,hudH/2); }
            // 道具状态（两行显示，HUD50px 高，主数值占 25px，道具状态在下方小字行）
            let sx = 12, syBottom = hudH - 10;
            ctx.textAlign = 'left'; ctx.font = '9px Orbitron, Courier New, monospace';
            ctx.textBaseline = 'alphabetic';
            const push = (color, text) => {
                if (sx > W - 4) { sx = 12; syBottom += 10; }
                ctx.fillStyle = color;
                const tw = ctx.measureText(text).width + 6;
                if (sx + tw > W - 6) { sx = 12; syBottom += 10; }
                ctx.fillText(text, sx, syBottom);
                sx += tw;
            };
            if(player.weaponLevel>1) push('#ff8800', `武器Lv${player.weaponLevel} ${Math.ceil(player.weaponTimer/1000)}s`);
            if(player.shieldActive) push('#00ccff', `护盾${Math.ceil(player.shieldTimer/1000)}s`);
            if(player.droneActive) push('#cc66ff', `僚机${Math.ceil(player.droneTimer/1000)}s`);
            if(player.speedBoostActive) push('#ffff00', `加速${Math.ceil(player.speedBoostTimer/1000)}s`);
            if(player.pierceActive) push('#00ff88', `穿透${Math.ceil(player.pierceTimer/1000)}s`);
            if(game.magnetActive) push('#ff00ff', `磁铁${Math.ceil(game.magnetTimer/1000)}s`);
            if(game.slowActive) push('#00ffff', `减速${Math.ceil(game.slowTimer/1000)}s`);
            if(game.rapidActive) push('#ffaa00', `连射${Math.ceil(game.rapidTimer/1000)}s`);
            if(game.homingActive) push('#ff2277', `追踪${Math.ceil(game.homingTimer/1000)}s`);
            if(game.laserActive) push('#ffdd22', `激光${Math.ceil(game.laserTimer/1000)}s`);
            if(game.wingmanActive) push('#aa88ff', `编队${Math.ceil(game.wingmanTimer/1000)}s`);
            if(player.invincible) push('#ffffff', `无敌${Math.ceil(player.invincibleTimer/1000)}s`);
        }

        // ==================== 菜单渲染 ====================
        function drawMenuBackground() {
            // 背景图片（cover模式铺满屏幕不留空白）
            drawBgImage(W, H);
            // 图片上层叠加半透明深色底，让UI更清晰
            ctx.save();
            ctx.fillStyle = 'rgba(0,8,24,0.45)';
            ctx.fillRect(0, 0, W, H);
            ctx.restore();

            // 星云脉动（在图片之上叠加，增添动感）
            const pulse = Math.sin(menuNebulaPulse) * 0.5 + 0.5;
            const nebula1 = ctx.createRadialGradient(W*0.3, H*0.25, 30, W*0.3, H*0.25, 280);
            nebula1.addColorStop(0, `rgba(60,20,120,${0.15 + pulse*0.1})`);
            nebula1.addColorStop(0.5, 'rgba(40,10,80,0.06)');
            nebula1.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = nebula1; ctx.fillRect(0, 0, W, H);

            const nebula2 = ctx.createRadialGradient(W*0.75, H*0.6, 40, W*0.75, H*0.6, 300);
            nebula2.addColorStop(0, `rgba(0,80,160,${0.12 + pulse*0.08})`);
            nebula2.addColorStop(0.5, 'rgba(0,40,100,0.04)');
            nebula2.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = nebula2; ctx.fillRect(0, 0, W, H);

            // 银河光带
            ctx.save();
            ctx.translate(W*0.5, H*0.55);
            ctx.rotate(-0.4);
            const bandGrad = ctx.createLinearGradient(-300, 0, 300, 0);
            bandGrad.addColorStop(0, 'rgba(0,50,100,0)');
            bandGrad.addColorStop(0.3, `rgba(0,100,180,${0.04 + pulse*0.03})`);
            bandGrad.addColorStop(0.5, `rgba(100,150,255,${0.06 + pulse*0.04})`);
            bandGrad.addColorStop(0.7, `rgba(0,100,180,${0.04 + pulse*0.03})`);
            bandGrad.addColorStop(1, 'rgba(0,50,100,0)');
            ctx.fillStyle = bandGrad;
            ctx.fillRect(-300, -80, 600, 160);
            ctx.restore();

            // 动态旋转地球（底部弧面）
            drawEarth();

            // 背景战机群（编队飞行，在地球之上）
            drawBgAircraftSquad();

            // 流星
            for (const s of menuShootingStars) {
                const alpha = Math.min(1, s.life / 40);
                const tailX = s.x - s.vx * s.length / Math.hypot(s.vx, s.vy);
                const tailY = s.y - s.vy * s.length / Math.hypot(s.vx, s.vy);
                const grad = ctx.createLinearGradient(s.x, s.y, tailX, tailY);
                grad.addColorStop(0, `rgba(255,255,255,${alpha})`);
                grad.addColorStop(0.3, `rgba(150,220,255,${alpha*0.6})`);
                grad.addColorStop(1, 'rgba(0,150,255,0)');
                ctx.strokeStyle = grad;
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(s.x, s.y);
                ctx.lineTo(tailX, tailY);
                ctx.stroke();
                // 流星头部光点
                ctx.save();
                ctx.shadowColor = '#88ccff';
                ctx.shadowBlur = 8;
                ctx.fillStyle = `rgba(255,255,255,${alpha})`;
                ctx.beginPath();
                ctx.arc(s.x, s.y, 2, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // 流光光束（横向/斜向宽带扫过）
            for (const b of menuLightBeams) {
                const lifeRatio = Math.min(1, b.life / 80);
                const alpha = Math.min(1, lifeRatio) * 0.22;
                if (alpha <= 0) continue;
                ctx.save();
                ctx.translate(b.x, b.y);
                ctx.rotate(b.angle);
                // 主光束
                const beamGrad = ctx.createLinearGradient(-b.length/2, 0, b.length/2, 0);
                beamGrad.addColorStop(0, `hsla(${b.hue}, 100%, 70%, 0)`);
                beamGrad.addColorStop(0.2, `hsla(${b.hue}, 100%, 70%, ${alpha*0.6})`);
                beamGrad.addColorStop(0.5, `hsla(${b.hue+10}, 100%, 85%, ${alpha})`);
                beamGrad.addColorStop(0.8, `hsla(${b.hue}, 100%, 70%, ${alpha*0.6})`);
                beamGrad.addColorStop(1, `hsla(${b.hue}, 100%, 70%, 0)`);
                ctx.fillStyle = beamGrad;
                ctx.shadowColor = `hsla(${b.hue}, 100%, 70%, ${alpha})`;
                ctx.shadowBlur = 30;
                ctx.fillRect(-b.length/2, -b.thickness/2, b.length, b.thickness);
                // 光束核心亮线
                const coreGrad = ctx.createLinearGradient(-b.length/2, 0, b.length/2, 0);
                coreGrad.addColorStop(0, `hsla(${b.hue}, 100%, 95%, 0)`);
                coreGrad.addColorStop(0.5, `hsla(${b.hue+15}, 100%, 98%, ${alpha*2.5})`);
                coreGrad.addColorStop(1, `hsla(${b.hue}, 100%, 95%, 0)`);
                ctx.fillStyle = coreGrad;
                ctx.shadowBlur = 14;
                ctx.fillRect(-b.length/2, -b.thickness*0.08, b.length, b.thickness*0.16);
                ctx.restore();
            }
        }

        function drawFighterJet(jet) {
            ctx.save();
            ctx.translate(jet.x, jet.y);
            if (jet.dir < 0) ctx.scale(-1, 1);
            const s = jet.scale;
            ctx.scale(s, s);

            // 引擎尾焰
            const flameLen = 12 + Math.sin(jet.flapPhase * 3) * 4;
            const flameGrad = ctx.createLinearGradient(-30, 0, -30 - flameLen, 0);
            flameGrad.addColorStop(0, 'rgba(0,220,255,0.8)');
            flameGrad.addColorStop(0.3, 'rgba(0,150,255,0.5)');
            flameGrad.addColorStop(1, 'rgba(0,50,255,0)');
            ctx.fillStyle = flameGrad;
            ctx.beginPath();
            ctx.moveTo(-25, -6);
            ctx.lineTo(-30 - flameLen, 0);
            ctx.lineTo(-25, 6);
            ctx.closePath();
            ctx.fill();

            // 机身阴影
            ctx.fillStyle = 'rgba(0,20,60,0.5)';
            ctx.beginPath();
            ctx.moveTo(35, 0);
            ctx.lineTo(20, -5);
            ctx.lineTo(10, -3);
            ctx.lineTo(-5, -4);
            ctx.lineTo(-20, -8);
            ctx.lineTo(-25, -3);
            ctx.lineTo(-25, 3);
            ctx.lineTo(-20, 8);
            ctx.lineTo(-5, 4);
            ctx.lineTo(10, 3);
            ctx.lineTo(20, 5);
            ctx.closePath();
            ctx.fill();

            // 机身主体
            const bodyGrad = ctx.createLinearGradient(0, -8, 0, 8);
            bodyGrad.addColorStop(0, '#3366aa');
            bodyGrad.addColorStop(0.5, '#1a3366');
            bodyGrad.addColorStop(1, '#0a1a33');
            ctx.fillStyle = bodyGrad;
            ctx.beginPath();
            ctx.moveTo(35, 0);
            ctx.lineTo(20, -5);
            ctx.lineTo(10, -3);
            ctx.lineTo(-5, -4);
            ctx.lineTo(-20, -8);
            ctx.lineTo(-25, -3);
            ctx.lineTo(-25, 3);
            ctx.lineTo(-20, 8);
            ctx.lineTo(-5, 4);
            ctx.lineTo(10, 3);
            ctx.lineTo(20, 5);
            ctx.closePath();
            ctx.fill();
            ctx.strokeStyle = '#00aaff';
            ctx.lineWidth = 1;
            ctx.stroke();

            // 机翼
            const wingGrad = ctx.createLinearGradient(0, -18, 0, 18);
            wingGrad.addColorStop(0, '#2255aa');
            wingGrad.addColorStop(0.5, '#112244');
            wingGrad.addColorStop(1, '#0a1a33');
            ctx.fillStyle = wingGrad;
            ctx.beginPath();
            ctx.moveTo(-5, -4);
            ctx.lineTo(-15, -16);
            ctx.lineTo(-20, -14);
            ctx.lineTo(-8, -3);
            ctx.closePath();
            ctx.fill();
            ctx.beginPath();
            ctx.moveTo(-5, 4);
            ctx.lineTo(-15, 16);
            ctx.lineTo(-20, 14);
            ctx.lineTo(-8, 3);
            ctx.closePath();
            ctx.fill();

            // 驾驶舱
            const cockpitGrad = ctx.createRadialGradient(5, 0, 1, 5, 0, 5);
            cockpitGrad.addColorStop(0, '#ffffff');
            cockpitGrad.addColorStop(0.3, '#88ddff');
            cockpitGrad.addColorStop(1, '#003366');
            ctx.fillStyle = cockpitGrad;
            ctx.beginPath();
            ctx.ellipse(5, 0, 4, 3, 0, 0, Math.PI * 2);
            ctx.fill();

            // 霓虹描边
            ctx.save();
            ctx.strokeStyle = '#00ccff';
            ctx.shadowColor = '#00ccff';
            ctx.shadowBlur = 4;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(35, 0); ctx.lineTo(20, -5); ctx.lineTo(10, -3);
            ctx.lineTo(-5, -4); ctx.lineTo(-20, -8); ctx.lineTo(-25, -3);
            ctx.lineTo(-25, 3); ctx.lineTo(-20, 8); ctx.lineTo(-5, 4);
            ctx.lineTo(10, 3); ctx.lineTo(20, 5);
            ctx.closePath();
            ctx.stroke();
            ctx.restore();

            ctx.restore();
        }

        function drawMenuPanel() {
            // 全屏布局：移除小面板，改为全屏范围的装饰边框
            const margin = 0;  // 完全占满屏幕
            const panelX = margin, panelY = margin;
            const panelW = W - margin * 2, panelH = H - margin * 2;
            const pulse = Math.sin(menuNebulaPulse * 2) * 0.5 + 0.5;

            // 全屏半透明深色背景（替代小面板）
            ctx.save();
            ctx.fillStyle = 'rgba(0,8,24,0.55)';
            ctx.fillRect(panelX, panelY, panelW, panelH);
            ctx.restore();

            // 全屏边框渐变动画（四角装饰框）
            const borderGrad = ctx.createLinearGradient(panelX, panelY, panelX + panelW, panelY + panelH);
            const hueShift = (menuNebulaPulse * 30) % 360;
            borderGrad.addColorStop(0, `hsl(${190 + hueShift}, 100%, 60%)`);
            borderGrad.addColorStop(0.3, `hsl(${210 + hueShift}, 100%, 55%)`);
            borderGrad.addColorStop(0.5, `hsl(${190 + hueShift}, 100%, 65%)`);
            borderGrad.addColorStop(0.7, `hsl(${210 + hueShift}, 100%, 55%)`);
            borderGrad.addColorStop(1, `hsl(${190 + hueShift}, 100%, 60%)`);
            ctx.strokeStyle = borderGrad;
            ctx.lineWidth = 2.5;
            ctx.shadowColor = `rgba(0,200,255,${0.35 + pulse * 0.2})`;
            ctx.shadowBlur = 18 + pulse * 10;
            ctx.strokeRect(panelX + 2, panelY + 2, panelW - 4, panelH - 4);
            ctx.shadowBlur = 0;

            // 全屏四角大装饰
            const cornerLen = 50;
            ctx.strokeStyle = `rgba(0,230,255,${0.55 + pulse * 0.35})`;
            ctx.lineWidth = 3;
            ctx.shadowBlur = 12;
            ctx.shadowColor = '#00ddff';
            // 左上
            ctx.beginPath();
            ctx.moveTo(panelX, panelY + cornerLen);
            ctx.lineTo(panelX, panelY);
            ctx.lineTo(panelX + cornerLen, panelY);
            ctx.stroke();
            // 右上
            ctx.beginPath();
            ctx.moveTo(panelX + panelW - cornerLen, panelY);
            ctx.lineTo(panelX + panelW, panelY);
            ctx.lineTo(panelX + panelW, panelY + cornerLen);
            ctx.stroke();
            // 左下
            ctx.beginPath();
            ctx.moveTo(panelX, panelY + panelH - cornerLen);
            ctx.lineTo(panelX, panelY + panelH);
            ctx.lineTo(panelX + cornerLen, panelY + panelH);
            ctx.stroke();
            // 右下
            ctx.beginPath();
            ctx.moveTo(panelX + panelW - cornerLen, panelY + panelH);
            ctx.lineTo(panelX + panelW, panelY + panelH);
            ctx.lineTo(panelX + panelW, panelY + panelH - cornerLen);
            ctx.stroke();
            ctx.shadowBlur = 0;

            // 全屏顶部和底部扫描线（贴边扩展）
            const scanGradT = ctx.createLinearGradient(panelX, panelY + 6, panelX + panelW, panelY + 6);
            scanGradT.addColorStop(0, 'rgba(0,220,255,0)');
            scanGradT.addColorStop(0.5, `rgba(0,220,255,${0.35 + pulse * 0.2})`);
            scanGradT.addColorStop(1, 'rgba(0,220,255,0)');
            ctx.fillStyle = scanGradT;
            ctx.fillRect(panelX + 15, panelY + 6, panelW - 30, 1.5);

            const scanGradB = ctx.createLinearGradient(panelX, panelY + panelH - 6, panelX + panelW, panelY + panelH - 6);
            scanGradB.addColorStop(0, 'rgba(0,220,255,0)');
            scanGradB.addColorStop(0.5, `rgba(0,220,255,${0.35 + pulse * 0.2})`);
            scanGradB.addColorStop(1, 'rgba(0,220,255,0)');
            ctx.fillStyle = scanGradB;
            ctx.fillRect(panelX + 15, panelY + panelH - 6, panelW - 30, 1.5);
        }

        function drawMenu() {
            // 背景
            drawMenuBackground();

            // 战斗机装饰（全屏漫游）
            for (const jet of menuJets) drawFighterJet(jet);

            // 全屏面板装饰
            drawMenuPanel();

            const pulse = Math.sin(menuNebulaPulse * 2) * 0.5 + 0.5;

            // ====== 标题区（全屏放大） ======
            ctx.save();
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            // 主标题发光
            ctx.shadowBlur = 55;
            ctx.shadowColor = '#00ddff';
            ctx.fillStyle = '#00aaff';
            ctx.font = 'bold 68px Orbitron, Courier New, monospace';
            ctx.fillText('星际战机', W/2, 80);
            // 主标题高光
            ctx.shadowBlur = 20;
            ctx.shadowColor = '#ffffff';
            ctx.fillStyle = '#e6faff';
            ctx.font = 'bold 62px Orbitron, Courier New, monospace';
            ctx.fillText('星际战机', W/2, 78);
            // 副标题
            ctx.shadowBlur = 16;
            ctx.shadowColor = '#0088ff';
            ctx.fillStyle = '#99e5ff';
            ctx.font = 'bold 18px Orbitron, Courier New, monospace';
            ctx.fillText('— 多元宇宙 —', W/2, 124);
            ctx.restore();

            // 标题装饰线（全屏贴边加宽）
            const lineY = 140;
            ctx.save();
            const lineGrad = ctx.createLinearGradient(20, lineY, W-20, lineY);
            lineGrad.addColorStop(0, 'rgba(0,220,255,0)');
            lineGrad.addColorStop(0.3, `rgba(0,220,255,${0.45 + pulse * 0.35})`);
            lineGrad.addColorStop(0.5, `rgba(150,230,255,${0.7 + pulse * 0.3})`);
            lineGrad.addColorStop(0.7, `rgba(0,220,255,${0.45 + pulse * 0.35})`);
            lineGrad.addColorStop(1, 'rgba(0,220,255,0)');
            ctx.strokeStyle = lineGrad;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(20, lineY);
            ctx.lineTo(W-20, lineY);
            ctx.stroke();
            // 线上装饰点（放大）
            ctx.fillStyle = `rgba(0,230,255,${0.75 + pulse * 0.25})`;
            ctx.shadowBlur = 8;
            ctx.shadowColor = '#00ddff';
            ctx.beginPath();
            ctx.arc(W/2, lineY, 4, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();

            // 难度选择标签（加大）
            ctx.save();
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(200,235,255,0.95)';
            ctx.font = 'bold 15px Orbitron, Courier New, monospace';
            ctx.shadowBlur = 6;
            ctx.shadowColor = 'rgba(0,150,255,0.4)';
            ctx.fillText('【 难度选择 】  ← / → 切换', W/2, 206);
            ctx.restore();

            // 难度按钮（横向 4 个，全屏宽度）
            for (let i = 0; i < difficultyButtons.length; i++) {
                const btn = difficultyButtons[i];
                const isSel = i === difficultySelectedIndex;
                const colors = [
                    { sel: '#66ff88', selBg: ['rgba(0,120,40,0.95)','rgba(20,170,80,0.9)'] },
                    { sel: '#00ffff', selBg: ['rgba(0,90,180,0.95)','rgba(0,150,230,0.9)'] },
                    { sel: '#ffcc44', selBg: ['rgba(170,90,0,0.95)','rgba(230,150,20,0.9)'] },
                    { sel: '#ff66aa', selBg: ['rgba(150,20,80,0.95)','rgba(220,40,130,0.9)'] },
                ];
                const c = colors[i] || colors[1];
                ctx.save();
                if (isSel) { ctx.shadowBlur = 24; ctx.shadowColor = c.sel; }
                else { ctx.shadowBlur = 8; ctx.shadowColor = 'rgba(0,150,200,0.4)'; }
                const bg = ctx.createLinearGradient(btn.x, btn.y, btn.x, btn.y + btn.height);
                if (isSel) { bg.addColorStop(0, c.selBg[0]); bg.addColorStop(0.5, c.selBg[1]); bg.addColorStop(1, c.selBg[0]); }
                else { bg.addColorStop(0,'rgba(0,28,58,0.85)'); bg.addColorStop(0.5,'rgba(0,48,95,0.82)'); bg.addColorStop(1,'rgba(0,28,58,0.85)'); }
                ctx.fillStyle = bg;
                const r = 8;
                ctx.beginPath();
                ctx.moveTo(btn.x + r, btn.y);
                ctx.lineTo(btn.x + btn.width - r, btn.y);
                ctx.quadraticCurveTo(btn.x + btn.width, btn.y, btn.x + btn.width, btn.y + r);
                ctx.lineTo(btn.x + btn.width, btn.y + btn.height - r);
                ctx.quadraticCurveTo(btn.x + btn.width, btn.y + btn.height, btn.x + btn.width - r, btn.y + btn.height);
                ctx.lineTo(btn.x + r, btn.y + btn.height);
                ctx.quadraticCurveTo(btn.x, btn.y + btn.height, btn.x, btn.y + btn.height - r);
                ctx.lineTo(btn.x, btn.y + r);
                ctx.quadraticCurveTo(btn.x, btn.y, btn.x + r, btn.y);
                ctx.closePath();
                ctx.fill();
                ctx.strokeStyle = isSel ? c.sel : 'rgba(0,180,220,0.55)';
                ctx.lineWidth = isSel ? 2.5 : 1.2;
                ctx.stroke();
                ctx.restore();

                ctx.save();
                ctx.fillStyle = isSel ? '#ffffff' : '#9ec0dd';
                ctx.font = `bold ${isSel ? 16 : 14}px Orbitron, Courier New, monospace`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.shadowBlur = isSel ? 6 : 0;
                ctx.shadowColor = isSel ? '#fff' : 'transparent';
                ctx.fillText(btn.label, btn.x + btn.width/2, btn.y + btn.height/2);
                ctx.restore();
            }

            // 分隔线：难度 ↔ 机型（全屏贴边）
            ctx.save();
            const sep1 = 212;
            const gSep = ctx.createLinearGradient(15, sep1, W-15, sep1);
            gSep.addColorStop(0, 'rgba(0,180,255,0)');
            gSep.addColorStop(0.5, `rgba(0,200,255,${0.35 + pulse*0.25})`);
            gSep.addColorStop(1, 'rgba(0,180,255,0)');
            ctx.strokeStyle = gSep;
            ctx.lineWidth = 1.2;
            ctx.setLineDash([6, 6]);
            ctx.beginPath(); ctx.moveTo(15, sep1); ctx.lineTo(W-15, sep1); ctx.stroke();
            ctx.setLineDash([]);
            ctx.restore();

            // 机型选择标签（加大）
            ctx.save();
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(200,235,255,0.95)';
            ctx.font = 'bold 15px Orbitron, Courier New, monospace';
            ctx.shadowBlur = 6;
            ctx.shadowColor = 'rgba(0,150,255,0.4)';
            ctx.fillText('【 选择战机 】', W/2, 238);
            ctx.fillStyle = 'rgba(160,200,240,0.7)';
            ctx.font = '11px Orbitron, Courier New, monospace';
            ctx.fillText('Q / E 键 或 数字 1~4 切换  ·  点击卡片选中', W/2, 256);
            ctx.restore();

            // 4 张机型选择卡片（贴满屏幕宽度 144*4+8*3=600，完全不留边）
            const shipCardW = 144, shipCardH = 150, shipGap = 8;
            const shipTotalW = shipCardW*4 + shipGap*3;
            const shipStartX = W/2 - shipTotalW/2;
            const shipY = 270;
            for (let i = 0; i < shipKeys.length; i++) {
                const key = shipKeys[i];
                const cfg = ShipConfig[key];
                const cx = shipStartX + i*(shipCardW+shipGap);
                const isSel = (key === selectedShip);
                ctx.save();
                if (isSel) {
                    ctx.shadowBlur = 28 + Math.sin(menuNebulaPulse*3)*8;
                    ctx.shadowColor = cfg.accent;
                } else {
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = 'rgba(0,120,160,0.4)';
                }
                const g = ctx.createLinearGradient(cx, shipY, cx, shipY+shipCardH);
                if (isSel) {
                    g.addColorStop(0, 'rgba(0,60,120,0.93)');
                    g.addColorStop(0.5, 'rgba(0,100,190,0.89)');
                    g.addColorStop(1, 'rgba(0,60,120,0.93)');
                } else {
                    g.addColorStop(0, 'rgba(0,22,48,0.86)');
                    g.addColorStop(0.5, 'rgba(0,42,85,0.83)');
                    g.addColorStop(1, 'rgba(0,22,48,0.86)');
                }
                ctx.fillStyle = g;
                const r = 9;
                ctx.beginPath();
                ctx.moveTo(cx+r,shipY); ctx.lineTo(cx+shipCardW-r,shipY);
                ctx.quadraticCurveTo(cx+shipCardW,shipY, cx+shipCardW,shipY+r);
                ctx.lineTo(cx+shipCardW,shipY+shipCardH-r);
                ctx.quadraticCurveTo(cx+shipCardW,shipY+shipCardH, cx+shipCardW-r,shipY+shipCardH);
                ctx.lineTo(cx+r,shipY+shipCardH);
                ctx.quadraticCurveTo(cx,shipY+shipCardH, cx,shipY+shipCardH-r);
                ctx.lineTo(cx,shipY+r);
                ctx.quadraticCurveTo(cx,shipY, cx+r,shipY);
                ctx.closePath(); ctx.fill();
                ctx.strokeStyle = isSel ? cfg.accent : 'rgba(0,160,200,0.55)';
                ctx.lineWidth = isSel ? 2.5 : 1.2;
                ctx.stroke();
                ctx.shadowBlur = 0;

                // 左上序号 + 右上 代码名（加大）
                ctx.fillStyle = isSel ? '#ffffff' : 'rgba(160,200,235,0.85)';
                ctx.font = 'bold 11px Orbitron, Courier New, monospace';
                ctx.textAlign = 'left';
                ctx.fillText(String(i+1), cx+10, shipY+15);
                ctx.textAlign = 'right';
                ctx.fillStyle = isSel ? cfg.accent : 'rgba(140,180,220,0.85)';
                ctx.font = 'bold 10px Orbitron, Courier New, monospace';
                ctx.fillText(cfg.codename, cx+shipCardW-10, shipY+15);
                // 名称（加大）
                ctx.textAlign = 'center';
                ctx.fillStyle = isSel ? '#ffffff' : '#e0ecf8';
                ctx.font = 'bold 14px Orbitron, Courier New, monospace';
                ctx.shadowBlur = isSel ? 4 : 0;
                ctx.shadowColor = isSel ? '#fff' : 'transparent';
                ctx.fillText(cfg.name, cx+shipCardW/2, shipY+32);
                ctx.shadowBlur = 0;

                // 战机缩略图（缩放 0.75，更大更清晰）
                ctx.save();
                ctx.translate(cx+shipCardW/2, shipY+78);
                ctx.scale(0.75, 0.75);
                if (key === ShipType.PHANTOM) drawShipPhantom(cfg);
                else if (key === ShipType.CRIMSON) drawShipCrimson(cfg);
                else if (key === ShipType.WARHAMMER) drawShipWarhammer(cfg);
                else drawShipTempest(cfg);
                ctx.restore();

                // 卡片底部：四维属性条（加宽加高）+ 描述
                const st = cfg.stats;
                const statNames = [['机','maneuver'],['火','firepower'],['防','defense'],['速','speed']];
                const barW = shipCardW - 20;
                const barX = cx + 10;
                const barY0 = shipY + shipCardH - 30;
                for (let k = 0; k < 4; k++) {
                    const name = statNames[k][0];
                    const val = st[statNames[k][1]] || 3;
                    const segW = (barW - 14) / 4;
                    const colX = barX + k*(segW + 5);
                    // 图标字
                    ctx.fillStyle = isSel ? 'rgba(220,240,255,0.95)' : 'rgba(160,195,230,0.85)';
                    ctx.font = '9px Orbitron, Courier New, monospace';
                    ctx.textAlign = 'left';
                    ctx.fillText(name, colX, barY0+2);
                    // 进度块
                    for (let p = 0; p < 5; p++) {
                        const pw = (segW - 6 - 10) / 5;
                        ctx.fillStyle = (p < val) ? (isSel ? cfg.accent : 'rgba(0,180,220,0.75)') : 'rgba(80,120,150,0.35)';
                        ctx.fillRect(colX + 10 + p * pw, barY0 - 7, pw - 1, 4);
                    }
                }
                // 描述行（加大）
                ctx.fillStyle = 'rgba(165,200,230,0.7)';
                ctx.font = '9px Orbitron, Courier New, monospace';
                ctx.textAlign = 'center';
                ctx.fillText(cfg.desc, cx+shipCardW/2, shipY+shipCardH-10);

                ctx.restore();
            }

            // 分隔线：机型 ↔ 模式（贴边）
            ctx.save();
            const sep2 = 432;
            const gSep2 = ctx.createLinearGradient(15, sep2, W-15, sep2);
            gSep2.addColorStop(0, 'rgba(0,180,255,0)');
            gSep2.addColorStop(0.5, `rgba(0,200,255,${0.35 + pulse*0.25})`);
            gSep2.addColorStop(1, 'rgba(0,180,255,0)');
            ctx.strokeStyle = gSep2;
            ctx.lineWidth = 1.2;
            ctx.setLineDash([6, 6]);
            ctx.beginPath(); ctx.moveTo(15, sep2); ctx.lineTo(W-15, sep2); ctx.stroke();
            ctx.setLineDash([]);
            ctx.restore();

            // 模式选择标签（加大）
            ctx.save();
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(200,235,255,0.95)';
            ctx.font = 'bold 15px Orbitron, Courier New, monospace';
            ctx.shadowBlur = 6;
            ctx.shadowColor = 'rgba(0,150,255,0.4)';
            ctx.fillText('【 选择模式 】  ↑ / ↓ 切换', W/2, 450);
            ctx.restore();

            // 模式按钮（全屏宽度，按钮更大）
            for (let i = 0; i < menuButtons.length; i++) {
                const btn = menuButtons[i];
                const isSel = i === menuSelectedIndex;
                ctx.save();
                if (isSel) {
                    const glow = 24 + Math.sin(menuNebulaPulse * 3) * 8;
                    ctx.shadowBlur = glow;
                    ctx.shadowColor = '#00ffff';
                } else {
                    ctx.shadowBlur = 8;
                    ctx.shadowColor = 'rgba(0,150,200,0.35)';
                }
                const bg = ctx.createLinearGradient(btn.x, btn.y, btn.x + btn.width, btn.y);
                if (isSel) {
                    bg.addColorStop(0, 'rgba(0,70,140,0.95)');
                    bg.addColorStop(0.5, 'rgba(0,110,200,0.91)');
                    bg.addColorStop(1, 'rgba(0,70,140,0.95)');
                } else {
                    bg.addColorStop(0, 'rgba(0,22,50,0.88)');
                    bg.addColorStop(0.5, 'rgba(0,42,88,0.85)');
                    bg.addColorStop(1, 'rgba(0,22,50,0.88)');
                }
                ctx.fillStyle = bg;
                const r = 8;
                ctx.beginPath();
                ctx.moveTo(btn.x + r, btn.y);
                ctx.lineTo(btn.x + btn.width - r, btn.y);
                ctx.quadraticCurveTo(btn.x + btn.width, btn.y, btn.x + btn.width, btn.y + r);
                ctx.lineTo(btn.x + btn.width, btn.y + btn.height - r);
                ctx.quadraticCurveTo(btn.x + btn.width, btn.y + btn.height, btn.x + btn.width - r, btn.y + btn.height);
                ctx.lineTo(btn.x + r, btn.y + btn.height);
                ctx.quadraticCurveTo(btn.x, btn.y + btn.height, btn.x, btn.y + btn.height - r);
                ctx.lineTo(btn.x, btn.y + r);
                ctx.quadraticCurveTo(btn.x, btn.y, btn.x + r, btn.y);
                ctx.closePath(); ctx.fill();
                ctx.strokeStyle = isSel ? '#00ffff' : 'rgba(0,180,220,0.5)';
                ctx.lineWidth = isSel ? 2.5 : 1.2;
                ctx.stroke();
                if (isSel) {
                    const indGrad = ctx.createLinearGradient(btn.x, btn.y, btn.x + 4, btn.y + btn.height);
                    indGrad.addColorStop(0, '#00ffff'); indGrad.addColorStop(0.5, '#00aaff'); indGrad.addColorStop(1, '#00ffff');
                    ctx.fillStyle = indGrad;
                    ctx.shadowBlur = 10; ctx.shadowColor = '#00ffff';
                    ctx.fillRect(btn.x, btn.y + 8, 4, btn.height - 16);
                }
                ctx.restore();

                // 文字：左 label，右 description（加大）
                ctx.save();
                ctx.textBaseline = 'middle';
                ctx.fillStyle = isSel ? '#ffffff' : '#cadff3';
                ctx.font = `bold ${isSel ? 18 : 16}px Orbitron, Courier New, monospace`;
                ctx.textAlign = 'left';
                ctx.shadowBlur = isSel ? 5 : 0;
                ctx.shadowColor = isSel ? '#fff' : 'transparent';
                ctx.fillText(btn.label, btn.x + 26, btn.y + btn.height/2);
                ctx.shadowBlur = 0;
                ctx.fillStyle = isSel ? 'rgba(210,240,255,0.95)' : 'rgba(140,180,220,0.7)';
                ctx.font = '12px Orbitron, Courier New, monospace';
                ctx.textAlign = 'right';
                ctx.fillText(btn.description, btn.x + btn.width - 26, btn.y + btn.height/2);
                ctx.restore();
            }

            // 底部操作提示（贴近底部边缘）
            ctx.save();
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(160,200,235,0.78)';
            ctx.font = '11px Orbitron, Courier New, monospace';
            ctx.fillText('电脑：WASD / 方向键移动  ·  鼠标左键自动瞄准射击  ·  B 大招  ·  P 暂停', W/2, 735);
            ctx.fillText('手机：左下方摇杆控制方向  ·  右下 FIRE 开火  ·  💥 大招  ·  右上角退出', W/2, 753);
            ctx.fillText('主菜单：Q/E 或 1~4 选机型  ·  ←/→ 选难度  ·  ↑/↓ 选模式  ·  Enter / 点击开始', W/2, 771);
            ctx.fillStyle = 'rgba(100,220,255,0.85)';
            ctx.font = '10px Orbitron, Courier New, monospace';
            ctx.fillText('✨ 按 X 键导出4种敌机透明PNG精灵图', W/2, 789);
            // 版本号
            ctx.fillStyle = 'rgba(110,150,190,0.5)';
            ctx.font = '9px Orbitron, Courier New, monospace';
            ctx.fillText('v3.3 · Sprite精灵图版  ·  全屏流光版', W/2, 803);
            ctx.restore();
        }

        function drawPauseOverlay() {
            ctx.fillStyle='rgba(0,5,20,0.6)'; ctx.fillRect(0,0,W,H);
            ctx.save(); ctx.shadowBlur=25; ctx.shadowColor='#00ccff'; ctx.fillStyle='#00ddff'; ctx.font='bold 40px Orbitron, Courier New, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText('游戏暂停',W/2,H/2-30); ctx.restore();
            ctx.fillStyle='rgba(200,220,255,0.7)'; ctx.font='16px Orbitron, Courier New, monospace'; ctx.fillText('按 P 键继续',W/2,H/2+25);
        }

        function drawGameOver() {
            ctx.fillStyle='rgba(0,5,20,0.7)'; ctx.fillRect(0,0,W,H);
            ctx.save(); ctx.shadowBlur=30; ctx.shadowColor='#ff4444'; ctx.fillStyle='#ff3333'; ctx.font='bold 40px Orbitron, Courier New, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText('游戏结束',W/2,160); ctx.restore();
            const px=130,py=230,pw=340,ph=200;
            ctx.save(); ctx.shadowBlur=15; ctx.shadowColor='#00aaff'; ctx.fillStyle='rgba(0,20,50,0.8)'; ctx.fillRect(px,py,pw,ph); ctx.strokeStyle='#00ccff'; ctx.lineWidth=1.5; ctx.strokeRect(px,py,pw,ph); ctx.restore();
            ctx.fillStyle='#fff'; ctx.font='bold 18px Orbitron, Courier New, monospace'; ctx.textAlign='center'; ctx.fillText('最终得分',W/2,py+40);
            ctx.fillStyle='#ffcc00'; ctx.font='bold 32px Orbitron, Courier New, monospace'; ctx.fillText(String(game.gameOverInfo.score),W/2,py+80);
            ctx.fillStyle='#aaccff'; ctx.font='14px Orbitron, Courier New, monospace'; ctx.fillText(`击毁敌机: ${game.gameOverInfo.kills} 架`,W/2,py+120);
            if(game.mode===GameMode.TIMED) ctx.fillText(`存活时间: ${Math.floor(game.gameOverInfo.timeSurvived/1000)} 秒`,W/2,py+145);
            else ctx.fillText(`存活波次: ${game.gameOverInfo.wave} 波`,W/2,py+145);
            for(const btn of gameOverButtons){
                ctx.save(); ctx.shadowBlur=12; ctx.shadowColor='#00aaff'; const bg=ctx.createLinearGradient(btn.x,btn.y,btn.x+btn.width,btn.y); bg.addColorStop(0,'rgba(0,30,60,0.7)'); bg.addColorStop(1,'rgba(0,50,100,0.7)'); ctx.fillStyle=bg; ctx.fillRect(btn.x,btn.y,btn.width,btn.height); ctx.strokeStyle='#00ccff'; ctx.lineWidth=1.2; ctx.strokeRect(btn.x,btn.y,btn.width,btn.height); ctx.restore();
                ctx.fillStyle='#fff'; ctx.font='bold 15px Orbitron, Courier New, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText(btn.label,btn.x+btn.width/2,btn.y+btn.height/2);
            }
        }

        // ==================== 菜单交互检测（鼠标 + 触摸） ====================
        function handleMenuInteraction(mouseX, mouseY) {
            if(game.state===GameState.MENU){
                // 检查机型卡片（4张）
                const shipCardW = 144, shipCardH = 150, shipGap = 8;
                const shipTotalW = shipCardW*4 + shipGap*3;
                const shipStartX = W/2 - shipTotalW/2;
                const shipY = 270;
                for (let i = 0; i < shipKeys.length; i++) {
                    const cx = shipStartX + i*(shipCardW+shipGap);
                    if(mouseX>=cx-8 && mouseX<=cx+shipCardW+8 && mouseY>=shipY-8 && mouseY<=shipY+shipCardH+8){
                        selectedShip = shipKeys[i];
                        return true;
                    }
                }
                // 检查难度按钮
                for(let i=0; i<difficultyButtons.length; i++){
                    const btn = difficultyButtons[i];
                    if(mouseX>=btn.x-8 && mouseX<=btn.x+btn.width+8 && mouseY>=btn.y-8 && mouseY<=btn.y+btn.height+8){
                        difficultySelectedIndex = i;
                        return true;
                    }
                }
                // 检查模式按钮 - 点击后立即进入游戏
                for(let i=0; i<menuButtons.length; i++){
                    const btn = menuButtons[i];
                    if(mouseX>=btn.x-8 && mouseX<=btn.x+btn.width+8 && mouseY>=btn.y-8 && mouseY<=btn.y+btn.height+8){
                        menuSelectedIndex = i;
                        initGame(btn.mode, difficultyButtons[difficultySelectedIndex].difficulty);
                        return true;
                    }
                }
            } else if(game.state===GameState.GAME_OVER){
                for(const btn of gameOverButtons){
                    if(mouseX>=btn.x-8 && mouseX<=btn.x+btn.width+8 && mouseY>=btn.y-8 && mouseY<=btn.y+btn.height+8){
                        if(btn.action==='restart') initGame(game.mode, game.difficulty);
                        else if(btn.action==='menu') returnToMenu();
                        return true;
                    }
                }
            }
            return false;
        }

        canvas.addEventListener('click', (e)=>{
            canvas.focus();
            const p = mouseToLogical(e.clientX, e.clientY);
            handleMenuInteraction(p.x, p.y);
        });

        canvas.addEventListener('touchstart', (e)=>{
            if(game.state===GameState.MENU || game.state===GameState.GAME_OVER){
                e.preventDefault();
                const t = e.touches[0];
                const p = mouseToLogical(t.clientX, t.clientY);
                handleMenuInteraction(p.x, p.y);
            }
        }, {passive:false});

        // ==================== 主循环 ====================
        let lastTime=0;
        function gameLoop(timestamp){
            const deltaTime = lastTime ? Math.min(timestamp-lastTime,33) : 16.67;
            lastTime=timestamp;
            if(game.state===GameState.MENU){ game.frameCount++; updateStars(); updateMenuAnimations(); }
            updateGame(deltaTime);
            drawGame();
            requestAnimationFrame(gameLoop);
        }

        function init(){
            initStars();
            initMenuAnimations();
            initMenuButtons();
            initDifficultyButtons();
            game.state=GameState.MENU;
            updateTouchControlsVisibility();
            requestAnimationFrame(gameLoop);
        }
        init();
    </script>
</body>
</html>
  
