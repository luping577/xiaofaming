            for (let i = 0; i < 5; i++) {
                bgAircraftSquad.push({
                    x: W * 0.15 + i * 65,
                    y: H * 0.78 - i * 18,
                    speed: 0.35 + Math.random() * 0.15,
                    dir: 1,
                    scale: 0.45 + Math.random() * 0.25,
