        // ==================== 子弹 ====================
        function createPlayerBullet(x, y, angle = 0, color = null, damage = null, speed = null) {
            const p = player || {};
            // P 道具激活时子弹变绿色 + 穿透标记
            const baseColor = color || p.bulletColor || '#00ffff';
            const c = p.pierceActive ? '#00ff88' : baseColor;
            const d = (damage !== undefined && damage !== null) ? damage : (p.bulletDamage || 1);
            const s = speed || p.bulletSpeed || 9;
            return { x, y, width: 4, height: 14, speed: s, angle, damage: d, color: c, trail: [], pierce: !!p.pierceActive, hitEnemies: [] };
