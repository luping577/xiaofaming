        function createPowerup(x, y) {
            // 稀有度权重（稀有道具概率低）
            const weighted = [
                ['W', 10], ['S', 9], ['A', 8], ['P', 7], ['M', 7], ['H', 6],
                ['T', 5], ['D', 5], ['B', 4],
                ['G', 2], ['R', 3], ['F', 3], ['L', 1.5],
                ['E', 2.5], ['N', 1.5], ['U', 2],
                ['X', 1],
            ];
            let total = 0;
            for (const w of weighted) total += w[1];
            let roll = Math.random() * total;
            let type = 'W';
            for (const w of weighted) { roll -= w[1]; if (roll <= 0) { type = w[0]; break; } }
            const cfg = PowerupConfig[type] || PowerupConfig['W'];
            return { type, x, y, size: CONFIG.powerup.size, speed: CONFIG.powerup.fallSpeed, color: cfg.color, letter: cfg.letter, pulseOffset: Math.random()*Math.PI*2 };
        }

        // ==================== 粒子 ====================
        function addExplosion(x, y, color, count=15, speed=4) {
            for(let i=0;i<count;i++){
                const angle = Math.random()*Math.PI*2;
                const velocity = Math.random()*speed+speed*0.3;
                particles.push({ x, y, vx: Math.cos(angle)*velocity, vy: Math.sin(angle)*velocity, radius: Math.random()*4+1.5, color, life:1, decay: Math.random()*0.025+0.015, type:'explosion' });
            }
        }
        function addPickupFlash(x,y,color) {
            for(let i=0;i<20;i++){
                const angle=Math.random()*Math.PI*2;
                particles.push({ x, y, vx: Math.cos(angle)*3, vy: Math.sin(angle)*3, radius: Math.random()*3+1, color, life:1, decay:0.04, type:'pickup' });
            }
        }
        function addEngineFlame(x,y) {
            particles.push({ x: x+(Math.random()-0.5)*8, y, vx:(Math.random()-0.5)*0.8, vy: Math.random()*2+1.5, radius: Math.random()*3+1, color: Math.random()>0.5?'#00ccff':'#0088ff', life:0.7, decay:0.05, type:'engine' });
        }

        // ==================== 难度参数 ====================
        function getDifficultyConfig() {
            return CONFIG.difficulty[game.difficulty] || CONFIG.difficulty.normal;
        }
        function getDifficultyMultiplier() {
            const diff = getDifficultyConfig();
            let mult = 1.0;
            if (game.mode === GameMode.CLASSIC || game.mode === GameMode.SURVIVAL) {
                mult *= 1.0 + (game.wave-1)*CONFIG.wave.speedIncreasePerWave;
            }
            if (game.mode === GameMode.TIMED && game.timedHalfReached) mult *= CONFIG.timedMode.halfTimeBoost;
            mult *= diff.enemyHpMult;
            return mult;
        }
        function getSpawnInterval() {
            const base = CONFIG.wave.spawnIntervalBase;
            const decrease = CONFIG.wave.spawnIntervalDecrease;
            const interval = Math.max(CONFIG.wave.spawnIntervalMin, base - (game.wave-1)*decrease);
            const diff = getDifficultyConfig();
            return interval / getDifficultyMultiplier() * diff.spawnIntervalMult;
        }
        function getHeavyProbability() {
            const base = CONFIG.wave.heavyProbabilityBase;
            const increase = CONFIG.wave.heavyProbabilityIncrease;
            return Math.min(CONFIG.wave.heavyProbabilityMax, base + (game.wave-1)*increase);
        }
        function getEnemyBulletSpeed() {
            const diff = getDifficultyConfig();
            return (CONFIG.wave.bulletSpeedBase + game.wave*CONFIG.wave.bulletSpeedIncrease) * getDifficultyMultiplier() * diff.bulletSpeedMult;
        }

        // ==================== 波次与生成 ====================
        function startNextWave() {
            game.wave++;
            game.waveActive = true;
            game.waveTimer = CONFIG.wave.duration;
            game.waveEnemiesRemaining = 0;
            if (game.mode === GameMode.BOSSRUSH) {
                // Boss Rush模式每一波都是Boss
                const speedMult = getDifficultyMultiplier();
                boss = createBoss(speedMult);
                enemies.push(boss);
                game.waveEnemiesRemaining = 1;
                game.waveTimer = 999999;
            } else if (game.wave % CONFIG.wave.bossWaveInterval === 0 && game.mode !== GameMode.HELL) {
                const speedMult = getDifficultyMultiplier();
                boss = createBoss(speedMult);
                enemies.push(boss);
                game.waveEnemiesRemaining = 1;
                game.waveTimer = 999999;
            } else {
                game.waveActive = true;
                game.waveTimer = CONFIG.wave.duration;
            }
        }

        function spawnEnemy() {
            const speedMult = getDifficultyMultiplier();
            const heavyProb = getHeavyProbability();
            const random = Math.random();
            let enemy = null;
            const x = Math.random()*(W-80)+40;
            if (game.mode === GameMode.HELL) {
                // 地狱模式更疯狂
                if (random < 0.4) enemy = createSmallEnemy(x, -40, speedMult*2);
                else if (random < 0.7) enemy = createMediumEnemy(x, -40, speedMult*1.5);
                else if (random < 0.9) enemy = createHeavyEnemy(x, -40, speedMult*1.2);
                else enemy = createEliteEnemy(x, -40, speedMult);
            } else {
                if (random < heavyProb) enemy = createHeavyEnemy(x, -40, speedMult);
                else if (random < heavyProb+0.25) enemy = createMediumEnemy(x, -40, speedMult);
                else if (random < heavyProb+0.35) enemy = createSmallEnemy(x, -40, speedMult);
                else if (random < heavyProb+0.45) enemy = createSuicideEnemy(x, -40, speedMult);
                else if (random < heavyProb+0.55) enemy = createStealthEnemy(x, -40, speedMult);
                else if (random < heavyProb+0.65) enemy = createShieldedEnemy(x, -40, speedMult);
                else enemy = createSmallEnemy(x, -40, speedMult);
            }
            if (enemy) {
                enemies.push(enemy);
                game.waveEnemiesRemaining++;
            }
        }

        function updateWaveSystem(deltaTime) {
            if (!game.waveActive) return;
            if (boss && boss.hp > 0) return;
            if (boss && boss.hp <= 0) {
                boss = null;
                game.waveActive = false;
                game.waveEnemiesRemaining = 0;
                setTimeout(() => { if(game.state===GameState.PLAYING) startNextWave(); }, 1500);
                return;
            }
            game.waveTimer -= deltaTime;
            if (game.waveTimer <= 0) {
                game.waveActive = false;
                if (enemies.length === 0) {
                    setTimeout(() => { if(game.state===GameState.PLAYING) startNextWave(); }, 800);
                }
            }
            if (game.waveActive && !boss) {
                const interval = getSpawnInterval();
                if (game.frameCount % Math.max(1, Math.floor(interval/16.67)) === 0) spawnEnemy();
            }
            // 精英波
            if (game.wave % CONFIG.wave.eliteWaveInterval === 0 && game.wave % CONFIG.wave.bossWaveInterval !== 0 && game.waveActive && !boss) {
                const halfTime = CONFIG.wave.duration/2;
                if (game.waveTimer < halfTime && game.waveTimer > halfTime-100) {
                    const elite = createEliteEnemy(W/2, -50, getDifficultyMultiplier());
                    enemies.push(elite);
                    game.waveEnemiesRemaining++;
                    game.waveTimer = halfTime-200;
                }
            }
        }

        // ==================== 玩家更新 ====================
        function updatePlayer(deltaTime) {
            if (!player || game.state !== GameState.PLAYING) return;
            let speed = player.baseSpeed;
            if (player.speedBoostActive) speed *= CONFIG.player.speedBoostMultiplier;
            player.speed = speed;

            let dx=0, dy=0;
            if (keys.left) dx -= 1;
            if (keys.right) dx += 1;
            if (keys.up) dy -= 1;
            if (keys.down) dy += 1;

            // 触摸移动
            if (touchMoveActive) {
                const touchDx = (touchStartX - player.x) * 0.035;
                const touchDy = (touchStartY - player.y) * 0.035;
                dx += touchDx;
                dy += touchDy;
            }

            // 鼠标跟随（若鼠标位置在画布内且有过移动记录）
            if (typeof mouseTargetX === 'number' && typeof mouseTargetY === 'number' && mouseActive) {
                const mDx = mouseTargetX - player.x;
                const mDy = mouseTargetY - player.y;
                const dist = Math.hypot(mDx, mDy);
                if (dist > 1) {
                    // 移动方向按距离成正比，但最大速度受 speed 限制
                    const maxStep = speed * 1.0;
                    const s = Math.min(maxStep, dist * 0.18);
                    dx += (mDx / dist) * s / (speed||1);
                    dy += (mDy / dist) * s / (speed||1);
                }
            }

            const targetTilt = (keys.right?1:0) - (keys.left?1:0) + (mouseActive && typeof mouseTargetX==='number' ? Math.max(-1, Math.min(1, (mouseTargetX - player.x)/45)) : 0);
            const targetPitch = (keys.down?1:0) - (keys.up?1:0) + (mouseActive && typeof mouseTargetY==='number' ? Math.max(-1, Math.min(1, (mouseTargetY - player.y)/60)) : 0);
            player.tiltAngle += (targetTilt*CONFIG.player.maxTiltAngle - player.tiltAngle) * CONFIG.player.tiltSmoothness;
            player.pitchScale += (targetPitch*CONFIG.player.maxPitchScale - player.pitchScale) * CONFIG.player.tiltSmoothness;

            if (dx!==0 && dy!==0) { dx*=0.707; dy*=0.707; }
            player.x += dx * speed;
            player.y += dy * speed;

            const margin = 25;
            player.x = Math.max(margin, Math.min(W-margin, player.x));
            player.y = Math.max(60, Math.min(H-margin, player.y));

            if (player.invincible) {
                player.invincibleTimer -= deltaTime;
                if (player.invincibleTimer <= 0) { player.invincible=false; player.invincibleTimer=0; }
            }
            if (player.shieldActive) {
                player.shieldTimer -= deltaTime;
                if (player.shieldTimer <= 0) { player.shieldActive=false; player.shieldTimer=0; }
            }
            if (player.weaponLevel > 1) {
                player.weaponTimer -= deltaTime;
                if (player.weaponTimer <= 0) { player.weaponLevel=1; player.weaponTimer=0; }
            }
            if (player.droneActive) {
                player.droneTimer -= deltaTime;
                if (player.droneTimer <= 0) { player.droneActive=false; player.droneTimer=0; }
            }
            if (player.speedBoostActive) {
                player.speedBoostTimer -= deltaTime;
                if (player.speedBoostTimer <= 0) { player.speedBoostActive=false; player.speedBoostTimer=0; }
            }
            if (player.pierceActive) {
                player.pierceTimer -= deltaTime;
                if (player.pierceTimer <= 0) { player.pierceActive=false; player.pierceTimer=0; }
            }
            // A 道具：加速时产生金色拖尾粒子
            if (player.speedBoostActive && game.frameCount % 2 === 0) {
                addExplosion(player.x + (Math.random()-0.5)*player.width*0.6, player.y + player.height/2, '#ffff00', 1, 1);
            }

            player.fireCooldown -= deltaTime;
            if (player.fireCooldown <= 0) {
                firePlayerBullets();
                let fi = player.fireInterval || CONFIG.player.fireInterval;
                if (game.rapidActive) fi *= 0.55;
                if (game.homingActive) fi *= 0.85;
                player.fireCooldown = fi;
                if (player.weaponLevel>=2) player.fireCooldown *= 0.85;
                if (player.weaponLevel>=3) player.fireCooldown *= 0.82;
            }
            // 强制开火：手机端 FIRE 按钮 / 鼠标左键按住
            if ((mouseFiring || touchFiring) && player.fireCooldown > 0) {
                // 在下次冷却还没到时，允许缩短 interval（相当于更快连射）
                const fi = (player.fireInterval || CONFIG.player.fireInterval) * (game.rapidActive ? 0.45 : 0.62);
                if (player.fireCooldown > fi) player.fireCooldown = fi;
            }
            if (game.frameCount % 3 === 0) addEngineFlame(player.x, player.y + player.height/2);
            if (player.droneActive) updateDrones();
        }

        function firePlayerBullets() {
            if (!player) return;
            const cx = player.x, cy = player.y - player.height/2;
            const cfg = ShipConfig[player.shipType] || ShipConfig.tempest;
            const type = player.shipType;

            const push = (x,y,angle=0,color=null,damage=null,speed=null) =>
                playerBullets.push(createPlayerBullet(x,y,angle,color,damage,speed));

            if (type === ShipType.PHANTOM) {
                // 银蓝幻灵：基础单发，等级2双发，等级3三发 + 中央紫光束
                if (player.weaponLevel===1) push(cx,cy);
                else if (player.weaponLevel===2) { push(cx-14,cy+2); push(cx+14,cy+2); }
                else { push(cx,cy,0,'#aa88ff',player.bulletDamage+1); push(cx-18,cy+4); push(cx+18,cy+4); }
            } else if (type === ShipType.CRIMSON) {
                // 赤焰战神：双炮管重型散射，高伤害
                if (player.weaponLevel===1) { push(cx-12,cy,0,cfg.bulletColor,player.bulletDamage); push(cx+12,cy,0,cfg.bulletColor,player.bulletDamage); }
                else if (player.weaponLevel===2) { push(cx-14,cy); push(cx+14,cy); push(cx,cy+2,0,'#ffdd66',player.bulletDamage); }
                else { push(cx-20,cy+2); push(cx-7,cy); push(cx+7,cy); push(cx+20,cy+2); push(cx,cy+4,0,'#ffff66',player.bulletDamage+1); }
            } else if (type === ShipType.WARHAMMER) {
                // 战锤堡垒：双翼火箭 + 中央红激光，高伤害，射速慢
                if (player.weaponLevel===1) { push(cx-24,cy+8,0,'#ff4422',player.bulletDamage+1); push(cx+24,cy+8,0,'#ff4422',player.bulletDamage+1); push(cx,cy,0,'#ff2222',player.bulletDamage); }
                else if (player.weaponLevel===2) { push(cx-28,cy+10,0,'#ff5533',player.bulletDamage+1); push(cx+28,cy+10,0,'#ff5533',player.bulletDamage+1); push(cx-10,cy,0,'#ff2222',player.bulletDamage); push(cx+10,cy,0,'#ff2222',player.bulletDamage); }
                else { push(cx-32,cy+12,0,'#ff6644',player.bulletDamage+2); push(cx+32,cy+12,0,'#ff6644',player.bulletDamage+2); push(cx-14,cy+2,0,'#ff2222',player.bulletDamage+1); push(cx+14,cy+2,0,'#ff2222',player.bulletDamage+1); push(cx,cy,0,'#ffdd22',player.bulletDamage+1); }
            } else { // TEMPEST 极速风暴：高射速蓝色电浆弹，等级3五连扇形
                if (player.weaponLevel===1) push(cx,cy);
                else if (player.weaponLevel===2) { push(cx-10,cy); push(cx+10,cy); push(cx,cy-4); }
                else {
                    const spread = 0.12;
                    push(cx,cy,0);
                    push(cx-10,cy,-spread); push(cx+10,cy,spread);
                    push(cx-18,cy+2,-spread*2.2); push(cx+18,cy+2,spread*2.2);
                }
            }
            if (player.droneActive) drones.forEach(d=>playerBullets.push(createDroneBullet(d.x,d.y-15)));
        }
        function updateDrones() {
            const offset=28, droneY=player.y+15;
            drones = [{x:player.x-offset,y:droneY},{x:player.x+offset,y:droneY}];
        }

        // ==================== 敌机更新 ====================
        function updateEnemies(deltaTime) {
            const speedMult = getDifficultyMultiplier();
            // T 道具：时间减速，敌机速度 -50%
            const slowFactor = game.slowActive ? 0.5 : 1;
            for (let i=enemies.length-1; i>=0; i--) {
                const enemy = enemies[i];
                if (enemy.type === EnemyType.BOSS) {
                    if (enemy.entering) { enemy.y += 1.5; if(enemy.y>=enemy.targetY){enemy.y=enemy.targetY; enemy.entering=false;} }
                    else {
                        enemy.x += enemy.speed * enemy.bossDirection * slowFactor;
                        enemy.wobbleOffset += enemy.wobbleSpeed;
                        enemy.x += Math.sin(enemy.wobbleOffset)*0.5;
                        if (enemy.x<80){enemy.x=80; enemy.bossDirection=1;}
                        if (enemy.x>W-80){enemy.x=W-80; enemy.bossDirection=-1;}
                        enemy.attackTimer += deltaTime;
                        if (enemy.attackTimer >= enemy.attackSwitchInterval) { enemy.attackTimer=0; enemy.attackPattern=(enemy.attackPattern+1)%3; }
                        enemy.shootTimer -= deltaTime;
                        if (enemy.shootTimer<=0) { bossShoot(enemy); enemy.shootTimer=enemy.shootInterval; }
                    }
                    continue;
                }
                if (enemy.movePattern==='straight') enemy.y += enemy.speed * slowFactor;
                else if (enemy.movePattern==='wobble') { enemy.y += enemy.speed * slowFactor; enemy.wobbleOffset += enemy.wobbleSpeed; enemy.x += Math.sin(enemy.wobbleOffset)*enemy.wobbleAmplitude*0.05; }
                else if (enemy.movePattern==='homing' && player) {
                    const angle = Math.atan2(player.y-enemy.y, player.x-enemy.x);
                    enemy.x += Math.cos(angle)*enemy.speed*slowFactor;
                    enemy.y += Math.sin(angle)*enemy.speed*slowFactor;
                }
                else if (enemy.type===EnemyType.CARRIER) {
                    enemy.y += enemy.speed * slowFactor;
                    enemy.spawnTimer -= deltaTime;
                    if (enemy.spawnTimer<=0) {
                        enemy.spawnTimer = enemy.spawnInterval;
                        if (enemies.length < 20) {
                            enemies.push(createSmallEnemy(enemy.x-30, enemy.y, getDifficultyMultiplier()));
                            enemies.push(createSmallEnemy(enemy.x+30, enemy.y, getDifficultyMultiplier()));
                        }
                    }
                }

                // 隐形计时
                if (enemy.type===EnemyType.STEALTH) {
                    enemy.stealthTimer += deltaTime;
                    if (enemy.stealthTimer > 2000) { enemy.visible = !enemy.visible; enemy.stealthTimer=0; }
                }

                if (enemy.canShoot) {
                    enemy.shootTimer -= deltaTime;
                    if (enemy.shootTimer <= 0) { enemyShoot(enemy); enemy.shootTimer = enemy.shootInterval; }
                }
                if (enemy.y > H+60) {
                    enemies.splice(i,1);
                    game.waveEnemiesRemaining = Math.max(0, game.waveEnemiesRemaining-1);
                }
            }
        }

        function bossShoot(boss) {
            const bulletSpeed = getEnemyBulletSpeed();
            if (boss.attackPattern===0) {
                const count=7, spread=Math.PI/2;
                for(let i=0;i<count;i++) {
                    const angle = Math.PI/2 + (i-(count-1)/2)*(spread/(count-1));
                    enemyBullets.push(createEnemyBullet(boss.x,boss.y+boss.height/2,Math.cos(angle)*bulletSpeed,Math.sin(angle)*bulletSpeed));
                }
            } else if (boss.attackPattern===1) {
                const count=12;
                for(let i=0;i<count;i++) {
                    const angle=(i/count)*Math.PI*2;
                    enemyBullets.push(createEnemyBullet(boss.x,boss.y+boss.height/2,Math.cos(angle)*bulletSpeed*0.7,Math.sin(angle)*bulletSpeed*0.7));
                }
            } else {
                if (player) {
                    const angle=Math.atan2(player.y-boss.y,player.x-boss.x);
                    for(let i=-1;i<=1;i++) {
                        const spreadAngle=angle+i*0.3;
                        enemyBullets.push(createEnemyBullet(boss.x,boss.y+boss.height/2,Math.cos(spreadAngle)*bulletSpeed,Math.sin(spreadAngle)*bulletSpeed));
                    }
                }
            }
        }
        function enemyShoot(enemy) {
            const bulletSpeed = getEnemyBulletSpeed();
            if (enemy.type===EnemyType.ELITE) {
                const count=enemy.fanBulletCount, spread=enemy.fanBulletSpread;
                for(let i=0;i<count;i++) {
                    const angle = Math.PI/2 + (i-(count-1)/2)*(spread/(count-1));
                    enemyBullets.push(createEnemyBullet(enemy.x,enemy.y+enemy.height/2,Math.cos(angle)*bulletSpeed,Math.sin(angle)*bulletSpeed));
                }
            } else if (enemy.type===EnemyType.HEAVY || enemy.type===EnemyType.SHIELDED) {
                if (player) {
                    const angle=Math.atan2(player.y-enemy.y,player.x-enemy.x);
                    enemyBullets.push(createEnemyBullet(enemy.x,enemy.y+enemy.height/2,Math.cos(angle)*bulletSpeed*0.6,Math.sin(angle)*bulletSpeed*0.6));
                }
            }
        }

        // ==================== 子弹更新 ====================
        function updatePlayerBullets() {
            for (let i=playerBullets.length-1; i>=0; i--) {
                const b=playerBullets[i];
                b.y -= b.speed;
                b.trail.push({x:b.x,y:b.y+8});
                if(b.trail.length>6)b.trail.shift();
                if(b.y<-20)playerBullets.splice(i,1);
            }
        }
        function updateEnemyBullets() {
            const slowFactor = game.slowActive ? 0.5 : 1;
            for (let i=enemyBullets.length-1; i>=0; i--) {
                const b=enemyBullets[i];
                b.x += b.vx * slowFactor;
                b.y += b.vy * slowFactor;
                b.trail.push({x:b.x,y:b.y});
                if(b.trail.length>4)b.trail.shift();
                if(b.y>H+20||b.x<-20||b.x>W+20||b.y<-20)enemyBullets.splice(i,1);
            }
        }
        function updatePowerups() {
            for (let i=powerups.length-1; i>=0; i--) {
                const p=powerups[i];
                // 磁铁吸附
                if (player && (game.magnetActive || (p.type===PowerupType.MAGNET?false:false))) {
                    // 任何时候都稍微吸附一点，磁铁激活时加强
                }
                if (player && game.magnetActive) {
                    const dx = player.x - p.x, dy = player.y - p.y;
                    const dist = Math.hypot(dx, dy);
                    if (dist < 120 && dist > 0.01) {
                        const pull = 0.12 + Math.max(0, (120 - dist) / 120) * 0.18;
                        p.x += dx * pull;
                        p.y += dy * pull;
                    }
                } else if (player) {
                    const dx = player.x - p.x, dy = player.y - p.y;
                    const dist = Math.hypot(dx, dy);
                    if (dist < 55 && dist > 0.01) {
                        p.x += dx * 0.03;
                        p.y += dy * 0.03;
                    }
                }
                p.y += p.speed;
                p.pulseOffset += 0.06;
                if(p.y>H+30)powerups.splice(i,1);
            }
        }
        function updateParticles() {
            for (let i=particles.length-1; i>=0; i--) {
                const p=particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vy += (p.type==='engine'?0.05:0.03);
                p.life -= p.decay;
                p.radius *= 0.99;
                if(p.life<=0||p.radius<0.3)particles.splice(i,1);
            }
        }

        // ==================== 碰撞检测 ====================
        function checkCollisions() {
            if (!player) return;
            for (let i=playerBullets.length-1; i>=0; i--) {
                const bullet = playerBullets[i];
                for (let j=enemies.length-1; j>=0; j--) {
                    const enemy = enemies[j];
                    if (bulletHitEnemy(bullet, enemy)) {
                        // P 道具：穿透弹，每个敌人只受一次伤害
                        if (bullet.pierce) {
                            if (bullet.hitEnemies && bullet.hitEnemies.includes(j)) continue;
                            if (bullet.hitEnemies) bullet.hitEnemies.push(j);
                        }
                        enemy.hp -= bullet.damage;
                        addExplosion(bullet.x,bullet.y, bullet.pierce?'#00ff88':'#00ffff',5,2);
                        if (!bullet.pierce) {
                            playerBullets.splice(i,1);
                            if (enemy.hp <= 0) destroyEnemy(j);
                            break;
                        } else {
                            if (enemy.hp <= 0) destroyEnemy(j);
                        }
                    }
                }
            }
            for (let i=enemyBullets.length-1; i>=0; i--) {
                const bullet = enemyBullets[i];
                if (bulletHitPlayer(bullet)) {
                    // X 超级护盾：无敌+护盾激活时反弹子弹
                    if (player.invincible && player.shieldActive) {
                        bullet.vx = -bullet.vx * 1.2;
                        bullet.vy = -bullet.vy * 1.2;
                        bullet.isReflected = true;
                        bullet.color = '#ffffff';
                        addExplosion(bullet.x, bullet.y, '#ffffff', 6, 2);
                    } else {
                        enemyBullets.splice(i,1);
                        hitPlayer();
                    }
                }
            }
            for (let i=enemies.length-1; i>=0; i--) {
                const enemy = enemies[i];
                if (enemyHitPlayer(enemy)) {
                    if (enemy.type===EnemyType.BOSS) hitPlayer(999);
                    else { destroyEnemy(i); hitPlayer(); }
                }
            }
            for (let i=powerups.length-1; i>=0; i--) {
                const powerup = powerups[i];
                if (powerupHitPlayer(powerup)) { applyPowerup(powerup); powerups.splice(i,1); }
            }
        }

        function bulletHitEnemy(bullet, enemy) {
            const r1=8, r2=Math.max(enemy.width,enemy.height)*0.5;
            const dx=bullet.x-enemy.x, dy=bullet.y-enemy.y;
            return Math.hypot(dx,dy) < r1+r2;
        }
        function bulletHitPlayer(bullet) {
            if (!player || player.invincible) return false;
            const r=18, dx=bullet.x-player.x, dy=bullet.y-player.y;
            return Math.hypot(dx,dy) < bullet.radius+r;
        }
        function enemyHitPlayer(enemy) {
            if (!player || player.invincible) return false;
            const r1=20, r2=Math.max(enemy.width,enemy.height)*0.4;
            const dx=enemy.x-player.x, dy=enemy.y-player.y;
            return Math.hypot(dx,dy) < r1+r2;
        }
        function powerupHitPlayer(powerup) {
            if (!player) return false;
            const r=28, dx=powerup.x-player.x, dy=powerup.y-player.y;
            return Math.hypot(dx,dy) < r+powerup.size/2;
        }

        function destroyEnemy(index) {
            const enemy = enemies[index];
            if (!enemy) return;
            game.score += enemy.score;
            game.kills++;
            game.waveEnemiesRemaining = Math.max(0, game.waveEnemiesRemaining-1);
            const count = enemy.type===EnemyType.BOSS?60:enemy.type===EnemyType.ELITE?35:enemy.type===EnemyType.HEAVY?25:15;
            addExplosion(enemy.x,enemy.y,enemy.color,count,5);
            // 道具掉落：BOSS 必掉、ELITE 翻倍、其他按基础概率+难度调整
            let dropRate = CONFIG.powerup.dropChance + getDifficultyConfig().dropChanceBonus;
            if (enemy.type === EnemyType.ELITE) dropRate *= 2;
            if (enemy.type === EnemyType.BOSS) dropRate = 1;
            if (Math.random() < dropRate) powerups.push(createPowerup(enemy.x,enemy.y));
            enemies.splice(index,1);
            if (enemy.type===EnemyType.BOSS) {
                boss=null;
                game.score += 300;
                addExplosion(enemy.x,enemy.y,'#ff2200',80,8);
                addExplosion(enemy.x,enemy.y,'#ffaa00',50,6);
                game.waveActive=false;
                setTimeout(()=>{ if(game.state===GameState.PLAYING) startNextWave(); },2000);
            }
        }

        function hitPlayer(damage) {
            if (!player || player.invincible) return;
            if (player.shieldActive) {
                player.shieldActive=false;
                player.shieldTimer=0;
                addExplosion(player.x,player.y,'#00ccff',25,4);
                player.invincible=true;
                player.invincibleTimer=CONFIG.player.invincibleDuration;
                return;
            }
            player.lives = (player.lives||0) - (damage||1);
            game.lives = player.lives;
            player.invincible=true;
            player.invincibleTimer=CONFIG.player.invincibleDuration;
            addExplosion(player.x,player.y,'#ff3333',20,3);
            if (player.lives<=0) { player.lives=0; endGame(); }
        }

        function applyPowerup(powerup) {
            if (!player) return;
            addPickupFlash(powerup.x,powerup.y,powerup.color);
            switch(powerup.type){
                case PowerupType.WEAPON: if(player.weaponLevel<3) player.weaponLevel++; player.weaponTimer=CONFIG.player.weaponDuration; break;
                case PowerupType.SHIELD: player.shieldActive=true; player.shieldTimer=CONFIG.player.shieldDuration; break;
                case PowerupType.BOMB:
                    for(let i=enemies.length-1;i>=0;i--){
                        const e=enemies[i];
                        if(e.type===EnemyType.BOSS){ e.hp-=50; if(e.hp<=0)destroyEnemy(i); }
                        else { game.score+=e.score; game.kills++; game.waveEnemiesRemaining=Math.max(0,game.waveEnemiesRemaining-1); addExplosion(e.x,e.y,e.color,20,5); enemies.splice(i,1); }
                    }
                    enemyBullets=[];
                    addExplosion(W/2,H/2,'#ffffff',50,8);
                    game.shakeTimer = 350; game.shakeAmp = 7;
                    break;
                case PowerupType.HEAL: if(game.mode===GameMode.SURVIVAL) game.score+=50; else if(player.lives<game.maxLives){player.lives++; game.lives=player.lives;} else game.score+=30; break;
                case PowerupType.DRONE: player.droneActive=true; player.droneTimer=CONFIG.player.droneDuration; drones=[{x:player.x-28,y:player.y+15},{x:player.x+28,y:player.y+15}]; break;
                case PowerupType.SPEED: player.speedBoostActive=true; player.speedBoostTimer=CONFIG.player.speedBoostDuration; break;
                case PowerupType.PIERCE: player.pierceActive = true; player.pierceTimer = 8000; break;
                case PowerupType.MAGNET: /* 磁铁效果 */ game.magnetActive=true; game.magnetTimer=6000; break;
                case PowerupType.SLOW: game.slowActive=true; game.slowTimer=5000; break;
                case PowerupType.SUPER_SHIELD: player.invincible=true; player.invincibleTimer=3000; player.shieldActive=true; player.shieldTimer=3000; break;

                // ---- 新增道具 ----
                case PowerupType.GRAVITY: { // 重力炸弹：吸下屏幕底部敌人、清空敌弹、Boss 巨大伤害
                    game.shakeTimer = 450; game.shakeAmp = 9;
                    addExplosion(W/2, H*0.7, '#cc88ff', 80, 10);
                    for (let i=enemies.length-1; i>=0; i--) {
                        const e = enemies[i];
                        if (e.type===EnemyType.BOSS) { e.hp -= 85; if (e.hp<=0) destroyEnemy(i); }
                        else { game.score += Math.floor(e.score * 1.2); game.kills++; game.waveEnemiesRemaining = Math.max(0, game.waveEnemiesRemaining-1); addExplosion(e.x, e.y, '#cc88ff', 18, 6); enemies.splice(i,1); }
                    }
                    enemyBullets = [];
                    break;
                }
                case PowerupType.RAPID: // 极速连射：fireInterval 大幅减少一段时间
                    game.rapidActive = true; game.rapidTimer = 8000; break;
                case PowerupType.HOMING: // 追踪导弹：生成若干追踪弹对象，并开启动态发射一段时间
                    game.homingActive = true; game.homingTimer = 9000;
                    // 立即发射 3 枚追踪弹
                    for (let k = -1; k <= 1; k++) {
                        game.homingBullets.push({
                            x: player.x + k*14, y: player.y - player.height/2,
                            vx: k*0.8, vy: -4, damage: player.bulletDamage+2,
                            life: 260, turn: 0.07, trail: [],
                        });
                    }
                    break;
                case PowerupType.LASER: // 激光主炮：持续 4 秒的穿透激光柱
                    game.laserActive = true; game.laserTimer = 4000; break;
                case PowerupType.HEAL_PLUS: // 紧急救援：恢复 2 命或大量分数
                    if (game.mode===GameMode.SURVIVAL) {
                        game.score += 150; player.shieldActive = true; player.shieldTimer = 6000;
                    } else {
                        const add = Math.min(2, game.maxLives - player.lives);
                        if (add > 0) { player.lives += add; game.lives = player.lives; }
                        else game.score += 80;
                        player.invincible = true; player.invincibleTimer = 2500;
                    }
                    break;
                case PowerupType.NUKE: // 微型核弹：全屏中等伤害 + 敌人灼烧（减速 3 秒）+ 屏幕震动
                    game.shakeTimer = 380; game.shakeAmp = 8;
                    game.slowActive = true; game.slowTimer = Math.max(game.slowTimer, 3000);
                    addExplosion(W/2, H/2, '#ff88cc', 70, 9);
                    for (let i=enemies.length-1; i>=0; i--) {
                        const e = enemies[i];
                        if (e.type===EnemyType.BOSS) { e.hp -= 30; if (e.hp<=0) destroyEnemy(i); }
                        else {
                            const dmg = Math.max(1, Math.ceil(e.maxHp * 0.45));
                            e.hp -= dmg;
                            if (e.hp<=0) destroyEnemy(i);
                            else addExplosion(e.x, e.y, '#ff66aa', 10, 3);
                        }
                    }
                    enemyBullets = [];
                    break;
                case PowerupType.WINGMAN: // 僚机编队：额外 4 架僚机
                    game.wingmanActive = true; game.wingmanTimer = 12000;
                    // 立即刷新 4 架僚机（玩家自己的僚机 + 新增的）
                    if (!player.droneActive) {
                        player.droneActive = true;
                        player.droneTimer = Math.max(player.droneTimer, 12000);
                    } else {
                        player.droneTimer = Math.max(player.droneTimer, 12000);
                    }
                    drones = [
                        {x:player.x-42,y:player.y+20},{x:player.x-20,y:player.y+10},
                        {x:player.x+20,y:player.y+10},{x:player.x+42,y:player.y+20},
                    ];
                    break;
            }
        }

        // 触发玩家全屏炸弹（B 技能按钮 / 💥）
        function usePlayerBomb() {
            if (!player) return;
            // 消耗 1 枚炸弹库存或 200 分数成本（分数不够就扣血但不掉命的限制：这里用分数优先，否则 HP-1 作为代价）
            const costScore = 180;
            if (game.score >= costScore) {
                game.score -= costScore;
            } else if (player.lives > 1) {
                player.lives--;
                game.lives = player.lives;
                game.shakeTimer = 300; game.shakeAmp = 5;
            } else {
                // 不够也发动但加短暂无敌
                player.invincible = true; player.invincibleTimer = Math.max(player.invincibleTimer, 1200);
            }
            for (let i = enemies.length-1; i >= 0; i--) {
                const e = enemies[i];
                if (e.type === EnemyType.BOSS) { e.hp -= 60; if (e.hp<=0) destroyEnemy(i); }
                else { game.score += e.score; game.kills++; game.waveEnemiesRemaining = Math.max(0, game.waveEnemiesRemaining-1); addExplosion(e.x,e.y,e.color,22,5); enemies.splice(i,1); }
            }
            enemyBullets = [];
            addExplosion(W/2, H/2, '#ffee99', 55, 9);
            game.shakeTimer = Math.max(game.shakeTimer, 420); game.shakeAmp = Math.max(game.shakeAmp, 8);
        }

        function endGame() {
            game.state=GameState.GAME_OVER;
            game.gameOverInfo={score:game.score,kills:game.kills,wave:game.wave,timeSurvived:game.totalElapsed};
            initGameOverButtons();
        }

        // ==================== 初始化游戏 ====================
        function initGame(mode, difficulty) {
            game.mode = mode;
            game.difficulty = difficulty || game.difficulty;
            game.state = GameState.PLAYING;
            game.score = 0;
            game.kills = 0;
            game.wave = 0;
            game.totalElapsed = 0;
            game.difficultyMultiplier = 1.0;
            game.timedHalfReached = false;
            game.timeRemaining = CONFIG.timedMode.duration;
            game.frameCount = 0;
            game.magnetActive = false;
            game.slowActive = false;
            game.rapidActive = false;
            game.homingActive = false;
            game.laserActive = false;
            game.wingmanActive = false;
            game.magnetTimer = 0;
            game.slowTimer = 0;
            game.rapidTimer = 0;
            game.homingTimer = 0;
            game.laserTimer = 0;
            game.wingmanTimer = 0;
            game.shakeTimer = 0;  // 屏幕震动剩余 ms
            game.shakeAmp = 0;

            const shipCfg = ShipConfig[selectedShip] || ShipConfig.tempest;
            if (mode===GameMode.SURVIVAL) { game.maxLives=1; game.lives=1; }
            else { game.maxLives=Math.max(shipCfg.initialLives, CONFIG.player.maxLives); game.lives=shipCfg.initialLives; }

            playerBullets=[]; enemies=[]; enemyBullets=[]; powerups=[]; particles=[]; drones=[]; boss=null;
            game.homingBullets = [];  // 追踪弹（独立数组，不做 pierce）
            game.laserBeam = null;   // 激光主炮 {x1,y1,x2,y2,width,life,...}
            player = createPlayer();
            player.lives = game.lives;
            game.waveActive=false; game.waveTimer=0; game.waveEnemiesRemaining=0;

            setTimeout(()=>{ if(game.state===GameState.PLAYING) startNextWave(); },500);
            initStars();
            canvas.focus();
            updateTouchControlsVisibility();
        }

        function returnToMenu() {
            game.state = GameState.MENU;
            player = null;
            playerBullets=[]; enemies=[]; enemyBullets=[]; powerups=[]; particles=[]; drones=[]; boss=null;
            initStars();
            initMenuButtons();
            initDifficultyButtons();
            canvas.focus();
            updateTouchControlsVisibility();
        }

        // ==================== 按钮初始化 ====================
