        // ==================== 敌机类型 ====================
        const EnemyType = { SMALL: 'small', MEDIUM: 'medium', HEAVY: 'heavy', ELITE: 'elite', BOSS: 'boss', SUICIDE: 'suicide', STEALTH: 'stealth', SHIELDED: 'shielded', CARRIER: 'carrier' };

