                    trailLen: 60 + Math.random() * 30,
                    offset: i * 0.18,
                });
            }
        }
        function updateMenuAnimations() {
            menuNebulaPulse += 0.015;
            for (const jet of menuJets) {
                jet.x += jet.speed * jet.dir;
                jet.flapPhase += 0.2;
                if (jet.dir > 0 && jet.x > W + 100) { jet.x = -100; jet.y = 100 + Math.random() * (H - 200); }
                if (jet.dir < 0 && jet.x < -100) { jet.x = W + 100; jet.y = 100 + Math.random() * (H - 200); }
            }
            for (let i = menuShootingStars.length - 1; i >= 0; i--) {
                const s = menuShootingStars[i];
                s.x += s.vx; s.y += s.vy; s.life--;
                if (s.life <= 0 || s.x < -50 || s.x > W + 50 || s.y > H + 50) menuShootingStars.splice(i, 1);
            }
            if (Math.random() < 0.008 && menuShootingStars.length < 3) {
                const side = Math.random() < 0.5 ? 0 : 1;
                menuShootingStars.push({
                    x: side === 0 ? -20 : W + 20,
                    y: 50 + Math.random() * 200,
                    vx: (side === 0 ? 1 : -1) * (4 + Math.random() * 3),
                    vy: 1 + Math.random() * 1.5,
                    life: 60 + Math.random() * 40,
                    maxLife: 100,
                    length: 30 + Math.random() * 40,
                });
            }
            for (let i = menuParticleRipples.length - 1; i >= 0; i--) {
                const r = menuParticleRipples[i];
                r.radius += r.speed; r.alpha -= r.decay;
                if (r.alpha <= 0) menuParticleRipples.splice(i, 1);
            }
            // 更新流光光束
            for (let i = menuLightBeams.length - 1; i >= 0; i--) {
                const b = menuLightBeams[i];
                b.x += b.vx;
                b.y += b.vy;
                b.life--;
                if (b.life <= 0 || b.x < -400 || b.x > W + 400 || b.y < -400 || b.y > H + 400) {
                    menuLightBeams.splice(i, 1);
                }
            }
            // 随机生成新光束（横向或斜向扫过）
            if (Math.random() < 0.006 && menuLightBeams.length < 4) {
                const dir = Math.random() < 0.7; // 70% 横向，30% 斜向
                const fromLeft = Math.random() < 0.6;
                const hue = 190 + Math.random() * 40; // 蓝青色系
                const thickness = 30 + Math.random() * 60;
                const speed = 1.8 + Math.random() * 2.8;
                const len = 220 + Math.random() * 320;
                menuLightBeams.push({
                    x: fromLeft ? -len : W + len,
                    y: 60 + Math.random() * (H - 120),
                    vx: (fromLeft ? 1 : -1) * speed,
                    vy: dir ? 0 : (Math.random() < 0.5 ? -1 : 1) * (0.4 + Math.random() * 0.8),
                    thickness: thickness,
                    length: len,
                    life: 220 + Math.random() * 160,
                    hue: hue,
                    angle: dir ? 0 : (Math.random() - 0.5) * 0.5,
                });
            }
            // 地球自转
            earthRotation += 0.0028;
            earthCloudOffset += 0.0015;
            // 背景战机群飞行（缓慢编队上升飞向右上角）
            for (const ac of bgAircraftSquad) {
                ac.x += ac.speed * ac.dir;
                ac.y -= ac.speed * 0.5; // 向上爬升
                ac.flapPhase += 0.15;
                // 引擎尾迹
                ac.trail.push({ x: ac.x, y: ac.y });
                if (ac.trail.length > ac.trailLen) ac.trail.shift();
                // 飞出屏幕后从左下重新编队进入
                if (ac.x > W + 150 || ac.y < -50) {
                    ac.x = W * 0.1 + Math.random() * 40;
                    ac.y = H + 40;
                    ac.trail = [];
                }
            }
        }

        // ==================== 动态地球绘制 ====================
        function drawEarth() {
            // 地球位于屏幕底部，占宽度约520px，高度约260px（可见弧面）
            const cx = W / 2;
            const cy = H + 80; // 球心在屏幕下方，只露出上部弧面
            const R = 380; // 地球半径
            const visibleArcTop = H - 40; // 地球顶部切点位置

            ctx.save();

            // 大气光晕（外层蓝色光圈）
            const atmosGrad = ctx.createRadialGradient(cx, cy, R * 0.95, cx, cy, R * 1.18);
            atmosGrad.addColorStop(0, 'rgba(100,200,255,0)');
            atmosGrad.addColorStop(0.6, 'rgba(80,180,255,0.12)');
            atmosGrad.addColorStop(0.85, 'rgba(120,220,255,0.22)');
            atmosGrad.addColorStop(1, 'rgba(100,200,255,0)');
            ctx.fillStyle = atmosGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, R * 1.18, 0, Math.PI * 2);
            ctx.fill();

            // 大气亮边（顶部高光）
            const rimGrad = ctx.createRadialGradient(cx, cy - R * 0.75, R * 0.6, cx, cy - R * 0.75, R * 1.05);
            rimGrad.addColorStop(0, 'rgba(200,240,255,0)');
            rimGrad.addColorStop(0.8, 'rgba(150,220,255,0)');
            rimGrad.addColorStop(1, 'rgba(180,240,255,0.18)');
            ctx.fillStyle = rimGrad;
            ctx.beginPath();
            ctx.arc(cx, cy, R * 1.05, 0, Math.PI * 2);
            ctx.fill();

            // 地球主体
            ctx.save();
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, Math.PI * 2);
            ctx.clip();

            // 海洋底色（深蓝）
            const oceanGrad = ctx.createLinearGradient(cx, cy - R, cx, cy + R);
            oceanGrad.addColorStop(0, '#1a4a8a');
            oceanGrad.addColorStop(0.3, '#0d3566');
            oceanGrad.addColorStop(0.6, '#0a2a52');
            oceanGrad.addColorStop(1, '#061a36');
            ctx.fillStyle = oceanGrad;
            ctx.fillRect(cx - R, cy - R, R * 2, R * 2);

            // 绘制旋转的大陆（基于earthRotation偏移）
            const continents = [
                // 大陆1（北美风格）
                { x: -0.85, y: -0.3, w: 0.22, h: 0.18, r: 0.08 },
                // 大陆2（南美风格）
                { x: -0.7, y: 0.1, w: 0.12, h: 0.2, r: 0.05 },
                // 大陆3（欧亚大陆）
                { x: -0.3, y: -0.35, w: 0.35, h: 0.16, r: 0.12 },
                // 大陆4（非洲）
                { x: -0.05, y: -0.05, w: 0.14, h: 0.22, r: 0.06 },
                // 大陆5（澳洲）
                { x: 0.25, y: 0.05, w: 0.12, h: 0.08, r: 0.05 },
                // 大陆6（格陵兰）
                { x: -0.5, y: -0.42, w: 0.08, h: 0.06, r: 0.04 },
                // 大陆7（东南亚群岛）
                { x: 0.2, y: -0.1, w: 0.1, h: 0.08, r: 0.04 },
                // 大陆8（南极边缘）
                { x: -0.2, y: 0.38, w: 0.5, h: 0.06, r: 0.04 },
            ];
            const landColors = ['#3a7a4a', '#2d6a3e', '#4a8a58', '#3e7a4e', '#2d6a3e'];
            for (let i = 0; i < continents.length; i++) {
                const c = continents[i];
                // 应用旋转（经度方向位移）
                let lx = c.x + earthRotation;
                // 包裹在 [-1.2, 1.2] 范围
                while (lx > 1.3) lx -= 2.6;
                while (lx < -1.3) lx += 2.6;
                const px = cx + lx * R;
                const py = cy + c.y * R;
                const pw = c.w * R;
                const ph = c.h * R;
                const grad = ctx.createRadialGradient(px, py, 2, px, py, Math.max(pw, ph));
                grad.addColorStop(0, landColors[i % landColors.length]);
                grad.addColorStop(0.7, landColors[(i + 1) % landColors.length]);
                grad.addColorStop(1, 'rgba(30,80,40,0.4)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.ellipse(px, py, pw, ph * 0.85, 0, 0, Math.PI * 2);
                ctx.fill();
            }

            // 极地冰盖（固定在球顶和球底，不旋转）
            const iceGradTop = ctx.createRadialGradient(cx, cy - R * 0.9, 2, cx, cy - R * 0.9, R * 0.28);
            iceGradTop.addColorStop(0, 'rgba(240,248,255,0.9)');
            iceGradTop.addColorStop(0.5, 'rgba(220,235,250,0.6)');
            iceGradTop.addColorStop(1, 'rgba(200,220,240,0)');
            ctx.fillStyle = iceGradTop;
            ctx.beginPath();
            ctx.ellipse(cx, cy - R * 0.88, R * 0.35, R * 0.15, 0, 0, Math.PI * 2);
            ctx.fill();

            const iceGradBot = ctx.createRadialGradient(cx, cy + R * 0.92, 2, cx, cy + R * 0.92, R * 0.25);
            iceGradBot.addColorStop(0, 'rgba(240,248,255,0.85)');
            iceGradBot.addColorStop(0.6, 'rgba(210,230,245,0.5)');
            iceGradBot.addColorStop(1, 'rgba(200,220,240,0)');
            ctx.fillStyle = iceGradBot;
            ctx.beginPath();
            ctx.ellipse(cx, cy + R * 0.9, R * 0.4, R * 0.12, 0, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore(); // 回到正常裁剪

            // 赤道附近云带（缓慢移动）
            ctx.save();
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, Math.PI * 2);
            ctx.clip();
            for (let ci = 0; ci < 4; ci++) {
                const cloudY = cy - R * 0.3 + ci * R * 0.18;
                const cloudAlpha = 0.08 + Math.sin(menuNebulaPulse * 2 + ci) * 0.04;
                // 云带偏移
                const cloudShift = (earthCloudOffset * R * 8 + ci * R * 0.3) % (R * 2);
                const cloudGrad = ctx.createLinearGradient(cx - R, cloudY, cx + R, cloudY);
                cloudGrad.addColorStop(0, `rgba(255,255,255,0)`);
                cloudGrad.addColorStop(0.3, `rgba(255,255,255,${cloudAlpha})`);
                cloudGrad.addColorStop(0.5, `rgba(255,255,255,${cloudAlpha * 1.3})`);
                cloudGrad.addColorStop(0.7, `rgba(255,255,255,${cloudAlpha})`);
                cloudGrad.addColorStop(1, `rgba(255,255,255,0)`);
                ctx.fillStyle = cloudGrad;
                ctx.beginPath();
                ctx.ellipse(cx - R + cloudShift - R, cloudY, R * 3, R * 0.04, 0, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.restore();

            // 夜半球阴影（右上方向，模拟太阳照射）
            ctx.save();
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, Math.PI * 2);
            ctx.clip();
            const shadowGrad = ctx.createLinearGradient(cx + R * 0.3, cy - R, cx - R * 0.5, cy + R);
            shadowGrad.addColorStop(0, 'rgba(0,0,0,0)');
            shadowGrad.addColorStop(0.5, 'rgba(0,0,0,0.15)');
            shadowGrad.addColorStop(1, 'rgba(0,0,0,0.55)');
            ctx.fillStyle = shadowGrad;
            ctx.fillRect(cx - R, cy - R, R * 2, R * 2);
            ctx.restore();

            // 地球边缘暗化（圆形遮罩）
            ctx.save();
            ctx.beginPath();
            ctx.arc(cx, cy, R, 0, Math.PI * 2);
            ctx.clip();
            const edgeGrad = ctx.createRadialGradient(cx, cy, R * 0.75, cx, cy, R);
            edgeGrad.addColorStop(0, 'rgba(0,0,0,0)');
            edgeGrad.addColorStop(1, 'rgba(0,5,15,0.35)');
            ctx.fillStyle = edgeGrad;
            ctx.fillRect(cx - R, cy - R, R * 2, R * 2);
            ctx.restore();

            // 大气外层高光弧线（顶部亮弧）
            ctx.save();
            ctx.beginPath();
            ctx.arc(cx, cy, R + 2, Math.PI * 1.15, Math.PI * 1.85);
            ctx.lineWidth = 3;
            ctx.strokeStyle = 'rgba(180,230,255,0.25)';
            ctx.shadowColor = 'rgba(150,220,255,0.4)';
            ctx.shadowBlur = 10;
            ctx.stroke();
            ctx.restore();

            ctx.restore();
        }

        // ==================== 背景战机群绘制 ====================
        function drawBgAircraftSquad() {
            for (const ac of bgAircraftSquad) {
                const flapOffset = Math.sin(ac.flapPhase) * 2;

                // 引擎尾迹
                if (ac.trail.length > 1) {
                    for (let i = 1; i < ac.trail.length; i++) {
                        const p0 = ac.trail[i - 1];
                        const p1 = ac.trail[i];
                        const alpha = (i / ac.trail.length) * 0.4;
                        const width = (i / ac.trail.length) * 3;
                        ctx.save();
                        ctx.strokeStyle = `rgba(150,220,255,${alpha})`;
                        ctx.lineWidth = width;
                        ctx.shadowColor = 'rgba(100,200,255,0.5)';
                        ctx.shadowBlur = 6;
                        ctx.beginPath();
                        ctx.moveTo(p0.x, p0.y);
                        ctx.lineTo(p1.x, p1.y);
                        ctx.stroke();
                        ctx.restore();
                    }
                }

                // 战机本体
                ctx.save();
                ctx.translate(ac.x, ac.y);
                ctx.scale(ac.scale, ac.scale);

                // 机身（暗色剪影）
                ctx.fillStyle = 'rgba(10,20,45,0.92)';
                ctx.strokeStyle = 'rgba(100,200,255,0.35)';
                ctx.lineWidth = 0.8;
                ctx.shadowColor = 'rgba(100,200,255,0.5)';
                ctx.shadowBlur = 6;

                // 机身轮廓
                ctx.beginPath();
                ctx.moveTo(28, 0);
                ctx.lineTo(15, -4);
                ctx.lineTo(0, -3);
                ctx.lineTo(-15, -5);
                ctx.lineTo(-22, -2);
                ctx.lineTo(-22, 2);
                ctx.lineTo(-15, 5);
                ctx.lineTo(0, 3);
                ctx.lineTo(15, 4);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                // 主翼
                ctx.beginPath();
                ctx.moveTo(-5, -3);
                ctx.lineTo(-12, -14);
                ctx.lineTo(-18, -12);
                ctx.lineTo(-8, -2);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(-5, 3);
                ctx.lineTo(-12, 14);
                ctx.lineTo(-18, 12);
                ctx.lineTo(-8, 2);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                // 尾翼
                ctx.beginPath();
                ctx.moveTo(-18, -2);
                ctx.lineTo(-26, -6);
                ctx.lineTo(-24, 0);
                ctx.lineTo(-26, 6);
                ctx.lineTo(-18, 2);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                // 驾驶舱
                const cockpitGrad = ctx.createRadialGradient(6, 0, 1, 6, 0, 5);
                cockpitGrad.addColorStop(0, 'rgba(200,240,255,0.7)');
                cockpitGrad.addColorStop(0.5, 'rgba(100,180,220,0.3)');
                cockpitGrad.addColorStop(1, 'rgba(30,60,90,0.2)');
                ctx.fillStyle = cockpitGrad;
                ctx.beginPath();
                ctx.ellipse(6, 0, 5, 3.5, 0, 0, Math.PI * 2);
                ctx.fill();

                // 引擎尾焰
                const flameLen = 18 + flapOffset;
                const flameGrad = ctx.createLinearGradient(-22, 0, -22 - flameLen, 0);
                flameGrad.addColorStop(0, 'rgba(100,220,255,0.9)');
                flameGrad.addColorStop(0.3, 'rgba(60,160,255,0.6)');
                flameGrad.addColorStop(0.7, 'rgba(30,80,200,0.3)');
                flameGrad.addColorStop(1, 'rgba(20,40,120,0)');
                ctx.fillStyle = flameGrad;
                ctx.beginPath();
                ctx.moveTo(-20, -3);
                ctx.lineTo(-22 - flameLen, 0);
                ctx.lineTo(-20, 3);
                ctx.closePath();
                ctx.fill();

                ctx.restore();
            }
        }

        // ==================== 玩家 ====================
        function createPlayer() {
            const cfg = ShipConfig[selectedShip] || ShipConfig.tempest;
            return {
                shipType: selectedShip,
