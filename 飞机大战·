        // ==================== 道具 ====================
        const PowerupType = {
            WEAPON:'W', SHIELD:'S', BOMB:'B', HEAL:'H', DRONE:'D', SPEED:'A', PIERCE:'P',
            MAGNET:'M', SLOW:'T', SUPER_SHIELD:'X',
            GRAVITY:'G', RAPID:'R', HOMING:'F', LASER:'L', HEAL_PLUS:'E', NUKE:'N', WINGMAN:'U',
        };
        const PowerupConfig = {
            W:{ color:'#ff8800', label:'武器升级', letter:'W' },
            S:{ color:'#00ccff', label:'护盾', letter:'S' },
            B:{ color:'#ff3333', label:'全屏炸弹', letter:'B' },
