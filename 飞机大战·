        function initDifficultyButtons() {
            // 全屏扩展：难度按钮加宽，左右贴边减少留白
            const btnW = 138, btnH = 40, gap = 8, totalW = 4*btnW+3*gap;
            const startX = W/2 - totalW/2, startY = 148;
            difficultyButtons = [
                { x:startX, y:startY, width:btnW, height:btnH, label:'简单', difficulty:Difficulty.EASY },
                { x:startX+btnW+gap, y:startY, width:btnW, height:btnH, label:'普通', difficulty:Difficulty.NORMAL },
                { x:startX+2*(btnW+gap), y:startY, width:btnW, height:btnH, label:'困难', difficulty:Difficulty.HARD },
                { x:startX+3*(btnW+gap), y:startY, width:btnW, height:btnH, label:'地狱', difficulty:Difficulty.HELL },
            ];
            difficultySelectedIndex = 1;
        }
        function initGameOverButtons() {
            const btnW=220, btnH=46, startX=W/2-btnW/2, startY=540;
            gameOverButtons = [
                { x:startX, y:startY, width:btnW, height:btnH, label:'重新开始', action:'restart' },
                { x:startX, y:startY+60, width:btnW, height:btnH, label:'返回主菜单', action:'menu' },
            ];
        }

        // ==================== 触摸控制 ====================
        function updateTouchControlsVisibility() {
            const controls = document.getElementById('touchControls');
            if (controls) {
                const isTouch = ('ontouchstart' in window) || navigator.maxTouchPoints > 1 || window.innerWidth < 820;
                controls.style.display = (game.state === GameState.PLAYING && isTouch) ? 'flex' : 'none';
            }
            updateHudButtons();
            // 状态变非 PLAYING 时，停止相关输入
            if (game.state !== GameState.PLAYING) {
                mouseFiring = false; touchFiring = false;
                if (game.state !== GameState.PAUSED) {
                    mouseActive = false;
                    touchMoveActive = false;
                }
            }
        }

        // 虚拟按钮事件
        function bindTouchButton(id, key) {
            const btn = document.getElementById(id);
            if (!btn) return;
            const setKey = (val) => { keys[key] = val; };
            btn.addEventListener('touchstart', (e)=>{ e.preventDefault(); setKey(true); btn.classList.add('active'); }, {passive:false});
            btn.addEventListener('touchend', (e)=>{ e.preventDefault(); setKey(false); btn.classList.remove('active'); }, {passive:false});
            btn.addEventListener('touchcancel', (e)=>{ setKey(false); btn.classList.remove('active'); }, {passive:false});
            // 鼠标兼容
            btn.addEventListener('mousedown', (e)=>{ e.preventDefault(); setKey(true); }, {passive:false});
            btn.addEventListener('mouseup', (e)=>{ setKey(false); }, {passive:false});
            btn.addEventListener('mouseleave', (e)=>{ setKey(false); }, {passive:false});
        }
        bindTouchButton('btnUp','up');
        bindTouchButton('btnDown','down');
        bindTouchButton('btnLeft','left');
        bindTouchButton('btnRight','right');

        // 画布触摸拖动
        canvas.addEventListener('touchstart', (e)=>{
            if (game.state !== GameState.PLAYING) return;
            e.preventDefault();
            const touch = e.touches[0];
            const rect = canvas.getBoundingClientRect();
            const scaleX = W/rect.width, scaleY=H/rect.height;
            const touchX = (touch.clientX-rect.left)*scaleX;
            const touchY = (touch.clientY-rect.top)*scaleY;
            touchStartX = player.x;
            touchStartY = player.y;
            touchMoveActive = true;
        }, {passive:false});

        canvas.addEventListener('touchmove', (e)=>{
            if (!touchMoveActive || game.state !== GameState.PLAYING) return;
            e.preventDefault();
            const touch = e.touches[0];
            const rect = canvas.getBoundingClientRect();
            const scaleX = W/rect.width, scaleY=H/rect.height;
            const touchX = (touch.clientX-rect.left)*scaleX;
            const touchY = (touch.clientY-rect.top)*scaleY;
            // 直接设定目标位置
            if (player) {
                player.x += (touchX - player.x) * 0.3;
                player.y += (touchY - player.y) * 0.3;
                // 边界限制
                const margin=25;
                player.x = Math.max(margin, Math.min(W-margin, player.x));
                player.y = Math.max(60, Math.min(H-margin, player.y));
            }
        }, {passive:false});

        canvas.addEventListener('touchend', (e)=>{
            touchMoveActive = false;
        }, {passive:false});

        // ==================== 键盘事件 ====================
        window.addEventListener('keydown', (e)=>{
            const key = e.key.toLowerCase();
            if (game.state === GameState.MENU) {
                if (key==='q') {
                    const cur = shipKeys.indexOf(selectedShip);
                    selectedShip = shipKeys[(cur-1+shipKeys.length)%shipKeys.length]; e.preventDefault();
                } else if (key==='e') {
                    const cur = shipKeys.indexOf(selectedShip);
                    selectedShip = shipKeys[(cur+1)%shipKeys.length]; e.preventDefault();
                } else if (key==='1'||key==='2'||key==='3'||key==='4') {
                    const idx = parseInt(key)-1;
                    if (shipKeys[idx]) selectedShip = shipKeys[idx]; e.preventDefault();
                } else if (key==='arrowup'||key==='w') { menuSelectedIndex=(menuSelectedIndex-1+menuButtons.length)%menuButtons.length; e.preventDefault(); }
                else if (key==='arrowdown'||key==='s') { menuSelectedIndex=(menuSelectedIndex+1)%menuButtons.length; e.preventDefault(); }
                else if (key==='enter'||key===' ') { const btn=menuButtons[menuSelectedIndex]; if(btn) initGame(btn.mode, difficultyButtons[difficultySelectedIndex]?.difficulty || Difficulty.NORMAL); e.preventDefault(); }
                else if (key==='arrowleft'||key==='a') { difficultySelectedIndex=(difficultySelectedIndex-1+difficultyButtons.length)%difficultyButtons.length; e.preventDefault(); }
                else if (key==='arrowright'||key==='d') { difficultySelectedIndex=(difficultySelectedIndex+1)%difficultyButtons.length; e.preventDefault(); }
                else if (key==='x') { exportEnemySprites(); e.preventDefault(); }
                return;
            }
            if (key==='arrowup'||key==='w') keys.up=true;
            if (key==='arrowdown'||key==='s') keys.down=true;
            if (key==='arrowleft'||key==='a') keys.left=true;
            if (key==='arrowright'||key==='d') keys.right=true;
            if (key==='p' && game.state===GameState.PLAYING) { game.state=GameState.PAUSED; updateTouchControlsVisibility(); }
            else if (key==='p' && game.state===GameState.PAUSED) { game.state=GameState.PLAYING; updateTouchControlsVisibility(); }
            if (key==='x') { exportEnemySprites(); }
            if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) e.preventDefault();
        });
        window.addEventListener('keyup', (e)=>{
            const key = e.key.toLowerCase();
            if (key==='arrowup'||key==='w') keys.up=false;
            if (key==='arrowdown'||key==='s') keys.down=false;
            if (key==='arrowleft'||key==='a') keys.left=false;
            if (key==='arrowright'||key==='d') keys.right=false;
            if (key===' ') keys.fire=false;
        });

        // ==================== 鼠标控制 ====================
        function mouseToLogical(clientX, clientY) {
            const rect = canvas.getBoundingClientRect();
            const scaleX = W / rect.width;
            const scaleY = H / rect.height;
            return { x: (clientX - rect.left) * scaleX, y: (clientY - rect.top) * scaleY };
        }
        canvas.addEventListener('mousemove', (e)=>{
            if (game.state === GameState.MENU) {
                const p = mouseToLogical(e.clientX, e.clientY);
                if (p.x>=0 && p.x<=W && p.y>=0 && p.y<=H) {
                    mouseActive = true;
                    updateMenuHover(p.x, p.y);
                }
                return;
            }
            if (game.state !== GameState.PLAYING) { mouseActive = false; return; }
            const p = mouseToLogical(e.clientX, e.clientY);
            if (p.x>=0 && p.x<=W && p.y>=0 && p.y<=H) {
                mouseActive = true;
                mouseTargetX = p.x; mouseTargetY = p.y;
            } else {
                mouseActive = false;
            }
        });
        canvas.addEventListener('mouseleave', ()=>{ 
            mouseActive=false; 
            mouseFiring=false;
            if (game.state === GameState.MENU) {
                // 不清除选择状态，保持hover选中效果
            }
        });
        canvas.addEventListener('mousedown', (e)=>{
            if (e.button !== 0) return;
            if (game.state !== GameState.PLAYING) return;
            mouseFiring = true;
            keys.fire = true;
            const p = mouseToLogical(e.clientX, e.clientY);
            mouseTargetX = p.x; mouseTargetY = p.y; mouseActive = true;
        });
        window.addEventListener('mouseup', (e)=>{
            if (e.button !== 0) return;
            mouseFiring = false;
            // 注意：key fire 仅在空格按下时持续，这里只是鼠标 hold
        });
        canvas.addEventListener('contextmenu', (e)=> e.preventDefault());

        // ==================== HUD 暂停/退出 & 弹层 ====================
        function hideModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.remove('show');
        }
        function showModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('show');
        }
        function updateHudButtons() {
            const hud = document.getElementById('hudButtons');
            if (!hud) return;
            hud.style.display = (game.state===GameState.PLAYING || game.state===GameState.PAUSED) ? 'flex' : 'none';
            const bp = document.getElementById('btnPause');
            if (bp) bp.textContent = (game.state===GameState.PAUSED) ? '▶' : '❚❚';
        }
        const btnPause = document.getElementById('btnPause');
        const btnQuit  = document.getElementById('btnQuit');
        if (btnPause) btnPause.addEventListener('click', ()=>{
            if (game.state === GameState.PLAYING) { game.state = GameState.PAUSED; hideModal('quitModal'); showModal('pauseModal'); }
            else if (game.state === GameState.PAUSED) { game.state = GameState.PLAYING; hideModal('pauseModal'); hideModal('quitModal'); }
            updateHudButtons(); updateTouchControlsVisibility();
        });
        if (btnQuit) btnQuit.addEventListener('click', ()=>{
            if (game.state===GameState.PLAYING) { game.state = GameState.PAUSED; updateTouchControlsVisibility(); }
            hideModal('pauseModal'); showModal('quitModal');
            updateHudButtons();
        });
        // 暂停弹层按钮
        const pauseResume = document.getElementById('pauseResume'), pauseRestart = document.getElementById('pauseRestart'), pauseExit = document.getElementById('pauseExit');
        if (pauseResume) pauseResume.addEventListener('click', ()=>{
            game.state = GameState.PLAYING; hideModal('pauseModal'); updateHudButtons(); updateTouchControlsVisibility();
        });
        if (pauseRestart) pauseRestart.addEventListener('click', ()=>{
            hideModal('pauseModal');
            const prevMode = game.mode, prevDiff = game.difficulty;
            mouseActive=false; mouseFiring=false; touchFiring=false;
            initGame(prevMode, prevDiff);
        });
        if (pauseExit) pauseExit.addEventListener('click', ()=>{
            hideModal('pauseModal'); showModal('quitModal');
        });
        // 退出弹层按钮
        const quitCancel = document.getElementById('quitCancel'), quitConfirm = document.getElementById('quitConfirm');
        if (quitCancel) quitCancel.addEventListener('click', ()=>{
            hideModal('quitModal');
        });
        if (quitConfirm) quitConfirm.addEventListener('click', ()=>{
            hideModal('quitModal'); hideModal('pauseModal');
            mouseActive=false; mouseFiring=false; touchFiring=false;
            game.state = GameState.MENU;
            updateHudButtons(); updateTouchControlsVisibility();
        });

        // ==================== 手机端虚拟摇杆 + 按钮 ====================
        const touchControls = document.getElementById('touchControls');
        const joystickArea = document.querySelector('.joystick-area');
        const joystickKnob = document.querySelector('.joystick-knob');
        const btnFire = document.getElementById('btnFire');
        const btnSkill = document.getElementById('btnSkill');
        let joystickActive = false;
        let joystickCenter = {x:0, y:0};
        const joystickMaxR = 44;
        if (joystickArea && joystickKnob) {
            const clampKnob = (dx, dy) => {
                const d = Math.hypot(dx, dy);
                if (d > joystickMaxR) { dx = dx/d*joystickMaxR; dy = dy/d*joystickMaxR; }
                joystickKnob.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
                return { dx: dx/joystickMaxR, dy: dy/joystickMaxR };
            };
            const resetKnob = () => {
                joystickKnob.style.transform = 'translate(-50%, -50%)';
                joystickActive = false;
                // 清空摇杆对按键的贡献
                touchStartX = null; touchStartY = null; touchMoveActive = false;
            };
            const setJoystickCenter = (rect) => {
                joystickCenter = { x: rect.left + rect.width/2, y: rect.top + rect.height/2 };
            };
            joystickArea.addEventListener('touchstart', (e)=>{
                if (game.state !== GameState.PLAYING) return;
                e.preventDefault();
                const t = e.touches[0];
                const rect = joystickArea.getBoundingClientRect();
                setJoystickCenter(rect);
                joystickActive = true;
                const dx = t.clientX - joystickCenter.x;
                const dy = t.clientY - joystickCenter.y;
                clampKnob(dx, dy);
                updateFromJoystick(dx, dy);
            }, {passive:false});
            joystickArea.addEventListener('touchmove', (e)=>{
                if (!joystickActive || game.state !== GameState.PLAYING) return;
                e.preventDefault();
                const t = e.touches[0];
                const dx = t.clientX - joystickCenter.x;
                const dy = t.clientY - joystickCenter.y;
                const nd = clampKnob(dx, dy);
                updateFromJoystick(nd.dx*joystickMaxR, nd.dy*joystickMaxR);
            }, {passive:false});
            joystickArea.addEventListener('touchend', (e)=>{
                e.preventDefault(); resetKnob();
            }, {passive:false});
            joystickArea.addEventListener('touchcancel', (e)=>{
                e.preventDefault(); resetKnob();
            }, {passive:false});
        }
        function updateFromJoystick(dx, dy) {
            if (!player) return;
            const scale = 2.8;
            touchStartX = player.x + dx * scale;
            touchStartY = player.y + dy * scale;
            touchMoveActive = (Math.abs(dx)+Math.abs(dy)) > 4;
        }
        if (btnFire) {
            const startFire = (e)=>{ if(game.state!==GameState.PLAYING) return; e.preventDefault(); touchFiring=true; keys.fire=true; };
            const endFire   = (e)=>{ e.preventDefault(); touchFiring=false; keys.fire=false; };
            btnFire.addEventListener('touchstart', startFire, {passive:false});
            btnFire.addEventListener('touchend',   endFire,   {passive:false});
            btnFire.addEventListener('touchcancel',endFire,   {passive:false});
            btnFire.addEventListener('mousedown',  startFire);
            btnFire.addEventListener('mouseup',    endFire);
            btnFire.addEventListener('mouseleave', endFire);
        }
        if (btnSkill) {
            const doSkill = (e)=>{
                e.preventDefault();
                if (game.state!==GameState.PLAYING) return;
                usePlayerBomb();
            };
            btnSkill.addEventListener('touchstart', doSkill, {passive:false});
            btnSkill.addEventListener('click', doSkill);
        }

        // ==================== 主循环 ====================
        function updateGame(deltaTime) {
            if (game.state !== GameState.PLAYING) return;
            game.frameCount++;
            game.totalElapsed += deltaTime;

            // 屏幕震动倒计时
            if (game.shakeTimer > 0) game.shakeTimer = Math.max(0, game.shakeTimer - deltaTime);

            // 磁铁和减速效果
            if (game.magnetActive) {
                game.magnetTimer -= deltaTime;
                if (game.magnetTimer<=0) game.magnetActive=false;
            }
            if (game.slowActive) {
                game.slowTimer -= deltaTime;
                if (game.slowTimer<=0) game.slowActive=false;
            }
            if (game.rapidActive) {
                game.rapidTimer -= deltaTime;
                if (game.rapidTimer<=0) game.rapidActive=false;
            }
            if (game.homingActive) {
                game.homingTimer -= deltaTime;
                if (game.homingTimer<=0) game.homingActive=false;
                // 每 220ms 发射 2 枚追踪弹
                if (!game._homingCD) game._homingCD = 0;
                game._homingCD -= deltaTime;
                if (game._homingCD <= 0 && player) {
                    game._homingCD = 220;
                    for (const k of [-1, 1]) {
                        game.homingBullets.push({
                            x: player.x + k*16, y: player.y - player.height/2,
                            vx: k*0.6, vy: -3.6, damage: (player.bulletDamage+2)||2,
                            life: 240, turn: 0.07, trail: [],
                        });
                    }
                }
            }
            if (game.laserActive) {
                game.laserTimer -= deltaTime;
                if (game.laserTimer<=0) { game.laserActive=false; game.laserBeam=null; }
                else if (player) {
                    // 激光柱位置与玩家头顶对齐、穿透到屏幕顶
                    game.laserBeam = { cx: player.x, topY: -10, botY: player.y - player.height/2, width: 28 + Math.sin(game.frameCount*0.6)*6, life: game.laserTimer };
                    // 对激光所覆盖 x 范围内的敌人持续伤害
                    const halfW = (game.laserBeam.width || 24) * 0.5;
                    const lx1 = game.laserBeam.cx - halfW, lx2 = game.laserBeam.cx + halfW;
                    for (let j = enemies.length - 1; j >= 0; j--) {
                        const e = enemies[j];
                        const ex1 = e.x - e.width/2, ex2 = e.x + e.width/2;
                        if (ex2 >= lx1 && ex1 <= lx2 && e.y <= player.y) {
                            const dmgPerFrame = (e.type === EnemyType.BOSS ? 0.45 : 1.1) * (deltaTime / 16);
                            e.hp -= dmgPerFrame;
                            if (Math.random() < 0.15) addExplosion(e.x + (Math.random()-0.5)*e.width*0.5, e.y + (Math.random()-0.5)*e.height*0.3, '#ffff66', 3, 2);
                            if (e.hp <= 0) destroyEnemy(j);
                        }
                    }
                }
            } else {
                game.laserBeam = null;
            }
            if (game.wingmanActive) {
                game.wingmanTimer -= deltaTime;
                if (game.wingmanTimer<=0) game.wingmanActive=false;
            }

            // 追踪弹更新 + 命中
            if (!game.homingBullets) game.homingBullets = [];
            for (let i = game.homingBullets.length - 1; i >= 0; i--) {
                const b = game.homingBullets[i];
                // 选最近敌人
                let best=null, bd=1e9;
                for (const e of enemies) {
                    const d = Math.hypot(e.x-b.x, e.y-b.y);
                    if (d < bd) { bd=d; best=e; }
                }
                if (best) {
                    const ang = Math.atan2(best.y-b.y, best.x-b.x);
                    const curAng = Math.atan2(b.vy, b.vx);
                    let diff = ang - curAng;
                    while (diff > Math.PI) diff -= Math.PI*2;
                    while (diff < -Math.PI) diff += Math.PI*2;
                    const turn = Math.max(-b.turn, Math.min(b.turn, diff));
                    const sp = Math.hypot(b.vx, b.vy);
                    const na = curAng + turn;
                    b.vx = Math.cos(na) * sp;
                    b.vy = Math.sin(na) * sp;
                }
                b.trail.push({x:b.x, y:b.y});
                if (b.trail.length > 6) b.trail.shift();
                b.x += b.vx; b.y += b.vy;
                b.life--;
                // 碰撞检测（敌人）
                let hit=false;
                for (let j=enemies.length-1; j>=0; j--) {
                    const e = enemies[j];
                    const r1 = 7, r2 = Math.max(e.width, e.height)*0.5;
                    if (Math.hypot(b.x-e.x, b.y-e.y) < r1+r2) {
                        e.hp -= b.damage;
                        addExplosion(b.x, b.y, '#ff2277', 8, 3);
                        hit=true;
                        if (e.hp<=0) destroyEnemy(j);
                        break;
                    }
                }
                if (hit || b.life <= 0 || b.y < -30 || b.y > H+30 || b.x < -30 || b.x > W+30) {
                    game.homingBullets.splice(i, 1);
                }
            }

            updateStars();
            // 战斗场景也更新星云脉动和流星（频率更低）
            menuNebulaPulse += 0.012;
            for (let i = menuShootingStars.length - 1; i >= 0; i--) {
                const s = menuShootingStars[i];
                s.x += s.vx; s.y += s.vy; s.life--;
                if (s.life <= 0 || s.x < -50 || s.x > W + 50 || s.y > H + 50) menuShootingStars.splice(i, 1);
            }
            if (Math.random() < 0.004 && menuShootingStars.length < 2) {
                const side = Math.random() < 0.5 ? 0 : 1;
                menuShootingStars.push({
                    x: side === 0 ? -20 : W + 20,
                    y: 30 + Math.random() * 150,
                    vx: (side === 0 ? 1 : -1) * (3.5 + Math.random() * 2.5),
                    vy: 0.8 + Math.random() * 1.2,
                    life: 50 + Math.random() * 30,
                    maxLife: 80,
                    length: 25 + Math.random() * 30,
                });
            }
            // 战斗场景流光光束（频率更低、数量更少，不干扰战斗）
            for (let i = menuLightBeams.length - 1; i >= 0; i--) {
                const b = menuLightBeams[i];
                b.x += b.vx;
                b.y += b.vy;
                b.life--;
                if (b.life <= 0 || b.x < -400 || b.x > W + 400 || b.y < -400 || b.y > H + 400) {
                    menuLightBeams.splice(i, 1);
                }
            }
            if (Math.random() < 0.003 && menuLightBeams.length < 2) {
                const dir = Math.random() < 0.8;
                const fromLeft = Math.random() < 0.6;
                const hue = 190 + Math.random() * 30;
                const thickness = 20 + Math.random() * 45;
                const speed = 1.6 + Math.random() * 2.2;
                const len = 180 + Math.random() * 260;
                menuLightBeams.push({
                    x: fromLeft ? -len : W + len,
                    y: 40 + Math.random() * (H - 80),
                    vx: (fromLeft ? 1 : -1) * speed,
                    vy: dir ? 0 : (Math.random() < 0.5 ? -1 : 1) * (0.3 + Math.random() * 0.6),
                    thickness: thickness,
                    length: len,
                    life: 180 + Math.random() * 140,
                    hue: hue,
                    angle: dir ? 0 : (Math.random() - 0.5) * 0.4,
                });
            }
            updatePlayer(deltaTime);
            updatePlayerBullets();
            updateEnemies(deltaTime);
            updateEnemyBullets();
            updatePowerups();
            updateParticles();
            checkCollisions();
            updateWaveSystem(deltaTime);

            if (game.mode === GameMode.TIMED) {
                game.timeRemaining -= deltaTime/1000;
                if (game.timeRemaining<=0) { game.timeRemaining=0; endGame(); }
                if (game.timeRemaining < CONFIG.timedMode.duration/2 && !game.timedHalfReached) game.timedHalfReached=true;
            }
            if (game.mode === GameMode.SURVIVAL) {
                // 生存模式随时间增加分数
                game.score += Math.floor(deltaTime/1000);
            }
            game.difficultyMultiplier = getDifficultyMultiplier();
            if (!boss && !game.waveActive && game.wave>0 && enemies.length===0) {
                setTimeout(()=>{ if(game.state===GameState.PLAYING) startNextWave(); }, 800);
            }
        }

        function updateStars() {
            for (const star of stars) {
                star.y += star.speed;
                star.x += Math.sin(game.frameCount*star.twinkleSpeed+star.twinkleOffset)*0.1;
                if (star.y>H) Object.assign(star, createStar(-5));
            }
        }

        // ==================== 绘制 ====================
        function drawGame() {
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';
            ctx.clearRect(0, 0, W, H);

            // 屏幕震动偏移（在战斗场景才生效）
            let shakeX = 0, shakeY = 0;
            if (game.state === GameState.PLAYING && game.shakeTimer > 0 && game.shakeAmp > 0) {
                const m = Math.max(0.2, game.shakeTimer / 450);
                shakeX = (Math.random()*2 - 1) * game.shakeAmp * m;
                shakeY = (Math.random()*2 - 1) * game.shakeAmp * m;
            }
            ctx.save();
            ctx.translate(shakeX, shakeY);

            drawBackground();
            if (game.state===GameState.MENU) { ctx.restore(); drawMenu(); return; }
            if (game.state===GameState.GAME_OVER) { ctx.restore(); drawGameOver(); return; }
            drawStars();
            drawPowerups();
            drawEnemies();
            drawEnemyBullets();
            drawPlayerBullets();

            // 绘制追踪弹
            if (game.homingBullets && game.homingBullets.length) {
                for (const b of game.homingBullets) {
                    for (let i = 0; i < b.trail.length; i++) {
                        const t = b.trail[i];
                        const alpha = (i+1) / b.trail.length * 0.5;
                        ctx.save();
                        ctx.beginPath(); ctx.arc(t.x, t.y, 3.5, 0, Math.PI*2);
                        ctx.fillStyle = `rgba(255,40,120,${alpha})`;
                        ctx.fill(); ctx.restore();
                    }
                    ctx.save();
                    ctx.shadowBlur = 14; ctx.shadowColor = '#ff2277';
                    const g = ctx.createRadialGradient(b.x, b.y, 0.5, b.x, b.y, 6);
                    g.addColorStop(0, '#fff'); g.addColorStop(0.4, '#ff5588'); g.addColorStop(1, 'rgba(220,0,80,0.6)');
                    ctx.fillStyle = g;
                    ctx.beginPath(); ctx.arc(b.x, b.y, 5, 0, Math.PI*2); ctx.fill();
                    // 尾焰
                    const tailX = b.x - b.vx * 3, tailY = b.y - b.vy * 3;
                    const tg = ctx.createLinearGradient(b.x, b.y, tailX, tailY);
                    tg.addColorStop(0, 'rgba(255,100,140,0.85)');
                    tg.addColorStop(1, 'rgba(255,0,80,0)');
                    ctx.strokeStyle = tg;
                    ctx.lineWidth = 3;
                    ctx.beginPath(); ctx.moveTo(b.x, b.y); ctx.lineTo(tailX, tailY); ctx.stroke();
                    ctx.restore();
                }
            }

            // 绘制激光主炮
            if (game.laserBeam) {
                const b = game.laserBeam;
                ctx.save();
                const w = b.width || 28;
                // 外层光晕
                ctx.shadowBlur = 26; ctx.shadowColor = '#ffee66';
                const g1 = ctx.createLinearGradient(b.cx - w, 0, b.cx + w, 0);
                g1.addColorStop(0, 'rgba(255,240,120,0)');
                g1.addColorStop(0.35, 'rgba(255,230,80,0.4)');
                g1.addColorStop(0.5, 'rgba(255,255,220,0.9)');
                g1.addColorStop(0.65, 'rgba(255,230,80,0.4)');
                g1.addColorStop(1, 'rgba(255,240,120,0)');
                ctx.fillStyle = g1;
                ctx.fillRect(b.cx - w*1.3, b.topY, w*2.6, b.botY - b.topY);
                // 内核
                const g2 = ctx.createLinearGradient(b.cx - w*0.45, 0, b.cx + w*0.45, 0);
                g2.addColorStop(0, 'rgba(255,230,120,0.1)');
                g2.addColorStop(0.4, 'rgba(255,255,200,1)');
                g2.addColorStop(0.5, '#ffffff');
                g2.addColorStop(0.6, 'rgba(255,255,200,1)');
                g2.addColorStop(1, 'rgba(255,230,120,0.1)');
                ctx.fillStyle = g2;
                ctx.fillRect(b.cx - w*0.45, b.topY, w*0.9, b.botY - b.topY);
                // 顶端冲击爆点
                ctx.shadowBlur = 22; ctx.shadowColor = '#ffffaa';
                const impactG = ctx.createRadialGradient(b.cx, b.topY, 1, b.cx, b.topY, 18);
                impactG.addColorStop(0, '#ffffff');
                impactG.addColorStop(0.4, 'rgba(255,240,120,0.9)');
                impactG.addColorStop(1, 'rgba(255,200,0,0)');
                ctx.fillStyle = impactG;
                ctx.beginPath(); ctx.arc(b.cx, b.topY, 18 + Math.sin(game.frameCount*0.8)*3, 0, Math.PI*2); ctx.fill();
                ctx.restore();
            }

            drawDrones();
            drawPlayer();
            drawParticles();

            ctx.restore(); // undo shake translate

            drawHUD();
            if (game.state===GameState.PAUSED) drawPauseOverlay();
        }

        function drawBackground() {
            // 背景图片（cover模式铺满屏幕不留空白）
            drawBgImage(W, H);
            // 战斗场景更暗一些，确保敌机/子弹/道具清晰可见
            ctx.save();
            ctx.fillStyle = 'rgba(0,5,20,0.65)';
            ctx.fillRect(0, 0, W, H);
            ctx.restore();

            // 双圆心脉动星云（透明度较低，不干扰游戏）
            const pulse = Math.sin(menuNebulaPulse) * 0.5 + 0.5;
            const n1 = ctx.createRadialGradient(W*0.25, H*0.3, 30, W*0.25, H*0.3, 260);
            n1.addColorStop(0, `rgba(80,40,160,${0.10 + pulse*0.05})`);
            n1.addColorStop(0.5, `rgba(40,20,100,${0.06 + pulse*0.03})`);
            n1.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle=n1; ctx.fillRect(0,0,W,H);

            const n2 = ctx.createRadialGradient(W*0.78, H*0.72, 40, W*0.78, H*0.72, 280);
            n2.addColorStop(0, `rgba(20,90,160,${0.10 + pulse*0.05})`);
            n2.addColorStop(0.5, `rgba(10,40,90,${0.05 + pulse*0.03})`);
            n2.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle=n2; ctx.fillRect(0,0,W,H);

            // 倾斜银河光带
            ctx.save();
            ctx.translate(W/2, H/2);
            ctx.rotate(-0.35);
            const mw = W*1.6, mh = 80;
            const galaxy = ctx.createLinearGradient(-mw/2, 0, mw/2, 0);
            galaxy.addColorStop(0, 'rgba(120,140,255,0)');
            galaxy.addColorStop(0.3, `rgba(140,160,255,${0.06 + pulse*0.02})`);
            galaxy.addColorStop(0.5, `rgba(200,180,255,${0.10 + pulse*0.03})`);
            galaxy.addColorStop(0.7, `rgba(140,160,255,${0.06 + pulse*0.02})`);
            galaxy.addColorStop(1, 'rgba(120,140,255,0)');
            ctx.fillStyle = galaxy;
            ctx.fillRect(-mw/2, -mh/2, mw, mh);
            ctx.restore();

            // 流星（战斗场景中频率更低，避免干扰）
            for (const s of menuShootingStars) {
                const alpha = Math.min(1, s.life / s.maxLife);
                ctx.save();
                const tailX = s.x - s.vx * s.length / 5;
                const tailY = s.y - s.vy * s.length / 5;
                const tg = ctx.createLinearGradient(s.x, s.y, tailX, tailY);
                tg.addColorStop(0, `rgba(180,220,255,${alpha*0.8})`);
                tg.addColorStop(1, 'rgba(180,220,255,0)');
                ctx.strokeStyle = tg;
                ctx.lineWidth = 2;
                ctx.shadowBlur = 8;
                ctx.shadowColor = '#aaccff';
                ctx.beginPath();
                ctx.moveTo(s.x, s.y);
                ctx.lineTo(tailX, tailY);
                ctx.stroke();
                ctx.beginPath();
                ctx.arc(s.x, s.y, 2, 0, Math.PI*2);
                ctx.fillStyle = `rgba(255,255,255,${alpha})`;
                ctx.fill();
                ctx.restore();
            }

            // 战斗场景流光光束（更透明，不干扰战斗视觉）
            for (const b of menuLightBeams) {
                const lifeRatio = Math.min(1, b.life / 60);
                const alpha = Math.min(1, lifeRatio) * 0.15; // 更低透明度
                if (alpha <= 0) continue;
                ctx.save();
                ctx.translate(b.x, b.y);
                ctx.rotate(b.angle);
                const beamGrad = ctx.createLinearGradient(-b.length/2, 0, b.length/2, 0);
                beamGrad.addColorStop(0, `hsla(${b.hue}, 100%, 70%, 0)`);
                beamGrad.addColorStop(0.3, `hsla(${b.hue}, 100%, 70%, ${alpha*0.5})`);
                beamGrad.addColorStop(0.5, `hsla(${b.hue+10}, 100%, 85%, ${alpha})`);
                beamGrad.addColorStop(0.7, `hsla(${b.hue}, 100%, 70%, ${alpha*0.5})`);
                beamGrad.addColorStop(1, `hsla(${b.hue}, 100%, 70%, 0)`);
                ctx.fillStyle = beamGrad;
                ctx.shadowColor = `hsla(${b.hue}, 100%, 70%, ${alpha*0.8})`;
                ctx.shadowBlur = 22;
                ctx.fillRect(-b.length/2, -b.thickness/2, b.length, b.thickness);
                // 核心线（更细更暗）
                const coreGrad = ctx.createLinearGradient(-b.length/2, 0, b.length/2, 0);
                coreGrad.addColorStop(0, `hsla(${b.hue}, 100%, 95%, 0)`);
                coreGrad.addColorStop(0.5, `hsla(${b.hue+15}, 100%, 98%, ${alpha*1.6})`);
                coreGrad.addColorStop(1, `hsla(${b.hue}, 100%, 95%, 0)`);
                ctx.fillStyle = coreGrad;
                ctx.shadowBlur = 10;
                ctx.fillRect(-b.length/2, -b.thickness*0.06, b.length, b.thickness*0.12);
                ctx.restore();
            }
        }

        function drawStars() {
            for (const star of stars) {
                const twinkle = Math.sin(game.frameCount*star.twinkleSpeed+star.twinkleOffset)*0.3+0.7;
                const alpha = star.brightness*twinkle;
                ctx.beginPath(); ctx.arc(star.x,star.y,star.size,0,Math.PI*2);
                ctx.fillStyle=`rgba(200,220,255,${alpha})`; ctx.fill();
                if (star.size>1.5) {
                    ctx.beginPath(); ctx.arc(star.x,star.y,star.size*2.5,0,Math.PI*2);
                    ctx.fillStyle=`rgba(150,180,255,${alpha*0.2})`; ctx.fill();
                }
            }
        }

        function drawPlayer() {
            if (!player) return;
            const type = player.shipType || ShipType.TEMPEST;
            const cfg = ShipConfig[type] || ShipConfig.tempest;
            if (player.invincible && Math.floor(game.frameCount/5)%2===0) ctx.globalAlpha=0.4;
            if (player.shieldActive) {
                ctx.save();
                ctx.beginPath(); ctx.arc(player.x,player.y,Math.max(36,player.width*0.85),0,Math.PI*2);
                const sg=ctx.createRadialGradient(player.x,player.y,18,player.x,player.y,Math.max(38,player.width*0.9));
                sg.addColorStop(0,'rgba(0,200,255,0)'); sg.addColorStop(0.7,'rgba(0,180,255,0.18)'); sg.addColorStop(1,'rgba(0,220,255,0.6)');
                ctx.fillStyle=sg; ctx.fill();
                ctx.strokeStyle='rgba(0,220,255,0.85)'; ctx.lineWidth=2.5;
                ctx.shadowBlur=22; ctx.shadowColor='#00ccff'; ctx.stroke();
                ctx.restore();
            }
            const px=player.x, py=player.y;
            ctx.save(); ctx.translate(px,py);
            ctx.rotate(player.tiltAngle);
            const scaleX=1-Math.abs(player.pitchScale)*0.15;
            const scaleY=1+player.pitchScale*0.25;
            ctx.scale(scaleX,scaleY);

            // 根据机型调用对应绘制函数（以原点为中心，机头向上为负Y）
            if (type === ShipType.PHANTOM) drawShipPhantom(cfg);
            else if (type === ShipType.CRIMSON) drawShipCrimson(cfg);
            else if (type === ShipType.WARHAMMER) drawShipWarhammer(cfg);
            else drawShipTempest(cfg);

            ctx.restore();
            ctx.globalAlpha=1;
        }

        // ====== 机型1：银蓝幻灵 PHANTOM ======
        // 参考图1：银灰流线机身，机翼下方双蓝色涡轮引擎，蓝紫尾焰，驾驶舱黑色玻璃罩，蓝色霓虹描边
        function drawShipPhantom(cfg) {
            const w = 44, h = 50;
            const fH = 12 + Math.sin(game.frameCount*0.55)*4;
            const ef = cfg.engineFlame;
            // 双引擎尾焰（机翼两侧下方）
            for (const sx of [-14, 14]) {
                const fg = ctx.createLinearGradient(sx, h/2-4, sx, h/2+fH+10);
                fg.addColorStop(0, ef.c1); fg.addColorStop(0.45, ef.c2); fg.addColorStop(1, ef.c3);
                ctx.fillStyle = fg;
                ctx.beginPath();
                ctx.moveTo(sx-6, h/2-2);
                ctx.quadraticCurveTo(sx, h/2+fH+12, sx+6, h/2-2);
                ctx.closePath();
                ctx.fill();
            }
            // 机身投影阴影
            ctx.save(); ctx.shadowBlur = 22; ctx.shadowColor = cfg.shadowColor;
            // 主翼（后掠）
            const wingGrad = ctx.createLinearGradient(-w/2,0,w/2,0);
            wingGrad.addColorStop(0, '#cfd6e0'); wingGrad.addColorStop(0.5, '#9fa9b8'); wingGrad.addColorStop(1, '#cfd6e0');
            ctx.fillStyle = wingGrad;
            ctx.beginPath();
            ctx.moveTo(-w/2, 4); ctx.lineTo(-8, -h/3); ctx.lineTo(-6, h/4); ctx.lineTo(-14, h/2-8);
            ctx.lineTo(-w/2+4, 8); ctx.closePath(); ctx.fill();
            ctx.beginPath();
            ctx.moveTo(w/2, 4); ctx.lineTo(8, -h/3); ctx.lineTo(6, h/4); ctx.lineTo(14, h/2-8);
            ctx.lineTo(w/2-4, 8); ctx.closePath(); ctx.fill();
            // 机身主体
            const bodyGrad = ctx.createLinearGradient(0,-h/2,0,h/2);
            bodyGrad.addColorStop(0, '#e8eef5'); bodyGrad.addColorStop(0.3, '#b7bfcc'); bodyGrad.addColorStop(0.7, '#8d98a8'); bodyGrad.addColorStop(1, '#5c6678');
            ctx.fillStyle = bodyGrad;
            ctx.beginPath();
            ctx.moveTo(0, -h/2);
            ctx.quadraticCurveTo(8, -h/2+14, 10, -4);
            ctx.lineTo(14, h/3);
            ctx.quadraticCurveTo(6, h/2-4, 0, h/2-4);
            ctx.quadraticCurveTo(-6, h/2-4, -14, h/3);
            ctx.lineTo(-10, -4);
            ctx.quadraticCurveTo(-8, -h/2+14, 0, -h/2);
            ctx.closePath(); ctx.fill();

            // 引擎外壳（机翼下方双涡轮）
            for (const sx of [-14, 14]) {
                const eg = ctx.createRadialGradient(sx, h/2-10, 2, sx, h/2-10, 8);
                eg.addColorStop(0, '#00eeff'); eg.addColorStop(0.5, '#0077cc'); eg.addColorStop(1, '#203040');
                ctx.fillStyle = eg;
                ctx.beginPath(); ctx.ellipse(sx, h/2-10, 7, 10, 0, 0, Math.PI*2); ctx.fill();
                ctx.strokeStyle = '#00ffff'; ctx.lineWidth = 1.2; ctx.shadowBlur=10; ctx.shadowColor='#00ffff';
                ctx.stroke();
            }

            // 驾驶舱玻璃罩
            const cg = ctx.createRadialGradient(0,-12,1, 0,-12,11);
            cg.addColorStop(0, '#bfefff'); cg.addColorStop(0.3, '#55aadd'); cg.addColorStop(1, '#0a1d3a');
            ctx.fillStyle = cg;
            ctx.beginPath(); ctx.ellipse(0, -11, 6.5, 13, 0, 0, Math.PI*2); ctx.fill();
            ctx.strokeStyle = 'rgba(0,200,255,0.8)'; ctx.lineWidth = 1.1;
            ctx.shadowBlur = 10; ctx.shadowColor = '#00ccff'; ctx.stroke();

            // 机身霓虹描边
            ctx.lineWidth = 1.4;
            ctx.strokeStyle = 'rgba(0,210,255,0.7)';
            ctx.shadowBlur = 8; ctx.shadowColor = '#00ddff';
            ctx.beginPath();
            ctx.moveTo(0,-h/2); ctx.quadraticCurveTo(8,-h/2+14,10,-4); ctx.lineTo(14,h/3);
            ctx.quadraticCurveTo(6,h/2-4,0,h/2-4); ctx.quadraticCurveTo(-6,h/2-4,-14,h/3);
            ctx.lineTo(-10,-4); ctx.quadraticCurveTo(-8,-h/2+14,0,-h/2);
            ctx.closePath(); ctx.stroke();

            // 机翼前缘装饰线
            ctx.beginPath();
            ctx.moveTo(-w/2, 4); ctx.lineTo(-8, -h/3);
            ctx.moveTo(w/2, 4);  ctx.lineTo(8,  -h/3);
            ctx.stroke();
            ctx.restore();
        }

        // ====== 机型2：赤焰战神 CRIMSON ======
        // 参考图2：红黑机甲机身，大后掠双翼，机翼蓝色涡轮引擎，机头双炮管发射橙色火焰
        function drawShipCrimson(cfg) {
            const w = 54, h = 58;
            const ef = cfg.engineFlame;
            // 引擎尾焰（机翼外段下方，双蓝色）
            for (const sx of [-20, 20]) {
                const fg = ctx.createLinearGradient(sx, h/2-8, sx, h/2+20);
                fg.addColorStop(0, ef.c1); fg.addColorStop(0.5, ef.c2); fg.addColorStop(1, ef.c3);
                ctx.fillStyle = fg;
                ctx.beginPath();
                ctx.moveTo(sx-8, h/2-6);
                ctx.quadraticCurveTo(sx, h/2+22, sx+8, h/2-6);
                ctx.closePath();
                ctx.fill();
            }
            ctx.save(); ctx.shadowBlur = 20; ctx.shadowColor = cfg.shadowColor;
            // 主翼（大后掠，红色）
            const wingGrad = ctx.createLinearGradient(-w/2,0,w/2,0);
            wingGrad.addColorStop(0,'#5a1000'); wingGrad.addColorStop(0.2,'#c82a10'); wingGrad.addColorStop(0.5,'#a01a08'); wingGrad.addColorStop(0.8,'#c82a10'); wingGrad.addColorStop(1,'#5a1000');
            ctx.fillStyle = wingGrad;
            ctx.beginPath();
            ctx.moveTo(-w/2, 0); ctx.lineTo(-10, -h/3); ctx.lineTo(-6, h/5);
            ctx.lineTo(-18, h/2-12); ctx.lineTo(-w/2+6, 6); ctx.closePath(); ctx.fill();
            ctx.beginPath();
            ctx.moveTo(w/2, 0); ctx.lineTo(10, -h/3); ctx.lineTo(6, h/5);
            ctx.lineTo(18, h/2-12); ctx.lineTo(w/2-6, 6); ctx.closePath(); ctx.fill();
            // 垂尾
            ctx.fillStyle = '#8c1808';
            ctx.beginPath(); ctx.moveTo(-5,-h/2+20); ctx.lineTo(-2,-h/2+30); ctx.lineTo(2,-h/2+30); ctx.lineTo(5,-h/2+20); ctx.closePath(); ctx.fill();

            // 机身主体（红色装甲）
            const bodyGrad = ctx.createLinearGradient(0,-h/2,0,h/2);
            bodyGrad.addColorStop(0,'#e04020'); bodyGrad.addColorStop(0.25,'#c22a10'); bodyGrad.addColorStop(0.55,'#8c1808'); bodyGrad.addColorStop(0.85,'#6e1206'); bodyGrad.addColorStop(1,'#3a0a04');
            ctx.fillStyle = bodyGrad;
            ctx.beginPath();
            ctx.moveTo(0,-h/2);
            ctx.quadraticCurveTo(10,-h/2+16, 14, -2);
            ctx.lineTo(16, h/3);
            ctx.quadraticCurveTo(8, h/2-4, 0, h/2-4);
            ctx.quadraticCurveTo(-8, h/2-4, -16, h/3);
            ctx.lineTo(-14, -2);
            ctx.quadraticCurveTo(-10,-h/2+16, 0,-h/2);
            ctx.closePath(); ctx.fill();

            // 机头双炮管
            ctx.fillStyle = '#1a1a1a';
            ctx.shadowBlur = 6;
            for (const sx of [-6, 6]) {
                ctx.fillRect(sx-2.5, -h/2-4, 5, 12);
                // 炮口火光
                const fireG = ctx.createRadialGradient(sx, -h/2-5, 0.5, sx, -h/2-5, 5);
                fireG.addColorStop(0, '#ffffff'); fireG.addColorStop(0.4, '#ffaa33'); fireG.addColorStop(1, 'rgba(255,80,0,0)');
                ctx.fillStyle = fireG;
                ctx.beginPath(); ctx.arc(sx, -h/2-5, 4+Math.sin(game.frameCount*0.8)*1.2, 0, Math.PI*2); ctx.fill();
                ctx.fillStyle = '#1a1a1a';
            }

            // 引擎外壳（蓝）
            for (const sx of [-20, 20]) {
                const eg = ctx.createRadialGradient(sx, h/2-14, 2, sx, h/2-14, 10);
                eg.addColorStop(0,'#ffffff'); eg.addColorStop(0.3,'#88eeff'); eg.addColorStop(0.6,'#0088cc'); eg.addColorStop(1,'#062038');
                ctx.fillStyle = eg;
                ctx.beginPath(); ctx.ellipse(sx, h/2-14, 9, 11, 0, 0, Math.PI*2); ctx.fill();
                ctx.strokeStyle = '#00ddff'; ctx.lineWidth=1.3; ctx.shadowBlur=14; ctx.shadowColor='#00ffff'; ctx.stroke();
                ctx.shadowBlur = 20; ctx.shadowColor = cfg.shadowColor;
            }

            // 驾驶舱
            const cg = ctx.createRadialGradient(0,-14,1, 0,-14,11);
            cg.addColorStop(0,'#fff2c0'); cg.addColorStop(0.35,'#bb8833'); cg.addColorStop(1,'#20120a');
            ctx.fillStyle = cg;
            ctx.beginPath(); ctx.ellipse(0,-13, 7, 12, 0, 0, Math.PI*2); ctx.fill();
            ctx.strokeStyle = 'rgba(255,180,0,0.8)'; ctx.lineWidth = 1.1;
            ctx.shadowBlur = 8; ctx.shadowColor = '#ffaa22'; ctx.stroke();

            // 装甲描边 + 铆钉
            ctx.shadowBlur = 20; ctx.shadowColor = cfg.shadowColor;
            ctx.lineWidth = 1.3;
            ctx.strokeStyle = 'rgba(40,10,4,0.9)';
            ctx.beginPath();
            ctx.moveTo(0,-h/2); ctx.quadraticCurveTo(10,-h/2+16,14,-2); ctx.lineTo(16,h/3);
            ctx.quadraticCurveTo(8,h/2-4,0,h/2-4); ctx.quadraticCurveTo(-8,h/2-4,-16,h/3);
            ctx.lineTo(-14,-2); ctx.quadraticCurveTo(-10,-h/2+16,0,-h/2);
            ctx.closePath(); ctx.stroke();
            // 铆钉
            ctx.fillStyle = '#111';
            const rivs = [[-10,-6],[-10,8],[10,-6],[10,8],[-14,h/3-6],[14,h/3-6]];
            for (const [rx,ry] of rivs) { ctx.beginPath(); ctx.arc(rx,ry,1.3,0,Math.PI*2); ctx.fill(); }

            ctx.restore();
        }

        // ====== 机型3：战锤堡垒 WARHAMMER ======
        // 参考图3：灰色重甲布满铆钉，双翼带火箭挂载，前掠翼，尾焰红色橙，驾驶舱棕色玻璃
        function drawShipWarhammer(cfg) {
            const w = 62, h = 60;
            const ef = cfg.engineFlame;
            // 单中央尾焰（红色）
            const fg = ctx.createLinearGradient(0, h/2-6, 0, h/2+26);
