        function initMenuAnimations() {
            menuJets = [
                { side: 'left', x: -80, y: 200, speed: 0.8, dir: 1, flapPhase: 0, scale: 1 },
                { side: 'right', x: W + 80, y: 350, speed: 0.6, dir: -1, flapPhase: Math.PI, scale: 0.9 },
