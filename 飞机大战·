            M:{ color:'#ff00ff', label:'磁铁', letter:'M' },
            T:{ color:'#00ffff', label:'时间减速', letter:'T' },
            X:{ color:'#ffffff', label:'超级护盾', letter:'X' },
            G:{ color:'#cc88ff', label:'重力炸弹', letter:'G' },
