    /* ===== Layer Stacking Effect =====
     * Scroll-down: sections stack with overlap, shadows, scale/opacity changes.
     * Triggered by: mouse wheel, keyboard (arrows/space/pgdn), touchpad, nav clicks.
     * Scroll-up: all stacking effects removed, back to normal document flow.
     */
    const sections = document.querySelectorAll('.section');
    const heroKeywords = document.querySelector('.hero-keywords');
    let stackingTicking = false;
    let lastScrollY = window.scrollY;
    let scrollDirection = 'none'; // 'down' | 'up' | 'none'

    function clearAllStacking() {
        sections.forEach(s => {
            s.classList.remove('stacked-top', 'stacked-bottom', 'section-lit', 'section-dim');
        });
        if (heroKeywords) {
            heroKeywords.style.transform = '';
        }
    }

    function applyStackingDown() {
        const viewH = window.innerHeight;
        const isMob = window.innerWidth <= 768;
        const viewMid = viewH / 2;

        sections.forEach((section, i) => {
            const rect = section.getBoundingClientRect();
            const sectionTop = rect.top;
            const sectionBottom = rect.bottom;
            const sectionMid = sectionTop + rect.height / 2;

            // Remove stacking classes first
            section.classList.remove('stacked-top', 'stacked-bottom', 'section-lit', 'section-dim');

            // Section lighting: brightest at viewport center, dimmer at edges
            const distFromCenter = Math.abs(sectionMid - viewMid);
            const maxDist = viewH;
            const dimFactor = Math.min(1, distFromCenter / maxDist);

            if (sectionBottom > 0 && sectionTop < viewH) {
                if (dimFactor < 0.3) {
                    section.classList.add('section-lit');
                } else if (dimFactor > 0.6) {
                    section.classList.add('section-dim');
                }
            }

            // Determine stacking for scroll-down
            const nextSection = sections[i + 1];
            if (nextSection) {
                const nextRect = nextSection.getBoundingClientRect();
                if (nextRect.top > 0 && nextRect.top < viewH * 0.6) {
                    if (sectionTop < 0 || sectionBottom > 0) {
                        section.classList.add('stacked-top');
                    }
                    nextSection.classList.add('stacked-bottom');
                }
                else if (nextRect.top <= 0 && nextRect.bottom > viewH * 0.3) {
                    if (sectionTop < 0) {
                        section.classList.add('stacked-top');
                    }
                }
            }

            // Parallax for background elements (desktop only, scroll-down)
            if (!isMob && section.classList.contains('stacked-bottom')) {
                const bgElements = section.querySelectorAll('.hero-keywords, .cert-bg-pattern');
                if (bgElements.length > 0) {
                    const yOffset = sectionTop * -0.12;
                    bgElements.forEach(el => {
                        el.style.transform = `translateY(${yOffset}px)`;
                    });
                }
            }
        });

        // Hero keywords parallax (desktop only, scroll-down)
        if (heroKeywords && !isMob) {
            const hero = document.querySelector('.hero');
            if (hero) {
                const heroRect = hero.getBoundingClientRect();
                if (heroRect.bottom > 0 && heroRect.top < viewH) {
                    const offset = heroRect.top * -0.12;
                    heroKeywords.style.transform = `translateY(${offset}px)`;
                }
            }
        }
    }

    function updateStacking() {
        const currentScrollY = window.scrollY;
        const delta = currentScrollY - lastScrollY;

        if (Math.abs(delta) < 1) {
            stackingTicking = false;
            return; // Too small movement, ignore
        }

        if (delta > 0) {
            // Scrolling DOWN
            if (scrollDirection !== 'down') {
                scrollDirection = 'down';
            }
            applyStackingDown();
        } else {
            // Scrolling UP
            if (scrollDirection !== 'up') {
                scrollDirection = 'up';
                clearAllStacking();
            }
        }

        lastScrollY = currentScrollY;
        stackingTicking = false;
    }

    window.addEventListener('scroll', () => {
        if (!stackingTicking) {
            requestAnimationFrame(() => {
                updateStacking();
            });
            stackingTicking = true;
        }
    }, { passive: true });

    // Nav link click: ensure stacking works during smooth scroll
    document.querySelectorAll('.nav-links a[href^="#"]').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('href');
            const target = document.querySelector(targetId);
            if (target) {
                // Reset scroll direction to force stacking on smooth scroll
                scrollDirection = 'none';
                lastScrollY = window.scrollY;
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });

    // Initial state: ensure no stacking classes on load
    clearAllStacking();

    /* ===== Hero Keyword Contract + Explode Animation =====
     * Load: scatter 0.5s → contract to right-side center (1.5s)
     * Click: explode radially to new random positions
     * Scroll away: fade out. Return to top: replay.
     */
    const heroKeywordsContainer = document.querySelector('.hero-keywords');
    const keywordSpans = heroKeywordsContainer ? heroKeywordsContainer.querySelectorAll('span') : [];
    const heroSection = document.getElementById('hero');
    let keywordPositions = [];
    let isContracted = false;
    let contractTimeout = null;

    function storeKeywordPositions() {
        keywordPositions = [];
        if (!heroKeywordsContainer) return;
        const heroRect = heroKeywordsContainer.getBoundingClientRect();
        keywordSpans.forEach(span => {
            const rect = span.getBoundingClientRect();
            keywordPositions.push({
                el: span,
                left: rect.left - heroRect.left,
                top: rect.top - heroRect.top,
                width: rect.width,
                height: rect.height
            });
        });
    }

    function getRightSideCenter() {
        if (!heroKeywordsContainer) return { x: 0, y: 0, w: 0, h: 0 };
        const heroRect = heroKeywordsContainer.getBoundingClientRect();
        // Right side: from ~35% to 95% width, center vertically
        const areaLeft = heroRect.width * 0.35;
        const areaRight = heroRect.width * 0.92;
        const areaTop = heroRect.height * 0.15;
        const areaBottom = heroRect.height * 0.85;
        return {
            x: (areaLeft + areaRight) / 2,
            y: (areaTop + areaBottom) / 2,
            w: areaRight - areaLeft,
            h: areaBottom - areaTop
        };
    }

    // Pre-compute non-overlapping target positions in a grid with jitter
    function computeContractTargets() {
        const center = getRightSideCenter();
        const count = keywordPositions.length;
        const cols = Math.ceil(Math.sqrt(count * (center.w / center.h)));
        const rows = Math.ceil(count / cols);
        const cellW = center.w / cols;
        const cellH = center.h / rows;
        const targets = [];

        for (let i = 0; i < count; i++) {
            const col = i % cols;
            const row = Math.floor(i / cols);
            const jitterX = (Math.random() - 0.5) * cellW * 0.5;
            const jitterY = (Math.random() - 0.5) * cellH * 0.5;
            targets.push({
                x: center.x - center.w / 2 + col * cellW + cellW / 2 + jitterX,
                y: center.y - center.h / 2 + row * cellH + cellH / 2 + jitterY
            });
        }
        return targets;
    }

    function contractKeywords() {
        if (isContracted || keywordPositions.length === 0) return;
        isContracted = true;

        // Reset all xforms to identity first, then capture positions
        keywordSpans.forEach(span => {
            span.style.transition = 'none';
            span.style.transform = 'scale(1.0)';
            span.style.opacity = '1';
            span.style.color = '';
        });
        heroKeywordsContainer.offsetHeight; // force reflow
        storeKeywordPositions();

        const targets = computeContractTargets();

        keywordPositions.forEach((pos, i) => {
            const span = pos.el;
            const target = targets[i];
            const dx = target.x - pos.left - pos.width / 2;
            const dy = target.y - pos.top - pos.height / 2;

            span.style.transition = 'transform 1.5s cubic-bezier(0.45, 0.05, 0.55, 0.95), opacity 1.5s ease, color 1.5s ease';
            span.style.transform = `translate(${dx}px, ${dy}px) scale(0.88)`;
            span.style.opacity = '0.9';
            span.style.color = darkenColor(window.getComputedStyle(span).color);
        });

        contractTimeout = setTimeout(() => {
            // Bake transform into top/left, reset transform
            keywordSpans.forEach(span => {
                span.style.transition = 'none';
                const rect = span.getBoundingClientRect();
                const heroRect = heroKeywordsContainer.getBoundingClientRect();
                span.style.left = (rect.left - heroRect.left) + 'px';
                span.style.top = (rect.top - heroRect.top) + 'px';
                span.style.transform = 'scale(0.88)';
                span.style.transition = 'transform 0.3s ease, opacity 0.3s ease, color 0.3s ease';
            });
            storeKeywordPositions();
        }, 1550);
    }

    function darkenColor(color) {
        // Simple darkening: shift gray values down
        const match = color.match(/rgb\((\d+),\s*(\d+),\s*(\d+)\)/);
        if (match) {
            const v = Math.max(40, parseInt(match[1]) - 20);
            return `rgb(${v},${v},${v})`;
        }
        return color;
    }

    function explodeKeywords() {
        if (keywordPositions.length === 0) return;
        if (contractTimeout) clearTimeout(contractTimeout);

        if (!heroKeywordsContainer) return;

        // Bake current visual positions into top/left, reset transform to identity
        keywordSpans.forEach(span => {
            span.style.transition = 'none';
            const rect = span.getBoundingClientRect();
            const heroRect = heroKeywordsContainer.getBoundingClientRect();
            span.style.left = (rect.left - heroRect.left) + 'px';
            span.style.top = (rect.top - heroRect.top) + 'px';
            span.style.transform = 'scale(1.0)';
            span.style.opacity = '1';
            span.style.color = '';
        });
        heroKeywordsContainer.offsetHeight;
        storeKeywordPositions();
        isContracted = false;

        const heroRect = heroKeywordsContainer.getBoundingClientRect();
        const safeLeft = heroRect.width * 0.08;
        const safeRight = heroRect.width * 0.94;
        const safeTop = heroRect.height * 0.06;
        const safeBottom = heroRect.height * 0.94;

        const count = keywordPositions.length;
        const cols = Math.ceil(Math.sqrt(count * 1.6));
        const rows = Math.ceil(count / cols);
        const availW = safeRight - safeLeft - 20;
        const availH = safeBottom - safeTop - 10;
        const cellW = availW / cols;
        const cellH = availH / rows;

        const candidates = [];
        for (let i = 0; i < count; i++) {
            const col = i % cols;
            const row = Math.floor(i / cols);
            const jitterX = (Math.random() - 0.5) * cellW * 0.6;
            const jitterY = (Math.random() - 0.5) * cellH * 0.6;
            candidates.push({
                x: safeLeft + 10 + col * cellW + cellW / 2 + jitterX,
                y: safeTop + 5 + row * cellH + cellH / 2 + jitterY
            });
        }

        for (let i = candidates.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [candidates[i], candidates[j]] = [candidates[j], candidates[i]];
        }

        keywordPositions.forEach((pos, i) => {
            const span = pos.el;
            const target = candidates[i];
            const dx = target.x - pos.left - pos.width / 2;
            const dy = target.y - pos.top - pos.height / 2;

            span.style.transition = 'transform 1.0s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 1.0s ease, color 1.0s ease';
            span.style.transform = `translate(${dx}px, ${dy}px) scale(1.0)`;
            span.style.opacity = '1';
            span.style.color = '';
        });

        setTimeout(() => {
            keywordSpans.forEach(span => {
                span.style.transition = 'none';
                const rect = span.getBoundingClientRect();
                const heroRect = heroKeywordsContainer.getBoundingClientRect();
                span.style.left = (rect.left - heroRect.left) + 'px';
                span.style.top = (rect.top - heroRect.top) + 'px';
                span.style.transform = 'none';
                span.style.transition = 'color 0.3s';
            });
            storeKeywordPositions();
        }, 1050);
    }

    // Initialize: store positions, then contract after 0.5s pause
    function initHeroContract() {
        storeKeywordPositions();
        contractTimeout = setTimeout(() => {
            contractKeywords();
        }, 500);
    }

    // Click to explode
    if (heroSection) {
        heroSection.addEventListener('click', (e) => {
            // Don't trigger on nav links or buttons
            if (e.target.closest('a, button')) return;
            explodeKeywords();
        });
    }

    // Scroll handling
    let heroVisible = true;
    window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        const viewH = window.innerHeight;

        if (scrollY > viewH * 0.3) {
            if (heroVisible) {
                heroVisible = false;
                keywordSpans.forEach(span => {
                    span.style.transition = 'opacity 0.4s ease';
                    span.style.opacity = '0';
                });
            }
        } else if (scrollY < 10) {
            if (!heroVisible) {
                heroVisible = true;
                keywordSpans.forEach(span => {
                    span.style.transition = 'opacity 0.4s ease';
                    span.style.opacity = '';
                });
                // Replay contract animation
                isContracted = false;
                if (contractTimeout) clearTimeout(contractTimeout);
                // Reset transforms
                keywordSpans.forEach(span => {
                    span.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                    span.style.transform = '';
                    span.style.opacity = '';
                    span.style.color = '';
                });
                setTimeout(() => {
                    storeKeywordPositions();
                    contractTimeout = setTimeout(() => contractKeywords(), 500);
                }, 400);
            }
        }
    }, { passive: true });

    setTimeout(initHeroContract, 300);

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.style.opacity = '1';
                e.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.timeline-item, .cert-scene, .project-card, .future-card, .personality-desc, .chart-mbti, .chart-radar').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
        el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(el);
    });

    const certData = [
        { name: 'Agent Engineering 技能认证', img: 'images/certs/cert_01.jpg', isAI: true },
        { name: 'Prompt Engineer', img: 'images/certs/cert_02.jpg', isAI: true },
        { name: 'AI+编程能力认证', img: 'images/certs/cert_03.jpg', isAI: true },
        { name: '人工智能训练师', img: 'images/certs/cert_04.jpg', isAI: true },
        { name: '荣誉证书', img: 'images/certs/cert_05.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_06.png', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_07.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_08.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_09.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_10.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_11.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_12.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_13.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_14.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_15.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_16.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_17.jpg', isAI: false },
        { name: '荣誉证书', img: 'images/certs/cert_18.jpg', isAI: false }
    ];

    const lightboxGrid = document.getElementById('certLightboxGrid');
    certData.forEach((cert, i) => {
        const card = document.createElement('div');
        card.className = 'cert-lightbox-card' + (cert.isAI ? ' ai-card' : '');
        card.innerHTML = `
            <img class="cert-lightbox-card-img" src="${cert.img}" alt="${cert.name}">
            <div class="cert-lightbox-card-name">${cert.name}</div>
        `;
        lightboxGrid.appendChild(card);
        setTimeout(() => { card.classList.add('visible'); }, i * 80);
    });

    window.openCertLightbox = function() {
        const lb = document.getElementById('certLightbox');
        lb.classList.add('active');
        document.body.style.overflow = 'hidden';
    };

    window.closeCertLightbox = function(e) {
        if (e && e.target !== e.currentTarget) return;
        const lb = document.getElementById('certLightbox');
        lb.classList.remove('active');
        document.body.style.overflow = '';
    };

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            document.getElementById('certLightbox').classList.remove('active');
            document.body.style.overflow = '';
        }
    });

    </script>

